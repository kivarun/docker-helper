+	// G31 experimental allocator stand-in (NOT the production
+	// allocator): the lowest free category from the fixed pool, scoped
+	// to the live instances under the manager lock, so two live
+	// operations can never hold one category. Exhaustion refuses the
+	// START (fail closed; no s0 fallback).
+	cats := []string{"c1", "c2", "c3", "c4"}
+	used := map[string]bool{}
+	for _, other := range m.instances {
+		used[other.category] = true
+	}
+	inst.category = ""
+	for _, c := range cats {
+		if !used[c] {
+			inst.category = c
+			break
+		}
+	}
+	if inst.category == "" {
+		delete(m.instances, opID)
+		close(fence)
+		m.mu.Unlock()
