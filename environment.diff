+		t.Errorf("expected KEY=a*** (length=1), got %q", result)
+	}
+}
+
+func TestMaskEnvValueLong(t *testing.T) {
+	result := maskEnvValue("LLM_KEY", "secret123")
+	if result != "LLM_KEY=s*** (length=9)" {
+		t.Errorf("expected LLM_KEY=s*** (length=9), got %q", result)
+	}
