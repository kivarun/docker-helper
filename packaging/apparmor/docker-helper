# Docker Helper — user-service sandbox profile.
#
# This profile restricts the docker-helper daemon to the minimum
# filesystem and capability access needed to mediate Docker operations.
#
# Before installing, prepare the profile manually:
#
#   1. Replace every occurrence of @@BINARY_PATH@@ with the absolute path
#      to the docker-helper binary (e.g., /home/user/.local/bin/docker-helper).
#      This is used for path-based executable attachment.
#
#   2. For workspace access, replace the commented @@WORKSPACE_RULE@@ line
#      with the appropriate AppArmor rules for your allowed_root, or leave
#      it commented out if workspace access is not needed.  Example:
#
#         /home/user/workspaces/ r,
#         owner /home/user/workspaces/** rw,
#
# Then install the prepared profile (requires sudo):
#
#   sudo cp docker-helper /etc/apparmor.d/
#   sudo apparmor_parser -a /etc/apparmor.d/docker-helper

#include <tunables/global>

profile @@BINARY_PATH@@ flags=(attach_disconnected,mediate_deleted) {
	#include <abstractions/base>

	# Allow reading the user's config and state.
	owner @{HOME}/.config/docker-helper/ r,
	owner @{HOME}/.config/docker-helper/** r,
	owner @{HOME}/.local/state/docker-helper/ r,
	owner @{HOME}/.local/state/docker-helper/** rw,

	# Runtime directory (socket, session Docker dirs).
	owner /run/user/*/docker-helper/ r,
	owner /run/user/*/docker-helper/** rw,

	# Docker socket — required to execute Docker commands.
	/run/docker.sock rw,
	/var/run/docker.sock rw,

	# Docker CLI binary.
	/usr/bin/docker rix,

	# OpenSSL (for trusted CA auto-injection).
	/usr/bin/openssl ix,

	#include <abstractions/openssl>

	# Docker Buildx CLI plugin (required by `docker build`).
	# Directory read is required for Docker CLI plugin discovery.
	/usr/local/lib/docker/cli-plugins/ r,
	/usr/local/libexec/docker/cli-plugins/ r,
	/usr/lib/docker/cli-plugins/ r,
	/usr/libexec/docker/cli-plugins/ r,
	/usr/local/lib/docker/cli-plugins/docker-buildx rix,
	/usr/local/libexec/docker/cli-plugins/docker-buildx rix,
	/usr/lib/docker/cli-plugins/docker-buildx rix,
	/usr/libexec/docker/cli-plugins/docker-buildx rix,

	# Allow the binary itself to be read (needed for execution within profile).
	owner @@BINARY_PATH@@ r,

	# Workspace access (configured allowed_root).
	# @@WORKSPACE_RULE@@

	# /tmp for Docker build contexts and temporary files.
	/tmp/ r,
	owner /tmp/** rw,

	# Standard system files.
	/etc/passwd r,
	/etc/group r,
	/etc/nsswitch.conf r,
	/etc/host.conf r,
	/etc/ld.so.cache r,
	/etc/ld.so.preload r,
	/etc/ld.so.conf r,
	/etc/ld.so.conf/** r,
	/lib/** r,
	/usr/lib/** r,
	/usr/bin/** r,
	/bin/** r,

	# Network access (for registry pulls, etc.).
	network inet tcp,
	network inet udp,
	network inet6 tcp,
	network inet6 udp,

	# Deny privilege escalation.
	deny /proc/sys/kernel/** w,
	deny capability sys_admin,
	deny capability sys_ptrace,
	deny capability sys_rawio,
	deny capability dac_override,
	deny capability setuid,
	deny capability setgid,
}