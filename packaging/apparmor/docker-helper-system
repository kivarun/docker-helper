# Docker Helper — system-service sandbox profile.
#
# This profile restricts the docker-helper system daemon to the minimum
# filesystem and capability access needed to mediate Docker operations.
#
# Installation:
#   sudo cp docker-helper-system /etc/apparmor.d/
#   sudo apparmor_parser -a /etc/apparmor.d/docker-helper-system
#
# Dynamic AppArmor managed boundaries are stored in the helper-owned state
# directory at /var/lib/docker-helper/apparmor/ and included automatically.
# Do not add workspace rules directly to this profile.

#include <tunables/global>

profile docker-helper-system flags=(attach_disconnected,mediate_deleted) {
	#include <abstractions/base>

	# System config directory.
	/etc/docker-helper/ r,
	/etc/docker-helper/** r,

	# State directory (database, persistent state).
	# SQLite requires file-locking (k) permission for WAL mode.
	# Grant rwk only on the specific database files, not the entire directory.
	/var/lib/docker-helper/ r,
	/var/lib/docker-helper/docker-helper.db rwk,
	/var/lib/docker-helper/docker-helper.db-wal rwk,
	/var/lib/docker-helper/docker-helper.db-shm rwk,
	/var/lib/docker-helper/docker-helper.db-journal rwk,

	# Runtime directory (socket, lock, CA injection, mount pins).
	/run/docker-helper/ r,
	/run/docker-helper/** rw,

	# Socket lock file — file locking (k) is required for the single-instance
	# lock; the broader /run/docker-helper/** rule intentionally omits k.
	/run/docker-helper/docker-helper.sock.lock rwk,

	# D0.2 build execution uses the Moby Engine API plus a request-owned
	# BuildKit Session. It no longer executes Docker Buildx or creates Docker
	# CLI build/token state. The former build-only grants below are retained as
	# negative-regression markers only and MUST stay comments, never active:
	# /usr/local/lib/docker/cli-plugins/ r,
	# /usr/local/libexec/docker/cli-plugins/ r,
	# /usr/lib/docker/cli-plugins/ r,
	# /usr/libexec/docker/cli-plugins/ r,
	# /usr/local/lib/docker/cli-plugins/docker-buildx rix,
	# /usr/local/libexec/docker/cli-plugins/docker-buildx rix,
	# /usr/lib/docker/cli-plugins/docker-buildx rix,
	# /usr/libexec/docker/cli-plugins/docker-buildx rix,
	# /run/docker-helper/sessions/dhs_*/docker/buildx/.lock k,
	# /run/docker-helper/sessions/dhs_*/docker/.token_seed.lock k,

	# Dynamic AppArmor managed boundaries state (atomic temp + rename).
	/var/lib/docker-helper/apparmor/ rw,
	/var/lib/docker-helper/apparmor/* rw,

	# Docker socket — filesystem access.
	/run/docker.sock rw,
	/var/run/docker.sock rw,

	# Docker socket — AF_UNIX connection mediation.
	# Allow connecting to the Docker daemon Unix socket.
	unix (connect,send,receive) type=stream peer=(label=unconfined),

	# Docker CLI binary. The legacy run path still uses it until D0.3b.
	/usr/bin/docker rix,

	# Docker helper binary itself.
	/usr/bin/docker-helper r,

	# AppArmor lock file.
	/run/lock/docker-helper-apparmor.lock rwk,

	# AppArmor parser (for managed boundaries reload).
	/usr/sbin/apparmor_parser rix,

	# AppArmor profiles directory (read own profile).
	/etc/apparmor.d/ r,
	/etc/apparmor.d/** r,

	# AppArmor parser configuration (read-only, if present).
	/etc/apparmor/parser.conf r,

	# AppArmor securityfs — required for confined profile replacement.
	#
	# docker-helper must replace the loaded docker-helper-system profile after
	# updating managed workspace boundaries.  apparmor_parser --replace needs:
	#   - MAC_ADMIN to load policy into the kernel;
	#   - read access to AppArmor feature and interface metadata for
	#     version detection and capability probing;
	#   - write access to the .replace interface for profile replacement.
	#
	# This section is deliberately narrow: only the metadata the parser probes
	# and the single .replace interface used by --replace are exposed.
	# .remove, .load, and unrelated namespace administration are NOT granted.

	# MAC_ADMIN is required by the kernel for any profile load/replace operation.
	# This is the only MAC capability granted; mac_override is intentionally omitted.
	capability mac_admin,

	# AppArmor interface directory — libapparmor stat()s this path during
	# mountpoint discovery after reading /proc/mounts.
	/sys/kernel/security/apparmor/ r,

	# AppArmor feature metadata — parser probes these for version detection
	# and capability negotiation before attempting any policy operation.
	/sys/kernel/security/apparmor/features/ r,
	/sys/kernel/security/apparmor/features/** r,

	# AppArmor interface metadata — parser reads these to discover available
	# operations and negotiate with the kernel.
	/sys/kernel/security/apparmor/.access r,
	/sys/kernel/security/apparmor/.features r,
	/sys/kernel/security/apparmor/.ops r,

	# Profile replacement interface — write access required by --replace.
	# Only .replace is writable; .load and .remove are intentionally excluded.
	/sys/kernel/security/apparmor/.replace w,

	# /proc/mounts — apparmor_parser reads the global mount list to discover
	# the AppArmor securityfs mount point when --subdomainfs is not provided.
	/proc/mounts r,

	# Dynamic AppArmor managed boundaries (included if present).
	#include if exists "/var/lib/docker-helper/apparmor/managed-boundaries"

	# /tmp for staging and temporary files.
	/tmp/ r,
	owner /tmp/** rw,

	# Standard system files (NSS, dynamic linker).
	/etc/passwd r,
	/etc/group r,
	/etc/nsswitch.conf r,
	/etc/host.conf r,

	# Evidence-derived resolver inputs retained while the remaining Docker CLI
	# run path exists. D0.2 deliberately removes only permissions proven to be
	# build-owned; D0.3b can re-audit this compatibility surface when run moves.
	/etc/resolv.conf r,
	/run/systemd/resolve/stub-resolv.conf r,
	/etc/hosts r,

	/etc/ld.so.cache r,
	/etc/ld.so.preload r,
	/etc/ld.so.conf r,
	/etc/ld.so.conf/** r,
	/lib/** r,
	/usr/lib/** r,
	/usr/bin/** r,
	/bin/** r,

	# AppArmor LSM status checks (requireAppArmorActive, requireAppArmorConfinement).
	/sys/module/apparmor/parameters/enabled r,
	owner @{PROC}/@{pid}/attr/current r,

	# /proc and /sys access required by Go runtime and the remaining Docker CLI path.
	owner /proc/*/fd/ r,
	owner /proc/*/mounts r,
	owner /proc/*/status r,
	/proc/sys/kernel/random/uuid r,
	/proc/sys/kernel/osrelease r,

	# Evidence-derived Docker CLI runtime introspection. Keep narrow until the
	# D0.3b run migration removes the final CLI execution path.
	owner @{PROC}/@{pid}/cgroup r,
	/proc/sys/net/core/somaxconn r,
	owner @{PROC}/@{pid}/mountinfo r,

	/sys/devices/** r,

	# OpenSSL/CA certificates.
	/etc/ssl/certs/** r,
	/etc/pki/tls/certs/** r,
	# Evidence-derived system trust reads retained with the remaining Docker CLI
	# path; do not widen them. D0.3b is the point to re-audit their necessity.
	/etc/ssl/ca-bundle.pem r,
	/var/lib/ca-certificates/ca-bundle.pem r,
	/var/lib/ca-certificates/pem/ r,
	/var/lib/ca-certificates/pem/** r,
	# openSUSE trust anchors (administrator-installed CA material).
	/etc/pki/trust/anchors/ r,
	/etc/pki/trust/anchors/** r,

	# Network access (listener plus retained Docker CLI compatibility surface).
	network inet tcp,
	network inet udp,
	network inet6 tcp,
	network inet6 udp,

	# Mount-pin operations: open_tree, move_mount, umount.
	# Destination is restricted to helper-owned runtime mount directory.
	mount options in (rw,move) -> /run/docker-helper/mounts/**,
	umount /run/docker-helper/mounts/**,

	# Capabilities for mount-pin operations (open_tree, move_mount, umount).
	# sys_admin is required by these mount syscalls under AppArmor.
	capability sys_admin,

	# Capability for reading/traversing private principal workspaces.
	capability dac_read_search,

	# Deny privilege escalation (except what is required above).
	deny /proc/sys/kernel/** w,
	deny capability sys_ptrace,
	deny capability sys_rawio,
	deny capability dac_override,
	deny capability setuid,
	deny capability setgid,
}
