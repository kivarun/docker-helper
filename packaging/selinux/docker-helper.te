# docker-helper SELinux policy
#
# Model: docker-helper validates and accesses workspaces that retain their
# normal host labels (user_home_type) for /home paths. Non-home Session
# workspaces receive concrete SELinux MAC coverage under
# docker_helper_workspace_t via persistent semanage fcontext + restorecon,
# managed through the Session MAC binding lifecycle.
#
# Global and Principal allowed roots are authorization policy only. Neither
# adding nor removing an allowed root prepares or mutates SELinux MAC state.
# The common workflow:
#
#   docker-helper config allowed-root add /opt
#       authorization-only (no MAC state change)
#
# The concrete Session workspace is the MAC lifecycle unit. The
# sessionMACCoordinator owns acquisition and release of workspace MAC
# bindings; the SELinux workspace MAC driver and its native fcontext
# machinery provide the durable docker_helper_workspace_t coverage required
# for non-home Session workspaces. /home workspaces retain the normal
# supported user_home_type label path.
#
# Integration mechanism: raw checkmodule policy with container-selinux
# attributes. docker_helper_container_t carries both container_domain and
# mcs_constrained_type, matching the attributes applied by
# container-selinux's container_type_template.
#
# container_domain provides generic container confinement rules from the
# loaded container-selinux policy (network, process transition from
# container_runtime_domain). mcs_constrained_type enables MCS category
# isolation. Neither attribute alone is sufficient; both are required.
#
# This module explicitly provides:
#   - role system_r membership for docker_helper_container_t
#   - container_file_t rootfs access (full create/write/rename/unlink,
#     directory management, ELF mmap/execute, Unix sockets)
#   - user_home_type workspace access (for /home paths)
#   - docker_helper_workspace_t workspace access (for non-home Session workspaces)
#
# Why raw checkmodule (not m4/refpolicy):
#   - The module is a small addition to the existing container-selinux policy.
#   - It defines one new domain (docker_helper_container_t) and five new file
#     types for docker-helper's own paths. No refpolicy interfaces needed.
#   - Building through m4/refpolicy would require installing refpolicy build
#     infrastructure and rebuilding the entire container-selinux module.
#   - Raw checkmodule is the standard approach for small policy additions
#     that compose with the base policy via shared attributes.
#
# Build:
#   checkmodule -M -m -o docker_helper.tmp docker-helper.te
#   semodule_package -o docker_helper.pp -m docker_helper.tmp -f docker-helper.fc
#
# Install:
#   sudo semodule -i docker_helper.pp
#
# Remove:
#   sudo semodule -r docker_helper

module docker_helper 1.2;

	require {
		attribute domain;
		attribute file_type;
		attribute exec_type;
		attribute user_home_type;
		attribute container_domain;
		attribute mcs_constrained_type;
		attribute container_net_domain;
		attribute can_change_object_identity;

		type security_t;
		type node_t;
		type init_t;
		type container_runtime_exec_t;
		type container_runtime_t;
		type passwd_file_t;
		type tun_tap_device_t;
		type nsfs_t;
		type container_var_run_t;
		type user_home_dir_t;
		type fs_t;
		type usr_t;
		type lib_t;
		type net_conf_t;
		type http_port_t;
		type cert_t;
		type container_file_t;
		type cgroup_t;
		type proc_t;
		type sysctl_net_t;
		type sysctl_t;
		type kernel_t;
		type root_t;
		type tmp_t;
		type etc_t;
		type setfiles_exec_t;
		type selinux_config_t;
		type default_context_t;
		type file_context_t;
		type tmpfs_t;
		type semanage_t;
		type semanage_exec_t;
		type bin_t;
		type ifconfig_exec_t;
		type var_lock_t;
		type fusefs_t;
		type fuse_device_t;
		type mount_var_run_t;

		role system_r;

		class file { append create execute execute_no_trans getattr ioctl lock open read rename setattr unlink write entrypoint mounton map link relabelfrom relabelto };
		class dir { add_name create getattr ioctl open read remove_name rmdir search setattr write mounton map relabelfrom relabelto lock link unlink rename reparent };
		class sock_file { append create getattr ioctl read setattr unlink write open rename link lock };
		class lnk_file { create getattr read unlink write setattr append rename link ioctl lock relabelfrom relabelto };
		class chr_file { append create getattr ioctl read watch open write };
		class blk_file { append create getattr ioctl read };
		class fifo_file { append create getattr ioctl read watch write open setattr rename link unlink lock relabelfrom relabelto };
		class filesystem { mount remount unmount getattr associate mounton relabelfrom relabelto };
		class tcp_socket { create setopt bind node_bind listen accept getattr read write connect getopt name_connect };
		class unix_stream_socket { connectto getattr ioctl read write };
		class udp_socket { create setopt connect getattr read write };
		class netlink_route_socket { create setopt bind getattr write nlmsg_read read nlmsg_write };
		class tun_socket { create relabelfrom relabelto };
		class capability { dac_read_search dac_override sys_admin fowner setuid setgid };
		class capability2 { wake_alarm kill };
		class user_namespace { create };
		class cap_userns { sys_admin sys_ptrace sys_chroot net_admin };
		class process { transition siginh noatsecure rlimitinh sigkill setexec };
		class process2 { nnp_transition };
	}

# Domain definition
type docker_helper_t, domain;

# The workspace MAC lifecycle relabels concrete non-home workspaces between
# usr_t and docker_helper_workspace_t. Those objects carry the unconfined_u
# SELinux identity (restorecon without -F preserves user/role), while the
# daemon runs as system_u:system_r:docker_helper_t. The base policy constraint
# on { create relabelfrom relabelto } requires u1 == u2 unless the relabeling
# domain has can_change_object_identity; docker_helper_t must therefore carry
# that attribute to relabel workspace objects across the SELinux identity
# boundary (proven by enforcing UAT AVCs).
typeattribute docker_helper_t can_change_object_identity;

# Allow system_r role to transition into docker_helper_t (systemd integration)
role system_r types docker_helper_t;

# Executable type for /usr/bin/docker-helper
type docker_helper_exec_t, file_type, exec_type;

# Dedicated file types for docker-helper-owned paths (from live AVC evidence)
type docker_helper_config_t, file_type;
type docker_helper_state_t, file_type;
type docker_helper_runtime_t, file_type;

# Dedicated type for the admin-token replacement objects: the
# canonical admin.token and the ONE fixed staging pathname the daemon
# renames onto it. This is MAC implementation state for the token
# replacement lifecycle, not a product/domain noun. docker_helper_config_t
# stays read-only for the daemon: the replacement lifecycle is expressed as
# permissions on the token type plus the config-directory namespace
# operations the rename requires, never as a writable config type.
type docker_helper_admin_token_t, file_type;

# Dedicated type for concrete non-home Session workspace MAC coverage.
# Applied via semanage fcontext + restorecon by the SELinux workspace MAC
# driver through the Session MAC binding lifecycle (sessionMACCoordinator).
# /home paths use user_home_type and are NOT relabelled.
type docker_helper_workspace_t, file_type;

# Dedicated type for injected trusted CA material under /run/docker-helper/trusted-ca.
# A dedicated type (not docker_helper_runtime_t) is required so the container
# domain can read the injected CA while retaining no access to the rest of the
# helper runtime state (socket/lock/cidfiles/mount machinery).
type docker_helper_trusted_ca_t, file_type;

# Custom container domain for docker-helper containers.
# Composes with container-selinux via shared attributes:
#   container_domain       — generic container confinement rules
#   mcs_constrained_type   — MCS category isolation
#   container_net_domain   — standard container network egress rules
# Container transitions are performed by container_runtime_domain (Docker).
# Explicit rules below reproduce the minimum container-selinux container
# domain semantics that this module must provide independently:
#   - role system_r membership (required by target policy)
#   - container_file_t rootfs access (full container workload semantics)
# The only extra permissions beyond standard container-selinux are:
#   allow docker_helper_container_t user_home_type: { workspace access }
#   allow docker_helper_container_t docker_helper_workspace_t: { workspace access }
type docker_helper_container_t, domain;
typeattribute docker_helper_container_t container_domain;
typeattribute docker_helper_container_t mcs_constrained_type;
typeattribute docker_helper_container_t container_net_domain;
role system_r types docker_helper_container_t;

# --- docker_helper_t: daemon process ---

# Binary needs to be readable/executable by the domain itself
allow docker_helper_t docker_helper_exec_t:file { read open execute getattr entrypoint };

# systemd (init_t) needs to execute the binary (from live AVC evidence)
allow init_t docker_helper_exec_t:file { read open execute };

# systemd (init_t) -> docker_helper_t explicit transition (SELinuxContext= in unit file)
allow init_t docker_helper_t:process { transition siginh };
allow init_t docker_helper_t:process2 { nnp_transition };

# systemd (init_t) needs to create/cleanup RuntimeDirectory (from live AVC evidence)
allow init_t docker_helper_runtime_t:dir { create rmdir write remove_name };

# systemd (init_t) needs to unlink socket lock file (from live AVC evidence)
allow init_t docker_helper_runtime_t:file { unlink };

# systemd (init_t) needs to unlink RuntimeDirectory symlinks (from live AVC evidence)
allow init_t docker_helper_runtime_t:lnk_file { unlink };

# journald: docker_helper_t reads the inherited systemd stream socket
# for stdout/stderr (StandardOutput=journal, StandardError=journal).
# Equivalent to init_rw_inherited_stream_socket(docker_helper_t).
allow docker_helper_t init_t:unix_stream_socket { getattr ioctl read write };

# Config (from live AVC evidence)
allow docker_helper_t docker_helper_config_t:dir { search };
allow docker_helper_t docker_helper_config_t:file { read open getattr };

# Admin-token replacement lifecycle.
#
# The token type carries the full replacement lifecycle: create/write/setattr
# on the fixed staging pathname, the rename onto admin.token, unlink of
# staging residue, and the startup read/open/getattr of the token file
# itself. The SELinux type travels with the inode across rename, so
# admin.token is docker_helper_admin_token_t without a rename-side relabel.
#
# The config DIRECTORY receives only the namespace operations the staged
# replacement requires (write/add_name/remove_name) — never a generic dir
# write beyond that, and docker_helper_config_t:file keeps exactly
# read/open/getattr (read-only): no create/write/rename/unlink on config_t
# files, and existing config_t objects cannot be overwritten by a token
# rename (the destination-object unlink permission is not granted).
#
# The token type is CREATION-constrained: a newly created staging file
# receives docker_helper_admin_token_t only through the exact filename
# transition for ".admin-token.new" (no generic config-dir transition), and
# direct creation of an arbitrary fresh config-dir name stays denied (no
# transition applies, so the new file inherits docker_helper_config_t and
# create is not granted).
#
# ACCEPTED SELinux backend mechanic (proven at runtime, release-owner
# ruling on PR #57 review round 2): SELinux does NOT provide
# AppArmor-equivalent destination-basename mediation for rename. Once a
# token_t inode exists, the granted directory namespace
# (write/add_name/remove_name) plus the inode permissions (rename/unlink)
# allow it to be renamed to an otherwise unused basename in the config
# directory. This is a backend mechanic, not additional product authority:
# the rotation lifecycle has ONE production rename (.admin-token.new ->
# admin.token), and no API/CLI/config surface can request any other
# config-directory rename.
#
# The deployment relabel of the token pathnames (fresh-install post-create
# relabel and the upgrade/reinstall migration) runs from the unconfined
# operator/packaging context — the daemon never relabels the token, so no
# relabel permission is granted here.
allow docker_helper_t docker_helper_config_t:dir { write add_name remove_name };
allow docker_helper_t docker_helper_admin_token_t:file { create open read write getattr setattr rename unlink };

# Exact filename transition: a file the daemon creates in the config
# directory is docker_helper_admin_token_t ONLY when its name is exactly
# the fixed staging pathname. Without the name specifier the transition
# would label every daemon-created config-dir file as the token type —
# deliberately not granted.
type_transition docker_helper_t docker_helper_config_t:file docker_helper_admin_token_t ".admin-token.new";

# Runtime (from live AVC evidence)
allow docker_helper_t docker_helper_runtime_t:dir { getattr search read open write add_name remove_name create mounton rmdir setattr };
allow docker_helper_t docker_helper_runtime_t:file { create read write open lock unlink mounton getattr setattr rename };
allow docker_helper_t docker_helper_runtime_t:sock_file { create setattr unlink };
# D1 (v2.2.0-rc.8 UAT): build-context staging preserves build-context
# symlinks themselves. The staging walker re-creates each source symlink with
# its original link text (Symlinkat — create) and then applies the source
# symlink's own timestamps to the staged link via
# utimensat(..., AT_SYMLINK_NOFOLLOW) (setTimesFromStat, staging_linux.go),
# which is mediated as setattr on the staged lnk_file object itself — never
# on the link target, which is never dereferenced or imported. Without
# setattr every build context containing a symlink fails staging with EACCES
# before BuildKit starts (HTTP 500 internal_error).
allow docker_helper_t docker_helper_runtime_t:lnk_file { create read setattr unlink };

# State (from live AVC evidence)
# dir create/rmdir: the 2.2 workload-MAC lifecycle creates the durable
# workload-mac state root and per-operation directories at startup and
# removes them through reconciliation; file rename: the crash-safe
# ownership-record commit (write temp file + rename).
allow docker_helper_t docker_helper_state_t:dir { getattr search read open write add_name remove_name create rmdir };
allow docker_helper_t docker_helper_state_t:file { create read write open getattr setattr lock unlink rename };

# Trusted CA material is dynamically created by the daemon under
# /run/docker-helper/trusted-ca. Type transitions label newly created snapshot
# dirs, ca.pem, and the hash symlink as docker_helper_trusted_ca_t so they are
# readable by the container domain. The trusted-ca base directory itself is
# labeled via the file-context rule + restorecon at preparation time.
type_transition docker_helper_t docker_helper_trusted_ca_t:dir docker_helper_trusted_ca_t;
type_transition docker_helper_t docker_helper_trusted_ca_t:file docker_helper_trusted_ca_t;
type_transition docker_helper_t docker_helper_trusted_ca_t:lnk_file docker_helper_trusted_ca_t;

# Trusted CA management (from CA preparation operations): create snapshot
# dirs, write/chmod/rename ca.pem, create/read the hash symlink, inspect and
# reuse an existing snapshot.
allow docker_helper_t docker_helper_trusted_ca_t:dir { create getattr search read open write add_name remove_name setattr };
allow docker_helper_t docker_helper_trusted_ca_t:file { create read write open getattr setattr rename unlink };
# getattr on the existing trusted-CA hash symlink is required so restorecon
# (running as docker_helper_t via execute_no_trans on setfiles_exec_t) can read
# the current label of the already-labeled symlink during the daemon-restart
# re-preparation. Live AVC (bounded enforcing run, auditd verified capturing):
#   avc: denied { getattr } scontext=docker_helper_t
#     tcontext=docker_helper_trusted_ca_t tclass=lnk_file comm="restorecon"
#     name=<hash>.0
# Without it, the RPM-reinstall restart fails with "trusted CA restorecon
# failed: ... Could not set context for .../<hash>.0: Permission denied".
allow docker_helper_t docker_helper_trusted_ca_t:lnk_file { create read unlink getattr };

# restorecon relabels the trusted CA tree from docker_helper_runtime_t to
# docker_helper_trusted_ca_t. relabelfrom is on the runtime source types,
# relabelto on the trusted CA target types.
# Proven necessary by enforcing UAT of trusted CA relabeling.
# Production restorecon invocation uses -R -m.
allow docker_helper_t docker_helper_runtime_t:dir { relabelfrom };
allow docker_helper_t docker_helper_trusted_ca_t:dir { relabelto };
allow docker_helper_t docker_helper_runtime_t:lnk_file { getattr relabelfrom };
allow docker_helper_t docker_helper_trusted_ca_t:lnk_file { relabelto };
allow docker_helper_t docker_helper_runtime_t:file { relabelfrom };
allow docker_helper_t docker_helper_trusted_ca_t:file { relabelto };

# Execute restorecon (setfiles_exec_t) without domain transition.
# This allows docker_helper_t to relabel its own trusted-CA tree while
# avoiding transition to the privileged setfiles_t domain.
allow docker_helper_t setfiles_exec_t:file { getattr read open execute execute_no_trans map };

# SELinux configuration access required for restorecon to read file_contexts.
# restorecon runs with -m (no mount-table scan), so only the file_contexts
# files themselves and the default_contexts config are touched.
allow docker_helper_t selinux_config_t:file { read open getattr };
allow docker_helper_t default_context_t:dir { search };
allow docker_helper_t default_context_t:file { read open getattr };
allow docker_helper_t file_context_t:dir { search };
allow docker_helper_t file_context_t:file { read open getattr };

# /sys/fs/selinux/enforce (from live AVC evidence)
allow docker_helper_t security_t:file { read open getattr };

# TCP listener socket (from live AVC evidence)
allow docker_helper_t self:tcp_socket { create setopt bind listen accept getattr read write };

# Bind TCP listener to local node (from live AVC evidence)
allow docker_helper_t node_t:tcp_socket { node_bind };

# Docker CLI execution (from live AVC evidence)
# /usr/bin/docker must remain in docker_helper_t (execute_no_trans, not transition)
allow docker_helper_t container_runtime_exec_t:file { getattr execute read open execute_no_trans };

# Docker reads /etc/passwd for user resolution
allow docker_helper_t passwd_file_t:file { read open getattr };

# Docker socket access
allow docker_helper_t container_var_run_t:sock_file { write };
allow docker_helper_t container_runtime_t:unix_stream_socket { connectto };

# Workspace access: docker-helper reads workspaces with normal user_home_type labels.
# No relabeling required. Uses user_home_type attribute to cover all home types.

# user_home_type:dir — workspace directory traversal and access
allow docker_helper_t user_home_type:dir { getattr search read open };

# user_home_type:file — workspace file access (Docker context, build files)
allow docker_helper_t user_home_type:file { getattr read open };

# user_home_type:lnk_file — symlink traversal in workspace
# D1 (v2.2.0-rc.8 UAT): a build-context symlink entry is staged as a symlink.
# The staging walker fstats every source entry through its O_PATH fd before
# readlinkat (copyEntry, staging_linux.go), which requires getattr on the
# workspace lnk_file object itself — never on the link target, which is never
# dereferenced. The supported SELinux UAT setup labels home workspaces
# user_home_t (user_home_type attribute); without getattr every build context
# containing a symlink fails staging there before BuildKit starts.
allow docker_helper_t user_home_type:lnk_file { getattr read };

# Home directory traversal (proven in enforcing UAT)
allow docker_helper_t user_home_dir_t:dir { getattr search };

# Non-home Session workspace access (docker_helper_workspace_t).
# Same read/traversal permissions as user_home_type for the daemon.
# Persistent SELinux coverage for concrete non-home Session workspaces,
# managed through the Session MAC binding lifecycle via semanage fcontext
# + restorecon.

# docker_helper_workspace_t:dir — workspace directory traversal and access
allow docker_helper_t docker_helper_workspace_t:dir { getattr search read open };

# docker_helper_workspace_t:file — workspace file access (Docker context, build files)
allow docker_helper_t docker_helper_workspace_t:file { getattr read open };

# docker_helper_workspace_t:lnk_file — symlink traversal in workspace
allow docker_helper_t docker_helper_workspace_t:lnk_file { read };

# --- semanage execution (docker_helper_t -> semanage_exec_t -> semanage_t) ---
#
# The Session MAC preparation (ensureWorkspaceFcontext) lists local fcontext
# rules with `semanage fcontext -l -C -n` and adds the workspace boundary with
# `semanage fcontext -a`. The standard semanage domain-transition pattern
# (semanage_domtrans, as present in the installed policy for init_t, sysadm_t,
# etc.) is:
#   type_transition <dom> semanage_exec_t:process semanage_t
#   allow <dom> semanage_t:process { transition siginh }
#   allow <dom> semanage_t:process2 nnp_transition   (only when NNP is set)
#   allow <dom> semanage_exec_t:file { execute read open getattr map }
#   allow semanage_t semanage_exec_t:file { execute read open getattr map entrypoint }
#
# Live AVC evidence (bounded enforcing run, auditd verified capturing) added the
# delta permissions:
#   avc: denied { noatsecure } scontext=docker_helper_t tcontext=semanage_t tclass=process
#     -> the process transition also requires noatsecure (and rlimitinh, the
#        kernel-required companion) beyond transition/siginh;
#   avc: denied { execute } scontext=docker_helper_t tcontext=bin_t
#     name=python3.13 tclass=file
#     -> the exec'ing source domain itself must be able to execute the script
#        interpreter (python3.13 at bin_t), even though the script exec
#        transitions the child to semanage_t.
#
# Accepted trade-off: the interpreter has no narrower stable type on Tumbleweed
# (semanage_exec_t labels the script, not its interpreter; bin_t is the generic
# /usr/bin label). A narrower executable-specific type would require a custom
# fcontext/relabel of /usr/bin/python3.* keyed to the interpreter version
# (python3.13 vs python3.14), which is distro/version coupling and worse than
# the bounded bin_t file-permission grant below (exec only, no process
# transition/entrypoint, no generic policy-store access). Same-domain generic
# execution remains forbidden: there is deliberately no execute_no_trans on
# bin_t.
#
# NoNewPrivileges=true in docker-helper.service means the transition requires
# process2:nnp_transition (mirrors the existing init_t -> docker_helper_t rule).
type_transition docker_helper_t semanage_exec_t:process semanage_t;
allow docker_helper_t semanage_t:process { transition siginh noatsecure rlimitinh };
# The daemon's bounded MAC-command execution kills a hung
# frontend child at the fixed MAC transition budget with kill(2) SIGKILL. The
# real semanage frontend runs in the semanage_t domain (the type transition
# above), so the budget kill requires the signal permission toward that
# domain. Observed hostile-UAT evidence (Tumbleweed): without it the budget
# kill is denied, the hung semanage_t child survives the budget, and the
# Session create waits unbounded. Pdeathsig delivery is kernel-internal and
# not AVC-checked, so it already covers the daemon-exit path; only the
# daemon's own budget kill needs this grant. restorecon runs in the same
# domain (execute_no_trans below), so no additional grant is needed for it.
allow docker_helper_t semanage_t:process sigkill;
allow docker_helper_t semanage_t:process2 { nnp_transition };
allow docker_helper_t semanage_exec_t:file { execute read open getattr map };
allow semanage_t semanage_exec_t:file { execute read open getattr map entrypoint };
allow docker_helper_t bin_t:file { execute read open getattr map };

# --- SELinux workspace serialization lock (/run/lock/docker-helper-selinux.lock) ---
# ensureWorkspaceFcontext acquires this global lock before listing/adding
# fcontext rules. The lock lives in /run/lock (var_lock_t). AVC:
#   avc: denied { write } scontext=docker_helper_t tcontext=var_lock_t
#     name=lock tclass=dir
allow docker_helper_t var_lock_t:dir { write add_name };
allow docker_helper_t var_lock_t:file { create open read write getattr lock };

# Capabilities for workspace access, mount-pin, and helper-owned projection
# mount/unmount mechanics (proven in enforcing UAT).
allow docker_helper_t self:capability { dac_read_search dac_override sys_admin };

# fowner: the Session MAC binding relabels issued external filesystem trees
# owned by the Principal user (restorecon sets security.selinux on
# non-daemon-owned objects; that setxattr requires CAP_FOWNER for a foreign
# file). This is a domain capability grant to docker_helper_t as a whole,
# not a call-stack-scoped permission; restorecon is the observed daemon
# operation that exercises it.
# Proven necessary by the enforcing final UAT (Release 2.2 issued-tree
# architectural correction):
#   avc:  denied  { fowner } comm="restorecon"
#     scontext=system_u:system_r:docker_helper_t:s0
#     tcontext=system_u:system_r:docker_helper_t:s0 tclass=capability permissive=0
allow docker_helper_t self:capability fowner;

# bindfs (the projection worker) reads the libmount utab under /run/mount on
# every FUSE mount.
#   avc: denied { search } scontext=docker_helper_t tcontext=mount_var_run_t
#     name=mount tclass=dir
#   avc: denied { dac_override } scontext=docker_helper_t comm=bindfs
#     tclass=capability (user-owned backing files read through projections)
allow docker_helper_t mount_var_run_t:dir { search };
allow docker_helper_t mount_var_run_t:file { getattr read open };

# Mount-pin: unmount filesystem (proven in enforcing UAT)
allow docker_helper_t fs_t:filesystem { unmount };

# restorecon -R -m inspects the filesystem containing its explicit target path
# (trusted-ca lives on tmpfs). statfs() on the target filesystem requires
# getattr on the filesystem class. This is not a mount-scan permission.
allow docker_helper_t tmpfs_t:filesystem { getattr };

# Workspace restorecon (-R -m -x) inspects the filesystem containing its
# explicit target path: a non-home workspace lives on the root filesystem.
# selinux_restorecon_common() unconditionally fstatfs()es the recursive walk
# target, which requires getattr on the filesystem class. Proven necessary by
# the bounded scope=selinux run AFTER the invocation was corrected to -m -x:
#   restorecon -R -m -x: ...: statfs(/opt/uat-ws-*) failed: Permission denied
# This mirrors the tmpfs_t rule above and is NOT a mount-scan permission: the
# mount-scan filesystem types (device_t, devpts_t, cgroup_t, ...) stay denied.
allow docker_helper_t fs_t:filesystem { getattr };

# --- Workspace relabel grants (non-home Session workspaces) ---
#
# The Session MAC binding lifecycle relabels a concrete non-home workspace
# between its normal host label (usr_t for files created under /opt and other
# non-home roots) and docker_helper_workspace_t:
#   initial:   usr_t                     -> docker_helper_workspace_t
#   teardown:  docker_helper_workspace_t -> usr_t
# The mount-boundary guard (checkWorkspaceRelabelBoundary) runs before any of
# these recursive relabels, so no grant here can traverse a same-fs bind mount
# to an external source inode.
#
# Proven necessary by live AVC evidence in the bounded scope=selinux run with a
# temporary permissive docker_helper_t domain (both directions, container-created
# objects included). Each rule grants exactly the permissions exercised:
#   - getattr is included only where restorecon reads the current label of an
#     already-labeled object before relabeling it (usr_t fifo_file, and
#     workspace_t lnk_file/fifo_file).
#   - usr_t:lnk_file getattr is deliberately NOT granted: it was not denied in
#     the permissive run and is not needed by restorecon on the initial pass.
# Deliberately excluded (not evidenced): file_type attribute relabel, generic
# relabel, and sock_file/chr_file/blk_file relabel.
#
# usr_t (initial-pass source / teardown target)
allow docker_helper_t usr_t:dir { relabelfrom relabelto };
allow docker_helper_t usr_t:file { relabelfrom relabelto };
allow docker_helper_t usr_t:lnk_file { relabelfrom relabelto };
allow docker_helper_t usr_t:fifo_file { getattr relabelfrom relabelto };

# docker_helper_workspace_t (teardown source / initial-pass target)
allow docker_helper_t docker_helper_workspace_t:dir { relabelfrom relabelto };
allow docker_helper_t docker_helper_workspace_t:file { relabelfrom relabelto };
allow docker_helper_t docker_helper_workspace_t:lnk_file { getattr relabelfrom relabelto };
allow docker_helper_t docker_helper_workspace_t:fifo_file { getattr relabelfrom relabelto };

# --- Buildx execution/runtime/network/certificates (proven in enforcing UAT) ---

# Buildx needs lib_t for execute_no_trans (executing the Docker Buildx CLI plugin)
allow docker_helper_t lib_t:file { execute_no_trans };

# Unix stream socket connectto for Buildx daemon communication
allow docker_helper_t self:unix_stream_socket { connectto };

# Network configuration read
allow docker_helper_t net_conf_t:file { read open getattr };

# /proc/sys/net directory search by Docker (from live AVC evidence):
#   scontext=docker_helper_t tcontext=sysctl_net_t tclass=dir denied { search } name=net
allow docker_helper_t sysctl_net_t:dir { search };

# sysctl_net_t file read/open for the Go listener (proven in enforcing UAT).
allow docker_helper_t sysctl_net_t:file { read open };

# UDP socket for DNS resolution (proven in enforcing UAT)
allow docker_helper_t self:udp_socket {
	create setopt connect getattr read write
};

# TCP socket for Buildx network communication
allow docker_helper_t self:tcp_socket { connect getopt };

# HTTP port connection for registry access
allow docker_helper_t http_port_t:tcp_socket { name_connect };

# System certificate access for TLS verification
allow docker_helper_t cert_t:dir { search read open };
allow docker_helper_t cert_t:lnk_file { read };
allow docker_helper_t cert_t:file { read open getattr };

# cgroup traversal for Docker (from live AVC evidence):
#   scontext=docker_helper_t tcontext=cgroup_t tclass=dir denied { search } comm="docker"
# Search only; no broader cgroup permissions.
allow docker_helper_t cgroup_t:dir { search };

# cgroup cpu.max read by Docker (from live AVC evidence):
#   scontext=docker_helper_t tcontext=cgroup_t tclass=file denied { read } comm="docker" name=cpu.max
# Read/open only; no broader cgroup permissions.
allow docker_helper_t cgroup_t:file { read open };

# --- docker_helper_builder_t: builder manager domain (P5-S1) ---
#
# The builder backend (docker-helper-builder.service) runs the SAME shared
# binary as the daemon but is a separate, deliberately weaker domain:
# it owns only the per-op BuildKit instance lifecycle (manager socket,
# per-op runtime/state trees, the rootlesskit launch vehicle) and holds NO
# daemon authority — no helper config, no admin token, no Session
# workspace types, no Docker socket, no daemon-owned runtime/state types.
# The rootlesskit launch vehicle's post-exec mechanics live in the
# dedicated child domain (docker_helper_rootlesskit_t, P5-S2); the manager
# domain keeps the startup-purge surface only.
#
# Domain binding (P5-S1 item 2): the builder unit binds this domain
# explicitly through SELinuxContext= (the same mechanism as the main
# daemon unit). There is deliberately NO exec-type auto-transition of the
# shared docker_helper_exec_t to this domain: a type_transition would
# flip EVERY execution of the shared binary — any operator CLI
# invocation included — into the builder domain. The unit file is the
# single binding owner; the only process rule here is systemd's explicit
# SELinuxContext transition.
#
# The dedicated rootlesskit executable type keeps the manager's launch
# grant narrow: the manager may execute the distro rootlesskit binary
# only, never a generic bin_t execution grant (mirrors the bindfs
# precedent; the restorecon wiring ships with the deployment lifecycle).
type docker_helper_builder_t, domain;
role system_r types docker_helper_builder_t;

# Private file types for the builder-owned trees (RuntimeDirectory/
# StateDirectory=docker-helper-builder). Deliberately separate from the
# daemon's docker_helper_runtime_t/docker_helper_state_t: the builder's
# persistent trees carry their own types, and the daemon's access to
# them is limited to the manager-socket transport below.
#
# P5-S2 G32 r3 root split: the tree ROOTS and the shared ops containers
# carry dedicated root types. Operation processes get traversal only
# toward them (no create/add_name/unlink), which closes the root-plane
# write surfaces (the state root's $HOME/.config injection path, the
# runtime root's manager.sock replacement path, sibling top-level op
# entries). Only the CHILDREN of ops/ carry the per-op tree types; the
# per-op directories receive their per-op type AND the operation's MCS
# category at provisioning (a later phase).
type docker_helper_builder_runtime_t, file_type;
type docker_helper_builder_state_t, file_type;
type docker_helper_builder_runtime_root_t, file_type;
type docker_helper_builder_state_root_t, file_type;

# P5-S2 G32 r3 context type: the daemon's handoff material typed at
# ingress — the staged build context subtree that buildctl reads and
# buildkitd materializes inside the per-op state tree. Declared as the
# policy foundation only: the ONLY assignment owner is the Phase 5 runtime
# ingress relabel (type plus the operation's MCS category, applied after a
# successful START); there is deliberately NO fc rule for it (a broad fc
# pattern would pre-type the staging tree and widen the context grant
# surface ahead of the implementation), and the daemon's access grant-set
# lands with the ingress implementation phase. The daemon keeps ZERO
# grants on docker_helper_builder_state_t.
type docker_helper_builder_context_t, file_type;

# Dedicated exec type for the distro rootlesskit binary. The builder
# manager execs it in its own domain (no transition) as the launch
# vehicle for every BuildKit instance; a dedicated type keeps the grant
# to exactly this binary instead of a generic bin_t execution grant.
# The child-process mechanics INSIDE rootlesskit/buildkitd (their own
# execs, mounts, networking) are a separate MAC task and get NO grants
# here.
type docker_helper_rootlesskit_exec_t, file_type;

# Dedicated exec type for the distro slirp4netns helper (P5-S2 step 3).
# RootlessKit launches slirp4netns as its user-network helper; live
# enforcing AVC evidence (P5-S1 Tumbleweed: run 36181122102 P6 window:
# denied { execute } comm="rootlesskit" name="slirp4netns" tcontext=bin_t
# permissive=0; permissive harvests: the same path plus
# execute_no_trans) names /usr/bin/slirp4netns as the actual path. The
# type keeps the grant to exactly this binary; execution is allowed ONLY
# from the rootlesskit child domain — never a generic bin_t execution
# grant and never the manager domain (the manager only launches
# rootlesskit).
type docker_helper_slirp4netns_exec_t, file_type;

# Dedicated exec type and domain for the distro newuidmap binary (P5-S2
# step 7). RootlessKit launches newuidmap as its UID-mapping helper after
# creating the user namespace; live enforcing AVC evidence (P5-S1
# Tumbleweed run 36226290873 P6 window: denied { execute } comm="rootlesskit"
# name="newuidmap" tcontext=bin_t tclass=file permissive=0) names
# /usr/bin/newuidmap as the actual path; the P4 proof asserts the distro
# owns the binary and its setuid bit is intact. A dedicated domain keeps
# the transition confined to this binary; newuidmap's own privilege surface
# (setuid capabilities, its file access) is granted per enforcing AVC
# evidence in the P5-S2 runtime section below.
type docker_helper_newuidmap_exec_t, file_type;
type docker_helper_newuidmap_t, domain;
role system_r types docker_helper_newuidmap_t;

# Dedicated exec type and domain for the distro newgidmap binary (P5-S2
# step 8). RootlessKit launches newgidmap as its GID-mapping helper right
# after the UID-map step of the same flow; live enforcing AVC evidence
# (P5-S1 Tumbleweed run 36268063504 P6 window, record 745: denied
# { execute } comm="rootlesskit" name="newgidmap" tcontext=bin_t tclass=file
# permissive=0) names /usr/bin/newgidmap as the actual path — the flow
# reached the GID map exactly because the UID map succeeded, so the exec
# denial is the GID flow's entry boundary. The P4 proof asserts the distro
# owns the binary and its chkstat-applied cap_setgid file capability is
# the distro privilege mechanism (permissions.d/shadow), untouched by
# docker-helper. A dedicated domain keeps the transition confined to this
# binary; newgidmap's own runtime surface (its inherited-stdio fifo write,
# the /proc target-dir read-open-getattr-search, the getpwuid passwd
# read-open, and the gid_map file write-open) is granted per enforcing
# AVC evidence in the P5-S2 runtime section below — everything beyond it
# stays ungranted.
type docker_helper_newgidmap_exec_t, file_type;
type docker_helper_newgidmap_t, domain;
role system_r types docker_helper_newgidmap_t;

# Dedicated exec type for the distro nsenter binary (P5-S2 Phase 4C-3).
# RootlessKit's network setup runs nsenter to create the tap device inside
# the flow's namespaces; live enforcing AVC evidence (Phase 4C-2 run
# 36626399836, launch-window record 402: denied { execute }
# comm="rootlesskit" name="nsenter" tcontext=system_u:object_r:bin_t:s0
# tclass=file permissive=0, followed in the same window by rootlesskit's
# own failure "failed to setup network ...: setting up tap tap0:
# executing [[nsenter -t 2845 -n -m -U --preserve-credentials ip tuntap
# add name tap0 mode tap] [nsenter -t 2845 -n -m -U
# --preserve-credentials ip link set tap0 up]]: exec: \"nsenter\":
# executable file not found in $PATH" — Go's exec.LookPath turns the
# SELinux EACCES execute denial into ErrNotFound — and then the child's
# EOF and the instance death) names /usr/bin/nsenter as the actual path:
# Tumbleweed ships nsenter ONLY at /usr/bin/nsenter (the util-linux
# packaged file list; the stand probe records command -v / readlink -f /
# rpm -qf / ls -lZ / matchpathcon as the live authority). The type keeps
# the grant to exactly this binary; nsenter stays IN the rootlesskit
# child domain (execute_no_trans, no separate domain, no entrypoint): the
# helper uses the flow's own namespace/capability authority, a separate
# privilege owner is not yet evidence-required, and the same-domain exec
# naturally keeps the operation category. The next executable the flow
# runs (ip) stays a separate live boundary and receives NO grant here;
# nsenter also receives NO generic bin_t execution — getsubids (the other
# bin_t execute denial of the same window, record 398) stays closed.
type docker_helper_nsenter_exec_t, file_type;

# Entrypoint: the builder unit execs the shared binary
# (docker_helper_exec_t) under SELinuxContext=, so the builder domain
# needs the same entrypoint shape the daemon domain has for its own
# start (mirrors the proven daemon rule).
allow docker_helper_builder_t docker_helper_exec_t:file { read open execute getattr entrypoint };

# systemd (init_t) binds the unit to the domain through SELinuxContext=.
# No nnp_transition: the builder unit deliberately runs WITHOUT
# NoNewPrivileges (the recorded Release-2.4 exception — the rootlesskit
# newuidmap/newgidmap elevation), so the setexeccon transition checks
# only transition and the signal-inheritance companion.
allow init_t docker_helper_builder_t:process { transition siginh };

# systemd (init_t) creates the unit's RuntimeDirectory and StateDirectory
# with the file_contexts label and removes them on service stop (same
# mechanism as the main unit's runtime dir; mirror of the proven init_t
# docker_helper_runtime_t grants). setattr: systemd chowns the exec
# directories to the service identity (setup_exec_directory -> chmod_and_chown/
# path_chown_recursive) — a metadata change the main unit (root service)
# never exercised because chowning root-owned dirs to root is a no-op;
# for the dedicated builder identity the chown is real and requires setattr.
# Stop cleanup unlinks the directory contents (the manager socket, pid
# files, op residue) before rmdir.
# The G32 r3 root split re-points the systemd ROOT operations to the
# dedicated root types (the roots and the shared ops containers); the
# per-op tree types below keep the proven P5-S1 unlink surface for the
# per-op entries. The state side keeps the observed asymmetry: no
# sock_file unlink (the G30 finding; observe-first, AGENTS.md §13).
allow init_t docker_helper_builder_runtime_root_t:dir { create rmdir write remove_name setattr };
allow init_t docker_helper_builder_state_root_t:dir { create rmdir write remove_name setattr };
allow init_t docker_helper_builder_runtime_root_t:file { unlink };
allow init_t docker_helper_builder_runtime_root_t:lnk_file { unlink };
allow init_t docker_helper_builder_runtime_root_t:sock_file { unlink };
allow init_t docker_helper_builder_state_root_t:file { unlink };
allow init_t docker_helper_builder_state_root_t:lnk_file { unlink };
allow init_t docker_helper_builder_runtime_t:dir { create rmdir write remove_name setattr };
allow init_t docker_helper_builder_state_t:dir { create rmdir write remove_name setattr };
allow init_t docker_helper_builder_runtime_t:file { unlink };
allow init_t docker_helper_builder_runtime_t:lnk_file { unlink };
allow init_t docker_helper_builder_runtime_t:sock_file { unlink };
allow init_t docker_helper_builder_state_t:file { unlink };
allow init_t docker_helper_builder_state_t:lnk_file { unlink };

# The systemd executor mounts the unit's tmpfs-backed runtime directory into
# its mount-rootfs when the unit's hardening directives create a mount
# namespace (live AVCs, P5-S1 Tumbleweed run, three attempts in one window):
#   scontext=system_u:system_r:init_t:s0
#   tcontext=system_u:object_r:docker_helper_builder_runtime_t:s0 tclass=dir
#   denied { mounton } path=/run/systemd/mount-rootfs/run/docker-helper-builder
# G32 r3: the mounted path is the unit ROOT, which now carries the root
# type (re-pointed, not duplicated).
allow init_t docker_helper_builder_runtime_root_t:dir { mounton };

# The ReadWritePaths bind over the state tree needs the same mount-on grant
# (live manager journal, same run; the runtime-dir mounton grant above moved
# the failure past the special-directory step to "Failed at step NAMESPACE"):
#   docker-helper-builder.service: Failed to mount
#   /var/lib/docker-helper-builder to
#   /run/systemd/mount-rootfs/var/lib/docker-helper-builder: Permission denied
#   -> Failed to set up mount namespacing -> status=226/NAMESPACE
# G32 r3: re-pointed to the state ROOT type (the mounted path is the root).
allow init_t docker_helper_builder_state_root_t:dir { mounton };

# journald: the manager writes its operational diagnostics to the
# inherited systemd journal stream socket (StandardOutput=journal,
# StandardError=journal). Mirror of the proven daemon rule.
allow docker_helper_builder_t init_t:unix_stream_socket { getattr ioctl read write };

# Runtime root, per-op runtime dirs, and the manager socket:
# startup lstat of both roots and the stale-socket check, the 0600
# socket create/setattr, per-op dir create/remove under ops/, and the
# instance.pid persistence.
allow docker_helper_builder_t docker_helper_builder_runtime_t:dir { getattr search read open write add_name remove_name create rmdir setattr };
allow docker_helper_builder_t docker_helper_builder_runtime_t:sock_file { create getattr setattr unlink };
allow docker_helper_builder_t docker_helper_builder_runtime_t:file { create read write open getattr setattr unlink };

# G32 r3 §4.2 provisioning relabel (P5-S2 Phase 3): the manager assigns
# each required top-level per-op directory its exact FULL context —
# per-op type plus the operation's MCS category — by writing
# security.selinux. The kernel's setxattr relabel path checks BOTH
# sides: the source-side relabelfrom on the OLD type (the freshly
# created directories inherit the root types), the target-side
# relabelto toward the NEW type (the per-op types), plus setattr on the
# object and the filesystem assoc (setattr/getattr granted above). The
# relabel is the root-type -> per-op-type cross-type transition on the
# manager's own directories; the roots and the shared ops containers
# stay root-typed, and the flow child never gains relabel authority.
allow docker_helper_builder_t docker_helper_builder_runtime_root_t:dir { relabelfrom };
allow docker_helper_builder_t docker_helper_builder_state_root_t:dir { relabelfrom };
allow docker_helper_builder_t docker_helper_builder_runtime_t:dir { relabelto };
allow docker_helper_builder_t docker_helper_builder_state_t:dir { relabelto };

# State root and per-op state dirs: startup purge scan + removal, and the
# START-time rootlesskit-state/root directory creation. The rootlesskit
# state-lock flock moved to the child domain (P5-S2; the enforcing P5-S1
# evidence attributed that denial to comm="rootlesskit", never to the
# manager).
allow docker_helper_builder_t docker_helper_builder_state_t:dir { getattr search read open write add_name remove_name create rmdir setattr };
allow docker_helper_builder_t docker_helper_builder_state_t:file { create read write open getattr setattr unlink };

# G32 r3 root split: the manager's ROOT-level operations re-pointed to the
# root types. Exactly the operations the manager performs at root level:
# startup lstat/verify of both roots, the ops-container lifecycle (create,
# per-op entry add/remove, listing for startup purge), and — on the runtime
# root — the manager.sock create/setattr/unlink/getattr. rmdir covers the
# pre-provisioning window: a per-op directory created before its
# provisioning relabel inherits the root type, and the manager's cleanup
# (the START failure convergence) must remove it. The manager does not
# rmdir/setattr the roots or the ops containers themselves; no root-level
# file surface exists.
allow docker_helper_builder_t docker_helper_builder_runtime_root_t:dir { getattr search read open write add_name remove_name create rmdir };
allow docker_helper_builder_t docker_helper_builder_runtime_root_t:sock_file { create getattr setattr unlink };
allow docker_helper_builder_t docker_helper_builder_state_root_t:dir { getattr search read open write add_name remove_name create rmdir };

# Identity guard: the startup execution-identity verification resolves
# the builder user through /etc/passwd (same access the daemon needs
# for Docker user resolution).
allow docker_helper_builder_t passwd_file_t:file { read open getattr };

# cgroup2 root traversal at process startup (live AVC, P5-S1 Tumbleweed run):
#   scontext=system_u:system_r:docker_helper_builder_t:s0
#   tcontext=system_u:object_r:cgroup_t:s0 tclass=dir denied { search } name=/ dev=cgroup2
# The Go runtime reads the unified cgroup2 root for container GOMAXPROCS
# detection at startup. Search only; the same access the daemon's Docker CLI
# children get from live evidence.
allow docker_helper_builder_t cgroup_t:dir { search };

# cgroup cpu.max read at process startup (live AVC, same window as above):
#   scontext=docker_helper_builder_t tcontext=cgroup_t tclass=file
#   denied { read } name=cpu.max dev=cgroup2
allow docker_helper_builder_t cgroup_t:file { read open };

# Startup purge /proc enumeration (live AVC storm, P5-S1 permissive-harvest
# window; the enforcing managers crashed on exactly this first: "startup
# purge: unit-cgroup enumeration failed; refusing startup"):
#   scontext=docker_helper_builder_t tcontext=proc_t tclass=dir denied { read }
#     (os.ReadDir("/proc") in builderScanUnitOwnedGroups)
#   scontext=docker_helper_builder_t tcontext=<process domain> tclass=dir
#     denied { getattr } path=/proc/<pid>
#     (os.Stat of every listed pid directory: kernel threads are kernel_t,
#     every system service is in the domain attribute)
allow docker_helper_builder_t proc_t:dir { read };
allow docker_helper_builder_t domain:dir { getattr };
allow docker_helper_builder_t kernel_t:dir { getattr };

# Go net-stack sysctl read at process startup (same window):
#   scontext=docker_helper_builder_t tcontext=sysctl_net_t tclass=dir
#     denied { search } name=net
#   scontext=docker_helper_builder_t tcontext=sysctl_net_t tclass=file
#     denied { read } then { open } name=somaxconn
allow docker_helper_builder_t sysctl_net_t:dir { search };
allow docker_helper_builder_t sysctl_net_t:file { read open };

# START resolves the system CA bundle for the child SSL_CERT_FILE
# (fail closed without one): stat/open of the ca-bundle candidates and
# the openSUSE symlink resolution (/etc/ssl/ca-bundle.pem ->
# /var/lib/ca-certificates/ca-bundle.pem), all cert_t on Tumbleweed.
# Live AVCs (P5-S1 enforcing run): the candidate stat also getattr's the
# parent directories:
#   scontext=docker_helper_builder_t tcontext=cert_t tclass=dir
#   denied { getattr } path=/etc/ssl then path=/var/lib/ca-certificates
allow docker_helper_builder_t cert_t:dir { search getattr };
allow docker_helper_builder_t cert_t:lnk_file { getattr read };
allow docker_helper_builder_t cert_t:file { getattr open read };

# Per-START MAC-backend detection for the categorized provisioning gate
# (P5-S2 Phase 4B-R1 live evidence, run 36598995674): every START's
# provision gate (builderProvisionGate -> detectLSM -> selinuxEnabled)
# reads /sys/fs/selinux/enforce before any provisioning or launch step,
# and a failed detection fails the START closed. The enforcing run showed
# the exact missing surface (the manager's own diagnostic, no AVC: the
# base policy dontaudits domain security_t:file reads):
#   START <op>: MAC backend detection failed: cannot determine SELinux
#   status: cannot read /sys/fs/selinux/enforce: open
#   /sys/fs/selinux/enforce: permission denied
# Exactly the daemon's proven grant shape (the daemon's own MAC
# detection); read/open/getattr only, and only for the manager domain —
# the launcher and the flow domain receive no security_t grant from this
# correction.
allow docker_helper_builder_t security_t:file { read open getattr };

# --- docker_helper_builder_launcher_t: the per-launch category child (G32 r3 §5) ---
#
# Launch chain: the manager (docker_helper_builder_t, s0 — it never changes
# its own range) re-execs the SHARED binary with the hidden internal
# launcher subcommand; THAT exec transitions into this dedicated
# authority-free domain. The launcher child validates the canonical
# category token, writes its OWN /proc/thread-self/attr/exec (setexeccon)
# with the
# FIXED target context (docker_helper_rootlesskit_t:s0:cX — the type,
# identity, and role are constants; the category is the only variable) and
# execs the rootlesskit entry file. The child dies at the execve, so two
# concurrent launches cannot bleed categories (the G31-measured mechanic;
# the G31 stand used the distro runcon binary as this child — the r3
# review replaced it with the project-owned launcher because relabeling the
# distro runcon binary would make its inode label a host-global policy
# contract).
#
# Structural fail-closed property (I9): the ONLY path into the flow domain
# is the launcher edge. The legacy direct launch rules were removed (the
# manager's rootlesskit exec grant and the direct
# builder_t -> rootlesskit_t transition): an OLD binary under the NEW
# policy cannot launch the flow at all — its legacy direct exec of
# rootlesskit_exec_t from builder_t is denied (no transition, no
# execute/execute_no_trans), so the uncategorized rootlesskit_t:s0
# composition is structurally unreachable. No category application without
# the launcher; no setexec authority for the manager.
#
# The grant set below is the structural chain skeleton plus the two
# R2-live-evidence startup grants (Phase 4B run 36605086350, three
# launcher-domain AVCs under Enforcing, permissive=0): the missing
# execute on the shared entry image (the post-transition executable
# mapping never completed — the launch died with SIGSEGV before any
# application code ran) and the write on the inherited inst.diag pipe
# (the manager's stdout/stderr fifo, whose exec-time inherited-fd check
# otherwise closes the fd and silences the launcher's own failure
# output — the same fd-use shape the rootlesskit mirror below covers).
# No other additions: the launcher stays authority-free.
type docker_helper_builder_launcher_t, domain;
role system_r types docker_helper_builder_launcher_t;

# Hop 1: the manager's self-reexec transitions into the launcher domain.
# The entry file is the shared binary; the source-side exec/bprm checks are
# already granted (the builder domain's own entry rule); the target side
# needs entrypoint plus the loader access (same shape the daemon's own
# entry rule carries) plus execute — the live-proven R2 startup grant for
# the shared image's own executable mapping after the transition.
type_transition docker_helper_builder_t docker_helper_exec_t:process docker_helper_builder_launcher_t;
allow docker_helper_builder_t docker_helper_builder_launcher_t:process { transition };
allow docker_helper_builder_launcher_t docker_helper_exec_t:file { entrypoint read open getattr map execute };

# The launcher child's only authority: its own forced-context write
# (setexeccon). The manager domain deliberately does NOT carry setexec.
allow docker_helper_builder_launcher_t self:process { setexec };

# The launcher inherits the manager's inst.diag output pipe exactly like
# the rootlesskit child below (live R2 evidence: denied { write } on the
# manager fifo from the launcher domain, twice); the inherited-fd check
# would otherwise close the fd and lose the launcher's failure output.
# Write only — the manager keeps the read end; this is the same
# launcher-stage mirror of the rootlesskit diag contract.
allow docker_helper_builder_launcher_t docker_helper_builder_t:fifo_file { write };

# Hop 2: the ONLY transition into the flow domain (G32 r3 I9). The forced
# setexeccon context (rootlesskit_t:s0:cX) is checked by the same
# transition machinery: the transition permission toward the target type,
# the target domain's entrypoint grant (below, keyed to the target domain),
# the same-user constrain, and the mcs escape for the non-constrained
# launcher domain. The transition permission is required for the forced
# context too.
type_transition docker_helper_builder_launcher_t docker_helper_rootlesskit_exec_t:process docker_helper_rootlesskit_t;
allow docker_helper_builder_launcher_t docker_helper_rootlesskit_t:process { transition };

# The launcher's source-side exec checks for hop 2 (the bprm open/read +
# the pre-exec getattr; the loader-side checks run in the flow domain,
# whose entry rule carries entrypoint/read/open/execute/execute_no_trans/
# getattr/map). No execute_no_trans in the source: the exec transitions.
allow docker_helper_builder_launcher_t docker_helper_rootlesskit_exec_t:file { execute read open getattr };

# --- docker_helper_rootlesskit_t: the rootlesskit child domain (P5-S2) ---
#
# The launcher child (docker_helper_builder_launcher_t) execs the distro
# rootlesskit binary with the forced operation context; the flow runs in
# this dedicated domain. The shared docker-helper binary is untouched for
# the daemon (executing docker_helper_exec_t has no transition rule into
# this domain), and the unit's SELinuxContext= binding still owns the
# builder domain. The child domain holds the rootlesskit-owned state-tree
# access moved from the manager by AVC evidence, the Go-runtime startup
# reads, and the pointed exec-type transitions for its own helper launches
# (slirp4netns, newuidmap, newgidmap — each entered only from this child
# domain). It gets NO manager rights, no PLAIN capability grant (its only
# capability surfaces are the evidenced in-namespace sys_admin, sys_ptrace,
# and sys_chroot bits and the userns create), and no buildkitd/bin_t
# execution: those stay deliberate boundaries needing their own evidence.
type docker_helper_rootlesskit_t, domain;
role system_r types docker_helper_rootlesskit_t;

# The transition into this domain lives in the launcher section above
# (hop 2): the launcher child's exec of the rootlesskit entry type is the
# ONLY path in (G32 r3 I9; the legacy direct builder_t transition was
# removed with the G32 r3 review).

# The child's own entry file: entrypoint for that transition plus the
# loader access, and execute_no_trans for rootlesskit's stage-2 re-exec of
# ITSELF (live permissive harvest AVC, run 36187436760: comm="rootlesskit"
# denied { execute_no_trans } on /usr/bin/rootlesskit from
# docker_helper_rootlesskit_t — rootlesskit re-executes its own binary
# inside the new user namespace and stays in this domain).
allow docker_helper_rootlesskit_t docker_helper_rootlesskit_exec_t:file { entrypoint read open execute execute_no_trans getattr map };

# The child's Go-runtime startup reads, mirrored from the proven manager
# rules (the child is the same binary mechanics in a weaker domain):
# the cgroup2 root walk for container GOMAXPROCS detection (live harvest
# AVC, same run: comm="rootlesskit" denied { search } on the unified
# cgroup2 root, system.slice and the builder service cgroup), the net-stack
# sysctl read (comm="rootlesskit" denied { search } name=net, then
# { read open } on somaxconn), and the /etc/passwd identity resolution
# (comm="rootlesskit" denied { read open getattr } on /etc/passwd).
allow docker_helper_rootlesskit_t cgroup_t:dir { search };
allow docker_helper_rootlesskit_t cgroup_t:file { read open };
allow docker_helper_rootlesskit_t sysctl_net_t:dir { search };
allow docker_helper_rootlesskit_t sysctl_net_t:file { read open };
allow docker_helper_rootlesskit_t passwd_file_t:file { read open getattr };

# Rootlesskit's own access into the builder-owned state tree, moved from
# the manager by AVC evidence. Enforcing P5-S1 windows: comm="rootlesskit"
# denied { lock } on .../rootlesskit-state/lock (tclass=file) — the
# child's first action. Permissive harvest windows: comm="rootlesskit"
# denied { read open }, { lock }, and repeated { write } on the
# .../rootlesskit-state directory, plus the child's state-file
# create/write for the lock file and the pid bookkeeping. The manager
# keeps its startup-purge surface; the child does not unlink or rmdir
# manager-owned state (the purge owns removal), and the child's only
# state-tree socket is its own api.sock (comm="rootlesskit" denied
# { create } and { unlink } on tclass=sock_file).
allow docker_helper_rootlesskit_t docker_helper_builder_state_t:dir { search getattr read open write add_name remove_name lock };
allow docker_helper_rootlesskit_t docker_helper_builder_state_t:file { create open read write getattr setattr lock };
allow docker_helper_rootlesskit_t docker_helper_builder_state_t:sock_file { create unlink };

# The child inherits the manager's inst.diag output pipe (Stdout/Stderr of
# the launch vehicle; the manager pumps it into its diagnostics buffer).
# The exec-time inherited-fd check closes ungranted inherited fds, which
# would silence the child's own failure output — the same fd-use shape the
# proven builder_t journald-socket rule covers for the manager.
allow docker_helper_rootlesskit_t docker_helper_builder_t:fifo_file { write };

# Rootlesskit reads the user-namespace limit before the userns setup
# (live harvest AVC evidence, three independent runs: comm="rootlesskit"
# denied { read open getattr } on /proc/sys/user/max_user_namespaces,
# tcontext=system_u:object_r:sysctl_t:s0 tclass=file). Read-only; the
# userns creation and the in-userns capability checks are granted
# separately below, each with its own enforcing AVC evidence.
allow docker_helper_rootlesskit_t sysctl_t:file { read open getattr };

# The launch vehicle's user-network helper: rootlesskit forks and execs
# the distro slirp4netns binary, which transitions into the dedicated
# helper domain (the type_transition below). Live AVC evidence from the
# P5-S1 permissive harvests (runs 36168484020, 36179424203, 36187436760):
# comm="rootlesskit" denied { execute } on the path lookup and
# { execute_no_trans } on the actual exec of /usr/bin/slirp4netns. The
# execute_no_trans pair was replaced by the pointed transition grant
# (P5-S2 step 5): the source-side exec checks are the same checks the
# transition exec performs (execute for the path lookup, bprm open/read,
# the pre-exec getattr from run 36199764374's live enforcing AVC; no map
# denial was recorded on the source side, so no map grant). Execute ONLY
# from the rootlesskit child domain; the manager domain's execution stays
# deliberately ungranted.
allow docker_helper_rootlesskit_t docker_helper_slirp4netns_exec_t:file { execute read open getattr };

# The flow's namespace-exec helper: rootlesskit's network setup runs the
# distro nsenter binary IN the rootlesskit child domain (execute_no_trans
# — same domain, no transition, no entrypoint): the helper uses the
# flow's own namespace/capability authority, a separate privilege owner
# is not yet evidence-required, and the same-domain exec naturally keeps
# the operation category. Live enforcing AVC evidence (Phase 4C-2 run
# 36626399836, launch-window record 402: denied { execute }
# comm="rootlesskit" name="nsenter" tcontext=system_u:object_r:bin_t:s0
# tclass=file permissive=0) — the direct userspace failure in the same
# window: "failed to setup network ...: setting up tap tap0: executing
# [[nsenter -t 2845 -n -m -U --preserve-credentials ip tuntap add name
# tap0 mode tap] [nsenter -t 2845 -n -m -U --preserve-credentials ip
# link set tap0 up]]: exec: \"nsenter\": executable file not found in
# $PATH". map follows the proven entry-grant loader shape. Every OTHER
# executable the flow runs stays a separate live boundary with no grant
# here (ip received its own same-domain grant below, the 4C-5 live
# boundary, over the distro's ifconfig_exec_t identity); no generic bin_t
# execution, no bin_t execute_no_trans, and no separate nsenter domain
# (no type_transition, no entrypoint).
allow docker_helper_rootlesskit_t docker_helper_nsenter_exec_t:file { execute read open execute_no_trans getattr map };

# The flow's network-setup executable: after the mount-namespace
# reassociation the same nsenter invocation execs the distro ip binary to
# create and bring up the tap device inside the flow's namespaces. The
# distro already labels /usr/sbin/ip with its own executable identity —
# ifconfig_exec_t (the sysnetwork module's shared network-tool exec type;
# the 4C-4 stand probe + live 4C-5 AVC named it) — so the distro-owned
# type is USED, no custom file type is added, and the shipped .fc carries
# NO delta for it: relabeling a standard system binary with a private
# type would globally replace distro policy semantics for that inode.
#
# Execution model (4C-6): SAME-DOMAIN execute_no_trans, exactly the
# accepted nsenter shape — the executable stays in the already categorized
# caller domain (rootlesskit_t:s0:c*), never transitioning into the
# distro's ifconfig_t administration domain. ifconfig_t is a broad
# generic administration domain (pre-existing capability/netlink/tun/
# sysctl/BPF surface); importing it as this flow's privilege owner would
# grant authority no live evidence requires. The flow keeps using its own
# namespace/capability authority; additional kernel/network powers stay
# absent until separately granted by live evidence. Accordingly there is
# deliberately NO type_transition, no ifconfig_t:process transition grant,
# no entrypoint, no role addition, and no range_transition for ifconfig_t
# anywhere in this module.
#
# The type is NOT unique to ip: distro policy maps the shared
# ifconfig_exec_t to the standard networking utilities it owns (ifconfig,
# ethtool, iw, tc, and siblings). Recorded as the executable-identity
# scope: the grant authorizes same-domain execution of that distro type
# from the categorized flow domain only — it does NOT claim path-level
# exclusivity and grants no network authority.
#
# Live enforcing AVC evidence (Phase 4C-5 run 36693180238, launch-window
# records 401/402: denied { execute } for pid=2909 comm="nsenter"
# name="ip" tcontext=system_u:object_r:ifconfig_exec_t:s0 tclass=file
# permissive=0, twice in one window — the two nsenter invocations of the
# tap setup pair) with the direct userspace failure "nsenter: failed to
# execute ip: Permission denied", rootlesskit's "failed to setup network
# ... setting up tap tap0: executing [[nsenter -t 2882 ... ip tuntap add
# name tap0 mode tap] ...]: exit status 126", the child EOF, and the
# instance death — the direct causal chain to the 4C-5 flow death, one
# stage after the composite setns completed. read/open/getattr/map follow
# the proven same-domain loader shape (the nsenter entry grant); no
# ioctl/lock (no evidence; the distro can_exec() macro's generic
# expansion carries them — deliberately not used).
allow docker_helper_rootlesskit_t ifconfig_exec_t:file { execute read open execute_no_trans getattr map };

# The flow's TUN device node access (P5-S2 Phase 4C-11): the executed
# distro ip's `tuntap add` path (do_iptuntap() -> tap_add_ioctl()) opens
# the global distro device node /dev/net/tun with open(O_RDWR) as the
# first step of creating the flow's tap0 device, before any TUNSETIFF/
# TUNSETPERSIST ioctl.
#
# The distro already labels /dev/net/tun with its own device identity —
# tun_tap_device_t (the kernel module's shared TUN/TAP device type; the
# 4C-10 stand probe + live 4C-10 AVC named it) — so the distro-owned
# type is USED, no custom file type is added, and the shipped .fc
# carries NO delta for it: relabeling the global device node with a
# private type would globally replace distro policy semantics for that
# inode. The node itself does not carry per-operation MCS categories;
# operation isolation stays owned by the categorized flow process, the
# user namespace, the network namespace, and the subsequent
# capability/kernel checks (part of the required c1-vs-c2 proof).
#
# Live enforcing AVC evidence (Phase 4C-10 run 36706718459,
# launch-window record 402: denied { read write } for pid=2961 comm="ip"
# name="tun" dev="devtmpfs" tcontext=system_u:object_r:tun_tap_device_t:s0
# tclass=chr_file permissive=0) with the direct userspace failure
# "open: Permission denied", rootlesskit's "failed to setup network ...
# setting up tap tap0: ... exit status 1", the child EOF, and the
# instance death — the direct causal chain to the 4C-10 flow death, one
# stage after the full rtnl_open_byproto() completed. The observed
# access vector { read write } is treated as ONE causal unit — the exact
# open(O_RDWR) step — not artificially split into separate read/write
# phases. Phase 4C-11 (run 36711330835, launch-window record 401:
# denied { open } for pid=2981 comm="ip" path="/dev/net/tun" same
# tcontext/tclass) then proved the SECOND selinux hook of the SAME
# open(O_RDWR) syscall — selinux_file_open() -> open_file_to_av() checks
# `open` after selinux_inode_permission() passed the { read write }
# stage — with the same userspace failure; the two runs' AVCs are the
# two sequential hooks of one causal syscall, and `open` completes the
# evidenced open() chain here.
#
# SCOPE — READ CAREFULLY: this grant covers the TUN/TAP device-node
# open(O_RDWR) chain and the ONE evidenced ioctl command for the flow's
# own tap creation — NOTHING more. Deliberately NOT granted:
# getattr/append/lock/create/setattr (each requires its own enforcing
# evidence; if the effective base policy separately provides getattr
# that is a loaded-policy fact, not a reason to copy it here). NO plain
# capability surface either: self:capability net_admin/net_raw stay
# ungranted, and cap_userns net_admin is NOT granted by any TUN rule —
# the TUN driver's ns_capable(net->user_ns, CAP_NET_ADMIN) check inside
# tun_set_iff() is carried by the child domain's OWN cap_userns rule
# below (its 4C-15 evidenced net_admin bit); the initial-userns plain
# capability set stays zero. The distro corenet_rw_tun_tap_dev() macro
# remains deliberately NOT used: its rw_chr_file_perms expansion
# carries getattr/append/ioctl/lock — beyond the observed chain — and
# a macro expansion carries NO allowxperm, so importing it would make
# the flow's ioctl authority UNRESTRICTED at the exact command
# boundary this policy pins. Like every flow-domain grant this is a
# domain-wide permission on the distro device TYPE (not path-exclusive
# — tun_tap_device_t is a distro device type), not an operation-scoped
# one; the operation separation is owned by the categorized
# process/object MCS boundary, and cross-operation namespace targeting
# stays an open concurrency/security gate before the Release GO.
#
# ioctl (P5-S2 Phase 4C-14 + 4C-17): the flow's tap creation issues its
# first chr_file ioctl immediately after the proven open(O_RDWR) chain —
# the canonical 4C-13 enforcing run (36731429729, PASS) terminated at the
# exact boundary denied { ioctl } comm="ip" path="/dev/net/tun"
# ioctlcmd=0x54ca
# tcontext=system_u:object_r:tun_tap_device_t:s0 tclass=chr_file
# permissive=0, with the direct userspace failure "ioctl(TUNSETIFF):
# Permission denied". 0x54ca IS TUNSETIFF, the create-the-interface
# command of the TUN UAPI. chr_file ioctl is mediated as a SELinux
# EXTENDED permission (kernel 4.4+): the ordinary `ioctl` bit and the
# allowxperm bitmap are ONE authority unit — an ordinary ioctl bit
# with NO allowxperm for the tuple is UNRESTRICTED command authority
# (the all-or-nothing grant this policy must never create), and an
# allowxperm bitmap without the ordinary bit is not class-level
# permission. The grant is therefore exactly TWO lines below — one
# ordinary rule carrying { read write open ioctl } and one allowxperm
# rule carrying the exact evidenced command set.
#
# The SECOND command (P5-S2 Phase 4C-17): after the whole 4C-16 chain
# (ioctl+xperm 0x54ca → cap_userns net_admin → tun_socket create)
# completed, the canonical 4C-16 enforcing run (36758547073, PASS)
# stopped at the next boundary — audit record 421: denied { ioctl }
# for pid=3059 comm="ip" path="/dev/net/tun" ioctlcmd=0x54cb
# tcontext=system_u:object_r:tun_tap_device_t:s0 tclass=chr_file
# permissive=0, with the direct userspace failure "ioctl(TUNSETPERSIST):
# Permission denied". 0x54cb IS TUNSETPERSIST, the
# mark-the-device-persistent command iproute2's tap_add_ioctl() issues
# unconditionally right after a successful TUNSETIFF when no owner/
# group was given (the persisted device is what keeps the tap0 the
# buildkitd payload reattaches to). The xperm whitelist becomes exactly
# { 0x54ca 0x54cb } — both live-proven create-the-tap commands — no
# range (0x5400-0x54ff and 0x54ca-0x54cc stay closed), no complement
# (~{ 0x54ca 0x54cb } stays closed), no third command: TUNSETOWNER/
# TUNSETGROUP (the current invocation passes no user/group), TUNSETLINK/
# TUNGETFEATURES/TUNSETOFFLOAD/TUNSETQUEUE and every other chr_file
# ioctl command stay denied, each requiring its own live evidence. The
# EFFECTIVE loaded-policy xperm union for this tuple must be exactly
# { 0x54ca 0x54cb }: base-policy and attribute-derived allowxperm
# contributions count toward the effective verdict, and the enforcing
# harness proves the union with a sesearch allowxperm inventory — an
# extra effective command there is a STOP, not a silent accept.
allow docker_helper_rootlesskit_t tun_tap_device_t:chr_file { read write open ioctl };
allowxperm docker_helper_rootlesskit_t tun_tap_device_t:chr_file ioctl { 0x54ca 0x54cb };

# The flow's NETLINK_ROUTE socket creation + socket-option operations +
# local bind (P5-S2 Phases 4C-7/4C-8/4C-9): the first kernel actions of
# the executed ip — iproute2's rtnl_open_byproto() opens with
# socket(AF_NETLINK, SOCK_RAW|SOCK_CLOEXEC, NETLINK_ROUTE), sets the
# mandatory socket options (SO_SNDBUF, SO_RCVBUF, NETLINK_EXT_ACK via
# setsockopt), and binds the socket — all BEFORE any route-message work.
# Live enforcing AVC evidence, each permission from its own run:
#
#   - create (Phase 4C-6 run 36698129661, launch-window record 400:
#     denied { create } for pid=2936 comm="ip" self->self
#     tclass=netlink_route_socket permissive=0) with the direct userspace
#     failure "Cannot open netlink socket: Permission denied" and
#     rootlesskit's "failed to setup network ... exit status 1" — the
#     direct causal chain to the 4C-6 flow death.
#   - setopt (Phase 4C-7 run 36700397131, launch-window record 402:
#     denied { setopt } for pid=2958 comm="ip" self->self
#     tclass=netlink_route_socket permissive=0) with the direct userspace
#     failure "SO_SNDBUF: Permission denied" — the mandatory first
#     setsockopt() after the (now granted) socket creation — and
#     rootlesskit's "failed to setup network ... exit status 1": the
#     direct causal chain to the 4C-7 flow death.
#   - bind (Phase 4C-8 run 36702978808, launch-window record 401:
#     denied { bind } for pid=2957 comm="ip" self->self
#     tclass=netlink_route_socket permissive=0) with the direct userspace
#     failure "Cannot bind netlink socket: Permission denied" — the
#     bind() after the (now granted) setopt sequence — and rootlesskit's
#     "failed to setup network ... exit status 1": the direct causal
#     chain to the 4C-8 flow death.
#   - getattr (Phase 4C-9 run 36704966682, launch-window record 403:
#     denied { getattr } for pid=2968 comm="ip" self->self
#     tclass=netlink_route_socket permissive=0) with the direct userspace
#     failure "Cannot getsockname: Permission denied" — the getsockname()
#     after the (now granted) bind — and rootlesskit's "failed to setup
#     network ... exit status 1": the direct causal chain to the 4C-9
#     flow death. (selinux_socket_getsockname() → SOCKET__GETATTR.)
#   - write (Phase 4C-19; the boundary was proven DIAGNOSTICALLY in the
#     4C-18 dontaudit-disabled runs 36768085402/36769407676/36770193250:
#     the second command `ip link set tap0 up` opened TWO AF_NETLINK
#     SOCK_RAW|SOCK_CLOEXEC NETLINK_ROUTE sockets successfully (fd 3 and
#     fd 4 — the lookup path's own handle), and its FIRST sendmsg —
#     the initial interface-name lookup request inside
#     ll_name_to_index("tap0")/ll_link_get() — failed with EACCES
#     (audit record 1334: denied { write } for pid=3098 comm="ip"
#     self->self tclass=netlink_route_socket permissive=0, syscall 46
#     sendmsg a0=4, diagnostic run 36770193250). In the canonical
#     production-audit run 36764741309 this denial NEVER APPEARED: the
#     distro base policy's domain-wide catch-all
#     `dontaudit domain domain:netlink_route_socket { read write };`
#     suppresses exactly this check from audit. The denial is hidden by
#     audit, not absent by allow — it is the generic socket-write check
#     on the message send, which occurs BEFORE any message-specific
#     Netlink mediation. The userspace consequences (the libc
#     name-resolution fallback chain of AF_UNIX/AF_INET/AF_INET6
#     SOCK_DGRAM creations, all denied) are fallback effects of this
#     failure and deliberately receive NO grants.
#   - nlmsg_read (Phase 4C-20; the boundary surfaced in the canonical
#     4C-19 run 36772822101, audit record 1306: denied { nlmsg_read } for
#     pid=3087 comm="ip" self->self tclass=netlink_route_socket
#     permissive=0 — VISIBLE in the canonical window because the distro
#     base policy's generic `dontaudit domain domain:netlink_route_socket
#     { read write };` catch-all covers only the read/write pair, not the
#     message-class checks; the same denial re-appeared in the -DB
#     companion window as record 31687). With the generic write granted,
#     the sendmsg of the initial RTM_GETLINK-class interface-name lookup
#     inside ll_name_to_index("tap0")/ll_link_get() passed the socket
#     write check and failed the message-class mediation instead: the
#     kernel's Netlink send path classifies the message by type and
#     requires the matching nlmsg permission. The live policycap state is
#     NETLINK_XPERM = disabled (the legacy permission model; no
#     extended-permission form applies).
#   - read (Phase 4C-21; the boundary was exposed by the mandatory -DB
#     companion window of the canonical 4C-20 run 36823922085, audit
#     record 32519: denied { read } for pid=3451 comm="ip" self->self
#     tclass=netlink_route_socket permissive=0 — HIDDEN in the canonical
#     window by the distro base policy's domain-wide catch-all
#     `dontaudit domain domain:netlink_route_socket { read write };`,
#     exactly as the 4C-19 write boundary was). With write and nlmsg_read
#     granted, the lookup's sendmsg succeeded (syscall 46, fd 4,
#     exit=52 — the RTM_GETLINK-class request reached the kernel) and the
#     failure moved to the receive side: recvmsg(fd 4) returned EACCES
#     (syscall 47, exit=-13, twice) because the kernel's reply path
#     checks the generic socket read permission separately
#     (recvmsg → security_socket_recvmsg → selinux_socket_recvmsg →
#     sock_has_perm(SOCKET__READ)); the userspace tail moved to
#     "netlink receive error Permission denied (13)" + "Cannot find
#     device tap0". The libc fallback datagram creations remained
#     fallback-only effects and receive NO grants.
#   - nlmsg_write (Phase 4C-22; the boundary surfaced in the canonical
#     4C-21 run 36828609086, audit record 1230: denied { nlmsg_write }
#     for pid=3094 comm="ip" self->self tclass=netlink_route_socket
#     permissive=0, on the SECOND sendmsg of `ip link set tap0 up` —
#     fd 3, the main rtnl handle — after the fd-4 lookup completed
#     (sendmsg(fd 4) exit=52 success; recvmsg(fd 4) exit=44 success
#     twice; the "Cannot find device tap0" message gone; the libc
#     fallback datagram chain absent). Placement identifies the request
#     as the RTM_NEWLINK-class mutation of `iplink_modify()`. The same
#     denial re-appeared in the run's -DB companion window (record
#     31606, pid 3410). The message-class check is audible canonically
#     (the distro dontaudit catch-all covers only the read/write pair).
#
# SCOPE OF nlmsg_write — RECORD ACCURATELY: with the live policycap
# state NETLINK_XPERM = disabled, nlmsg_write is a LEGACY CLASS-LEVEL
# Netlink permission. It authorizes the kernel's write-class NETLINK_ROUTE
# messages as a class — NOT a single exact nlmsg_type. The live
# enforcing evidence justifying the grant is specifically the
# RTM_NEWLINK-placement mutation that `ip link set tap0 up` requires
# (the TAP link-state set in the flow's own namespace), but the grant
# itself has broader message-class scope: ANY write-class route
# message sent from this domain's own sockets in reachable namespaces
# is authorized by it. This asymmetry between the evidenced operation
# and the granted scope is exactly why the cross-operation c1-vs-c2
# gate stays mandatory before any Release GO.
#
# SCOPE — READ CAREFULLY: these grants cover socket instantiation,
# socket-option operations, the LOCAL BIND, socket metadata query
# (getsockname), the GENERIC SEND side, the LOOKUP-CLASS message check,
# the GENERIC RECEIVE side, and the MUTATION-CLASS message check of the
# flow's own NETLINK_ROUTE sockets in the current namespaces — NOTHING
# more. Still closed on this class: connect/getopt, ioctl/shutdown, any
# second/parallel rule, and NO capability surface HERE
# (self:capability net_admin/net_raw stay ungranted; the child's
# in-namespace cap_userns surface — including the 4C-15 net_admin bit —
# lives in the child's own cap_userns rule, never in a netlink rule;
# the AVCs of these boundaries name only the socket class). NOTE: SO_SNDBUF,
# SO_RCVBUF, and NETLINK_EXT_ACK are all mediated by the ONE class-level
# `setopt` permission — the grant covers every socket-option operation
# of this domain/class pair; it is deliberately NOT described as
# "SO_SNDBUF-only". The send/receive/lookup/mutation permissions
# together complete the evidenced NETLINK_ROUTE socket chain for the
# flow's own route sockets; each permission remains traceable to its
# own live boundary (they are deliberately NOT collapsed into a
# generic "the flow needs Netlink access" rationale). The route
# mutation authority is class-level (see the nlmsg_write scope note
# above), and the cross-operation c1-vs-c2 gate stays mandatory before
# any Release GO. Like every flow-domain grant this is a
# domain-wide SELF permission, not an operation-scoped one; the
# operation separation is owned by the categorized process/object MCS
# boundary, and cross-operation namespace targeting stays an open
# concurrency/security gate before the Release GO.
allow docker_helper_rootlesskit_t self:netlink_route_socket { create setopt bind getattr write nlmsg_read read nlmsg_write };

# Root mount-propagation mounton (P5-S2 Phase 4C-39): the rootlesskit
# child's mount-namespace setup issues mount("none", "/", ..., MS_REC|
# MS_SLAVE) right after its network driver reports completion —
# rootlesskit's "share mount point: /" step. Live enforcing boundary,
# canonical 4C-38 run 37063277489, record at trace-ts 276.470125:
# requested=0x10000 denied=0x10000 audited=0x10000 result=-13 (EACCES)
# for scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
# tcontext=system_u:object_r:root_t:s0 tclass=dir, 39µs before the
# holder's exit(1); the harness's post-TUN causal proof named this
# record the primary boundary (NO other SELinux decision preceded the
# failing exit), and rootlesskit's own stderr carries the direct
# failure "[rootlesskit:child ] error: failed to share mount point: /:
# permission denied". The symbolic decode is the system's own
# selinuxfs numeric value: /sys/fs/selinux/class/dir/perms/mounton
# carries the bit index whose mask is 0x10000 (the 4C-38 relabelto
# reading was a decode-from-listing-order error — dir:relabelto is
# 0x100 — corrected by the numeric decoder). The grant is exactly ONE
# permission on the one evidenced tuple: no relabelto (the misread must
# never become policy), no mount/remount, no setattr/write/create/
# search or any other dir permission, no filesystem-class grant, no
# second rule, no other subject.
allow docker_helper_rootlesskit_t root_t:dir mounton;

# The copy-up /tmp directory write (P5-S2 Phase 4C-40) and the mkdir
# name mediation of the same mkdir(2) (P5-S2 Phase 4C-41): the child's
# copy-up setup — rootlesskit's bind0/bind1 directory creation under
# /tmp — issues os.MkdirTemp("/tmp", "rootlesskit-b*") and the mkdir(2)
# on the /tmp parent is mediated by TWO dir permissions, each added
# from its own live enforcing boundary.
#
#   write (4C-40): live enforcing boundary, canonical 4C-39 run
#     37101080574, trace-ts 274.305359 (T0 = the helper's granted
#     TUNSETIFF attach at trace-ts 274.301943; 62µs before the holder's
#     exit(1) at trace-ts 274.305421):
#       requested=0x20000004 denied=0x4 audited=0x4 result=-13 (EACCES)
#       scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#       tcontext=system_u:object_r:tmp_t:s0 tclass=dir
#     with the direct userspace failure "[rootlesskit:child ] error:
#     creating bind0 directory under /tmp". The decode is the kernel's
#     own static classmap (dir:write = 0x4, bit 2 of
#     COMMON_FILE_SOCK_PERMS; the 4C-39 decoder rework): the SAME
#     record's requested mask carries 0x20000000 (dir:search) NOT
#     denied — search PASSED on the base policy's standing surface and
#     must NOT be interpreted as a grant mandate for this module. The
#     audit slice was empty in the canonical window (the measured
#     userspace-audit gap), so the boundary is named by the raw kernel
#     decision plus the holder's own stderr.
#
#   add_name (4C-41): with write granted, the canonical 4C-40 run
#     37104707444 moved the failure to the mkdir's NEXT SELinux hook —
#     the same sys_mkdirat window, trace-ts 278.170941 (42µs before the
#     holder's exit(1) at trace-ts 278.170983; T0 = the attach at
#     trace-ts 278.168733):
#       requested=0x24000000 denied=0x4000000 audited=0x4000000
#       result=-13 (EACCES)
#       scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#       tcontext=system_u:object_r:tmp_t:s0 tclass=dir
#     inside sys_mkdirat(dfd=AT_FDCWD, pathname=
#     "/tmp/rootlesskit-b1515496009", mode=0x1c0=0700) — the direct
#     userspace failure is again "[rootlesskit:child ] error: creating
#     bind0 directory under /tmp". The decode is the kernel's own
#     static classmap (dir:add_name = 0x4000000, bit 26; dir:search =
#     0x20000000, bit 29 — the same record's requested mask names the
#     standing search that PASSED): a mkdir(2)'s name-creation
#     mediation, the exact next check after the granted write. The
#     audit slice was empty in that window too (the same
#     userspace-audit gap); the raw kernel decision plus the path-shape
#     consistency name the boundary (the perms-file numbering would
#     claim 1<<26 for "watch_reads" — inotify family, impossible on a
#     mkdir path), and a next symbolic AVC record, when captured, is
#     the confirming decode.
#
#   create (4C-42): with write+add_name granted, the canonical 4C-41
#     run 37107847258 moved the failure to the mkdir's object-creation
#     hook — the same sys_mkdirat window, trace-ts 223.832943 (74µs
#     before the holder's exit(1) at trace-ts 223.833032; T0 = the
#     attach at trace-ts 223.832147):
#       requested=0x8 denied=0x8 audited=0x8 result=-13 (EACCES)
#       scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#       tcontext=system_u:object_r:tmp_t:s0 tclass=dir
#     inside sys_mkdirat(dfd=AT_FDCWD, pathname=
#     "/tmp/rootlesskit-b3151144429", mode=0x1c0=0700). The target
#     type is LIVE-PROVEN as tmp_t (the create hook checked the new
#     dir against tmp_t:s0 — the inherited parent label; no type
#     transition was observed). The decode is the kernel's own static
#     classmap (dir:create = 0x8, bit 3 of COMMON_FILE_SOCK_PERMS) —
#     the object-creation permission of may_create()'s
#     avc_has_perm(sid, NEWSID, DIR__CREATE). The audit slice was
#     empty in that window too (the same userspace-audit gap); a next
#     symbolic AVC record, when captured, is the confirming decode.
#
#   mounton (4C-43): with the trio granted, the canonical 4C-42 run
#     37109745209 saw mkdirat SUCCEED (sys_mkdirat("/tmp/rootlesskit-
#     b145856764", 0700) -> 0x0 — the ROOTLESSKIT-BIND0-CREATE
#     milestone; the residue probe confirmed the created dir's real
#     SID system_u:object_r:tmp_t:s0, mode drwx------) and moved the
#     failure to the copy-up BIND MOUNT:
#       sys_mount(dev_name: "/etc", dir_name:
#       "/tmp/rootlesskit-b145856764", type: "", flags: 0x5000
#       MS_BIND|MS_REC, data: 0) -> 0xfffffffffffffff3
#     with the denial INSIDE the mount(2) window, trace-ts 277.042370
#     (175µs before the holder's exit(1) at trace-ts 277.042545; T0 =
#     the attach at trace-ts 277.037740):
#       requested=0x10000 denied=0x10000 audited=0x10000 result=-13
#       (EACCES)
#       scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#       tcontext=system_u:object_r:tmp_t:s0 tclass=dir
#     The decode is dir:mounton = 0x10000 (bit 16 of the kernel's
#     static classmap — the SAME bit position the 4C-38 root_t
#     boundary proved, but on the NEW tmp_t pair, which needs its own
#     live evidence and its own grant). The audit slice was empty in
#     that window too (the same userspace-audit gap). The failed
#     launch's RemoveAll noise (tmp_t:dir remove_name, tmp_t:dir read)
#     sits AFTER the failing mount — classified POST-FAILURE/CLEANUP,
#     never granted.
#
# SCOPE — READ CAREFULLY: exactly FOUR permissions of the dir class —
# the write, add_name, create, and mounton checks of the ONE copy-up
# path rootlesskit runs on /tmp (the MkdirTemp mkdir(2) and the bind
# mount onto the created temp dir); each permission is traceable to
# its own run's boundary above. Deliberately NOT granted:
# remove_name/read/rmdir (the failed launches' RemoveAll cleanup
# surface — the manager purge owns removal; the residue dir is a
# policy-observable fact, not cleanup authority), setattr, rename,
# and every other dir permission; NO tmp_t file/lnk_file/sock_file/
# fifo_file surface (the bind mounts' inner objects materialize
# later, each its own boundary); NO filesystem-class grant and NO
# permission toward the NEXT stage (the tmpfs mount over the
# copy-up source and the .ro/MS_MOVE/scan steps — each is a live
# boundary of its own); no process/capability surface; no other
# subject; the lifecycle signal surface stays closed (the
# post-failure cleanup kill follows the holder's exit — never
# precedes it). Like every flow-domain grant this is a domain-wide
# permission on the distro /tmp type (no .fc delta: the distro
# labels /tmp with its own tmp_t), not an operation-scoped one; the
# operation separation is owned by the categorized process/object
# MCS boundary, and cross-operation targeting stays the open
# concurrency/security gate before the Release GO.
allow docker_helper_rootlesskit_t tmp_t:dir { write add_name create mounton };

# The copy-up tmpfs mount's target mounton (P5-S2 Phase 4C-44): with the
# tmp copy-up quartet granted (4C-43), the canonical 4C-43 run
# 37143508859 saw the copy-up BIND MOUNT succeed
# (sys_mount("/etc", "/tmp/rootlesskit-b396561303", MS_BIND|MS_REC) ->
# 0x0 — the ROOTLESSKIT-BIND0-BIND-MOUNT milestone) and moved the
# failure to the copy-up flow's NEXT stage — the tmpfs mount OVER the
# copy-up source directory:
#   sys_mount(dev_name: "none", dir_name: "/etc", type: "tmpfs",
#   flags: 0, data: 0) -> 0xfffffffffffffff3
# with the denial INSIDE the mount(2) window, trace-ts 273.936981
# (21µs before the first failing syscall exit at trace-ts 273.937002;
# T0 = the attach at trace-ts 273.934089, epoch 1791051689.047):
#   requested=0x10000 denied=0x10000 audited=0x10000 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:etc_t:s0 tclass=dir
#
# THE TARGET TYPE IS THE EVIDENCE — NOT AN ASSUMPTION: /etc on
# Tumbleweed is labeled etc_t (the distro's own /etc directory type) —
# NOT root_t (whose mounton the 4C-39 grant covers for the propagation
# mount "/") and NOT tmp_t (whose mounton the 4C-43 grant covers for
# the bind0 target). This is a NEW evidenced pair, granted here as its
# OWN rule — never folded into the root or tmp mounton rules; the
# three mounton targets stay three distinct evidenced pairs.
#
# The decode is dir:mounton = 0x10000 (bit 16 of the kernel's static
# classmap — the same bit position both prior mounton boundaries
# proved). The audit slice was empty in that window too (the same
# userspace-audit gap); a next symbolic AVC record, when captured, is
# the confirming decode.
#
# SCOPE — READ CAREFULLY: exactly ONE permission of the dir class on
# exactly this pair — the mounton check of the copy-up flow's tmpfs
# mount over /etc. Deliberately NOT granted: etc_t:dir
# write/add_name/create (the .ro directory creation INSIDE the tmpfs
# mount — the NEXT boundaries, whose target types materialize live),
# etc_t:dir read/remove_name/rmdir/setattr/rename (the scan/rebuild
# steps — each its own boundary), tmpfs_t:filesystem mount or any
# other filesystem-class permission (if the mount path next mediates
# the new superblock, that hook materializes live and owns its own
# phase — never auto-converted from a dir permission), every other
# etc_t permission, any new tmp_t/root_t grant, file/lnk_file/
# sock_file classes, process/capability surfaces, other subjects; the
# lifecycle signal surface stays closed (the post-failure cleanup
# kill follows the holder's exit — never precedes it). Like every
# flow-domain grant this is a domain-wide permission on the distro
# /etc directory type (no .fc delta: the distro labels /etc with its
# own etc_t), not an operation-scoped one; the operation separation
# is owned by the categorized process/object MCS boundary, and
# cross-operation targeting stays the open concurrency/security gate
# before the Release GO.
allow docker_helper_rootlesskit_t etc_t:dir mounton;

# The copy-up tmpfs superblock's filesystem mount (P5-S2 Phase 4C-45):
# with the etc_t:dir mounton granted (4C-44), the canonical 4C-44 run
# 37145319964 saw the C request PASS the target-dir mounton stage and
# enter the superblock mediation — the failure moved to the NEW
# superblock's own filesystem-class check:
#   sys_mount(dev_name: "none", dir_name: "/etc", type: "tmpfs",
#   flags: 0, data: 0) -> 0xfffffffffffffff3
# with the denial INSIDE the mount(2) window, trace-ts 175.074992
# (14µs before the first failing syscall exit at trace-ts 175.075006;
# T0 = the attach at trace-ts 175.072792, epoch 1791053307.245):
#   requested=0x1 denied=0x1 audited=0x1 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=filesystem
#
# THE CLASS IS THE EVIDENCE — NOT A DIR PERMISSION: the deny is the
# FILESYSTEM class's mount permission (bit 0 of the kernel's static
# classmap — the may_mount()/sb creation mediation of the NEW tmpfs
# superblock), checked on the superblock's OWN type tmpfs_t. This is
# the class change the copy-up stage map predicted; it is granted as
# its OWN filesystem-class rule and is never folded into a dir
# mounton rule.
#
# SCOPE NOTE — THIS IS A GLOBAL-TYPE GRANT, RECORD IT AS SUCH:
# tmpfs_t:s0 is a GLOBAL filesystem label with no per-operation MCS
# category, so this allow is NOT operation-scoped: the flow domain
# may mount NEW tmpfs filesystems anywhere kernel/DAC/namespace
# capability relationships already permit. The security chain that
# gates abuse stays at the kernel capability layer (in-namespace
# CAP_SYS_ADMIN via cap_userns sys_admin) and the MCS-constrained
# subject; cross-operation reachability stays the OPEN
# concurrency/security gate before the Release GO (same scope shape
# as the nsfs_t read/open pair).
#
# The decode is filesystem:mount = 0x1 (bit 0). The audit slice was
# empty in that window too (the same userspace-audit gap); a next
# symbolic AVC record, when captured, is the confirming decode.
#
# Deliberately NOT granted: remount/unmount/getattr/associate/
# mounton/relabelfrom/relabelto on this pair (each a distinct
# filesystem hook), any second filesystem rule, any etc_t/tmp_t/root_t
# dir permission, any file/lnk_file class surface (the .ro creation
# and the scan/rebuild steps are the NEXT boundaries, whose target
# types materialize live — after the tmpfs mount the labels are NOT
# assumed to be etc_t/tmp_t), process/capability surfaces, other
# subjects; the lifecycle signal surface stays closed. The .fc and
# the module version stay untouched.
allow docker_helper_rootlesskit_t tmpfs_t:filesystem mount;

# The copy-up `.ro` directory creation (P5-S2 Phase 4C-46): with the
# tmpfs_t:filesystem mount granted (4C-45), the canonical 4C-45 run
# 37147831964 saw the copy-up chain pass A (propagation -> 0x0), the
# bind0 mkdirat (-> 0x0), B (bind mount -> 0x0) AND the C tmpfs mount
# (-> 0x0, with ZERO filesystem-class AVCs — the 4C-45 grant took
# effect directly) and reach the FIRST post-mount production step:
#   sys_mkdirat(dfd: AT_FDCWD, pathname: "/etc/.ro1295760542", mode: 0700)
#   -> 0xfffffffffffffff3
# with the denial INSIDE the mkdirat(2) window, trace-ts 267.671243
# (25µs before the first failing syscall exit at trace-ts 267.671268;
# T0 = the attach at trace-ts 267.668098):
#   requested=0x8 denied=0x8 audited=0x8 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=dir
#
# THE TARGET IS THE LIVE-PROVEN PAIR — NOT ASSUMED: the `.ro` child's
# SID is inherited from the tmpfs root's own label tmpfs_t:s0 (the
# kernel's own tcontext), exactly the materialized-labes-not-assumed
# rule. THE CLASS IS THE EVIDENCE — a DIR permission: mask 0x8 on dir
# is create (bit 3 of the kernel's static classmap — the
# may_create()/dir-create mediation of the NEW child dir), granted as
# its OWN dir-class rule and NEVER folded into the tmpfs_t:filesystem
# mount rule (a different class, a different hook, a different
# provenance).
#
# NOTE — THE PARENT-CHECK SIDE IS ALREADY STANDING: the base policy's
# attribute surface grants docker_helper_rootlesskit_t tmpfs_t:dir
# { add_name remove_name write ... } (the 4C-45 preflight inventory's
# recorded standing residual); only the child-label create check was
# denied. This rule adds exactly that missing create — it does NOT
# duplicate or copy the base policy's standing dir authority into this
# module.
#
# SCOPE NOTE — GLOBAL TYPE, NOT OPERATION-SCOPED: tmpfs_t:s0 carries no
# per-operation MCS category, so this allow is not operation-scoped
# (the nsfs_t/tmpfs-filesystem scope shape); the in-namespace
# capability layer and the MCS-constrained subject stay the abuse
# gates, and the cross-operation reachability gate stays OPEN.
#
# The decode is dir:create = 0x8 (bit 3). The audit slice was empty in
# that window too (the same userspace-audit gap); a next symbolic AVC
# record, when captured, is the confirming decode.
#
# 4C-47 WIDENS THIS RULE IN PLACE (+ mounton): with the create granted,
# the canonical 4C-46 run 37151310682 saw the .ro mkdirat SUCCEED
# (-> 0x0 — the 4C-46 grant took effect directly, zero tmpfs_t:dir
# create AVCs) and the FIRST next production step — the move-mount of
# the bind0 original tree onto the fresh .ro dir — fail at ITS OWN
# target-dir mediation:
#   sys_mount(dev_name: "/tmp/rootlesskit-b806505358",
#   dir_name: "/etc/.ro1982736738", type: "", flags: 0x2000 (MS_MOVE),
#   data: 0) -> 0xfffffffffffffff3
# with the denial INSIDE the mount(2) window, trace-ts 242.375018
# (25µs before the first failing syscall exit at trace-ts 242.375043;
# T0 = the attach at trace-ts 242.373493):
#   requested=0x10000 denied=0x10000 audited=0x10000 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=dir
#
# THE PERM IS THE LIVE-PROVEN PAIR — NOT ASSUMED: the move-mount's
# target-dir check names mounton (bit 16 of the kernel's static dir
# classmap — the same dir:mounton mediation the 4C-43/44 grants proved
# for tmp_t and etc_t, now on the MOVED-mount target's own label
# tmpfs_t). SAME PAIR (tmpfs_t:dir), different perm — the rule widens
# IN PLACE rather than a second rule/owner for one pair.
#
# Deliberately NOT granted: add_name/write/remove_name/rmdir/read/
# setattr/rename/relabel* on this pair (add_name/remove_name/write are
# already STANDING base-policy authority — this module must not copy
# them), any file/lnk_file/blk/chr surface of the tmpfs
# (the rebuild stages' target types materialize live), any second dir
# rule, any filesystem-class permission (the mount grant's own owner
# is 4C-45), process/capability surfaces, other subjects; the .fc and
# the module version stay untouched.
allow docker_helper_rootlesskit_t tmpfs_t:dir { create mounton };

# The rebuild symlink object's create, its link-traversal read, AND the
# production removal's unlink (P5-S2 Phase 4C-48 create; Phase 4C-50
# read; Phase 4C-53 unlink — ONE pair, ONE rule, widened IN PLACE per
# phase; the provenance stays per-perm):
#
#   create <- the canonical 4C-47 run 37153317223's evidence. With the
#   tmpfs_t:dir { create mounton } pair granted (4C-46/47), that run
#   saw the WHOLE copy-up mount stage chain pass — A (propagation ->
#   0x0), the bind0 mkdirat (-> 0x0), B (bind mount -> 0x0), C (tmpfs
#   mount -> 0x0), the .ro mkdirat (-> 0x0) AND the MS_MOVE move-mount
#   (-> 0x0, the 4C-47 grant took effect directly) — and reach the
#   REBUILD stage: ReadDir(bind1) succeeded (getdents64 -> 0xe68) and
#   the first entry's reconstruction failed at the symlink object's
#   own creation check:
#     sys_symlinkat(oldname: ".ro2286969802/.pwd.lock", newdfd:
#     AT_FDCWD, newname: "/etc/.pwd.lock") -> 0xfffffffffffffff3
#   with the denial INSIDE the symlinkat(2) window, trace-ts 278.310136
#   (16µs before the failing exit at trace-ts 278.310152; T0 = the
#   attach at trace-ts 278.307104):
#     requested=0x8 denied=0x8 audited=0x8 result=-13 (EACCES)
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:object_r:tmpfs_t:s0 tclass=lnk_file
#
#   read <- the canonical 4C-49 run's evidence (run 37191972618, the
#   anchor-own-denial machinery's record; reproduced across the 4C-49
#   gate and canonical runs). With the create granted, that run's
#   REBUILD stage completed ENTIRELY (the rebuilt /etc/hosts symlink,
#   oldname ".ro1194745973/hosts", at trace-ts 181.345115 -> 0x0, is
#   one of the stage's entries) and the flow advanced through the
#   cgroup-preservation move-mount to the startup's FIRST /etc read —
#   generateEtcHosts()'s os.ReadFile("/etc/hosts") — which failed at
#   the LINK TRAVERSAL's own read hook:
#     sys_openat(dfd: AT_FDCWD, filename: "/etc/hosts", flags:
#     O_RDONLY|O_CLOEXEC) -> 0xfffffffffffffff3
#   with the denial INSIDE the openat window, trace-ts 181.348602 (9µs
#   before the failing exit at trace-ts 181.348611; T0 = the attach at
#   trace-ts 181.341903):
#     requested=0x2 denied=0x2 audited=0x2 result=-13 (EACCES)
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:object_r:tmpfs_t:s0 tclass=lnk_file
#   the same pair/class/perm shape the flow's earlier /etc/localtime
#   openat hit at trace-ts 181.348187 (the log library's tz probe —
#   HANDLED/NON-TERMINAL there, the flow continued to the zoneinfo
#   openat and the warning), and the failure's own stderr named the
#   production operation ("[rootlesskit:child ] error: open
#   /etc/hosts: permission denied.") before exit_group(1).
#
#   unlink <- Phase 4C-53, the canonical 4C-52 run's terminal boundary
#   (the 4C-52 phase-end record NEXT-STARTUP-BOUNDARY:
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=lnk_file, denied
#   { unlink } — the classmap decode unlink = 0x800, bit 11 of the
#   kernel's static classmap's common layout). With the read/open pair
#   granted, the 4C-52 run's generateEtcHosts() read COMPLETED
#   (ROOTLESSKIT-ETC-HOSTS-READ=OK) and the flow advanced to the
#   setupNet resolv-replacement stage: RemoveAll("/etc/resolv.conf")
#   issues unlinkat("/etc/resolv.conf", 0) against the REBUILT
#   /etc/resolv.conf symlink on the fresh tmpfs — the DESTINATION
#   object's own symlink-removal hook, the SAME tmpfs_t:lnk_file pair
#   the create and read hooks own; the denial sat INSIDE the RemoveAll
#   stage's unlinkat window (the machinery's stage anchor — the
#   canonical 4C-52 corpus run 37307909383's terminal boundary, the
#   stage own retry windows openat("/etc") + dirfd-relative
#   unlinkat/readlinkat recorded around the SAME semantic operation).
#   The RemoveAll mini-sequence's own probes are ONE semantic
#   operation's syscall surface, never one phase per errno; the
#   grant-owning boundary is the unlinkat denial that blocks the
#   production RemoveAll's completion.
#
# THE TRIPLE IS LIVE-PROVEN — NOT ASSUMED: the symlink object's SID is
# inherited from the parent dir's own label tmpfs_t:s0 (the kernel's
# own tcontext), and the CLASS is the symlink object's own class
# lnk_file. THE DECODES are the kernel's static classmap's common
# positions, pinned in TestSELinuxPermissionKernelClassmapDecode:
# lnk_file:create = 0x8 (bit 3 — the same bit-3 position the dir:create
# and file:create decodes are pinned at), lnk_file:read = 0x2 (bit 1
# — the traversal hook the 4C-49 boundary carried) and lnk_file:unlink
# = 0x800 (bit 11 — the removal hook the 4C-53 widening carries; the
# map/link/rename neighbors 0x400/0x1000/0x2000 are pinned alongside
# for anti-shift; the kernel's own perms-file numbering would index
# read differently and stays the recorded interface fact, never the
# decode). The canonical 4C-47
# mechanical verdict was a KNOWN HARNESS MISCLASSIFICATION (the benign
# ENOENT housekeeping probe of the rootlesskit parent stole the causal
# anchor); the corrected 4C-48 machinery (the terminal-failure
# contract: a failure owns the primary boundary only when no forward
# production progress follows it) restores the STARTUP-CAUSAL owner —
# the anchor regression on the saved corpus is in the phase record,
# and the 4C-49 run's /etc/hosts boundary is the machinery's own
# anchor-own-denial proof (the recurring lnk shape must not steal the
# anchor own denial into POLLING-ONLY).
#
# THE PRECEDING PROBES ARE HANDLED/NON-TERMINAL, NOT PART OF THIS
# GRANT: the holder's unlinkat("/etc/.pwd.lock", 0) and
# unlinkat("/etc/.pwd.lock", AT_REMOVEDIR) ENOENT probes are the
# RemoveAll-destination cleanup probes RootlessKit issues BEFORE the
# symlink — ENOENT there is the EXPECTED outcome (the destination does
# not exist on the fresh tmpfs); no unlink/remove_name authority is
# granted for them, and the machinery classifies them
# HANDLED/NON-TERMINAL (they were followed by the symlinkat — forward
# production progress). THE RESOLV REMOVAL IS THE ONE EVIDENCED
# unlink EXCEPTION — the RemoveAll("/etc/resolv.conf") unlinkat's own
# destination hook (the paragraph above), NOT a cleanup probe: the
# destination EXISTS on the fresh tmpfs (the rebuilt symlink) and the
# denial blocked a PRODUCTION operation. The setupNet stages still
# beyond it (the RemoveAll("/etc/hosts") unlinks and the
# WriteFile/bind-mount steps) are PRODUCTION operations of the flow —
# never assumed cleanup noise — and their own hooks stay UNGRANTED;
# the live trace owns their classification.
#
# THE READ IS THE LINK-TRAVERSAL HOOK — NOT THE TARGET'S FILE ACCESS:
# the kernel mediates a FOLLOWED symlink with lnk_file:read; the
# RESOLVED target's own open/read (the original /etc file behind the
# rebuilt link, on the .ro mount's own labels) is a separate mediation
# on the target's own type/class and stays UNGRANTED — the next
# boundary, whatever the live trace proves it to be, is not this rule.
#
# SCOPE NOTE — GLOBAL TYPE, NOT OPERATION-SCOPED: tmpfs_t:s0 carries no
# per-operation MCS category, so this allow is not operation-scoped
# (the nsfs_t/tmpfs scope shape); the in-namespace capability layer and
# the MCS-constrained subject stay the abuse gates, and the
# cross-operation reachability gate stays OPEN.
#
# The audit slice was empty in the create/read windows (the same
# userspace-audit gap); the unlink window's audit-slice state is the
# 4C-52 run's own recorded evidence; a next symbolic AVC record, when
# captured, is the confirming decode.
#
# Deliberately NOT granted: write/getattr/setattr/link/rename/
# relabelfrom/relabelto or any other lnk_file permission (each a
# distinct hook — the link() stage's own link permission is NOT this
# create, and the setupNet replacement stages' write hooks stay
# ungranted), any dir/file/filesystem-class permission (the 4C-45/46/47
# owners), any OTHER type's lnk_file surface (the moved original
# tree's entries keep their own labels etc_t and friends — the
# rebuild's SOURCE reads go through the existing standing/flow surfaces
# and their own boundaries when reached), process/capability surfaces,
# other subjects; the .fc and the module version stay untouched.
allow docker_helper_rootlesskit_t tmpfs_t:lnk_file { create read unlink };

# The cgroup preservation move-mount (P5-S2 Phase 4C-49): with the whole
# copy-up/rebuild chain granted (4C-39..4C-48), the canonical 4C-48 run
# 37184659973 saw the flow's cgroup-preservation stage fail at ITS OWN
# target-dir mediation. The stage: the holder creates /tmp/rksys<random>,
# bind-mounts /sys/fs/cgroup onto it (MS_BIND|MS_REC -> 0x0) and then
# moves that bind onto the exact /sys/fs/cgroup mountpoint:
#   sys_mount(dev_name: "/tmp/rksys735648849",
#   dir_name: "/sys/fs/cgroup", type: "", flags: 0x2000 (MS_MOVE),
#   data: 0) -> 0xfffffffffffffff3
# with the denial INSIDE the mount(2) window, trace-ts 215.569241
# (12µs before the failing exit at trace-ts 215.569253; T0 = the attach
# at trace-ts 215.562308):
#   requested=0x10000 denied=0x10000 audited=0x10000 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:cgroup_t:s0 tclass=dir
# The flow's own stderr names the failure and the exit:
#   "[rootlesskit:child ] error: failed to move mount point from
#   /tmp/rksys... to /sys/fs/cgroup" -> exit_group(1).
#
# THE PERM IS THE LIVE-PROVEN PAIR — NOT ASSUMED: mounton = 0x10000
# (bit 16 of the kernel's static dir classmap — the same dir:mounton
# mediation the 4C-43/44/47 grants proved for tmp_t, etc_t and tmpfs_t,
# now on the move-mount target's own label cgroup_t). This is a NEW
# pair (a new global target type): it gets its OWN rule — never folded
# into the standing cgroup_t:dir { search } rule (the module's own
# P5-S1 cgroup2-root-walk contribution) or into any other mounton
# surface.
#
# THE PRE-GRANT CONFINEMENT GATE (the 4C-49 phase contract) PASSED LIVE
# before this rule was added — canonical gate run 37189443606, all
# seven items: (A) the holder's mount-namespace identity was observed
# live (the gate watcher's first-seen record, pid + starttime); (B)
# that mount namespace mnt:[4026532271] differs from every manager-side
# reference — the harness/init mnt:[4026531832] and the manager daemon
# + rootlesskit parent mnt:[4026532272] (the daemon itself holds its
# own mount namespace; three distinct values are involved); (C) the
# propagation mount mount("none", "/", MS_REC|MS_PRIVATE) -> 0x0
# belongs to the SAME trace pid that performs the cgroup move-mount;
# (D) the move attempt is trace-clock-after the propagation success;
# (E) the move's source /tmp/rksys* was bound FROM /sys/fs/cgroup by
# the same holder flow earlier (the MS_BIND|MS_REC pair -> 0x0); (F)
# the move's destination is exactly /sys/fs/cgroup; (G) the host-side
# mount table (init and the harness namespace) is untouched across the
# window (the before/after mountinfo diff is clean). The mount side
# effect of this authority is therefore confined by the production
# holder's own mount namespace and its recursive-private propagation
# state — NOT by the TE rule itself.
#
# PROVEN / NOT PROVEN (the phase contract's own formulation):
#   PROVEN: the production RootlessKit requires
#   docker_helper_rootlesskit_t -> cgroup_t:dir mounton for
#   namespace-local restoration of /sys/fs/cgroup.
#   NOT PROVEN: that the type-wide cgroup_t mounton authority is
#   cross-operation safe. SELinux authority remains type-wide for
#   cgroup_t; the cross-operation gate stays OPEN/Critical and the
#   Release GO stays CLOSED.
#
# Deliberately NOT granted: write/add_name/remove_name/create/rmdir/
# rename/setattr/relabelto/relabelfrom or any other dir permission on
# this pair (each a distinct hook; search/mounton are the only dir
# surfaces this module carries), any cgroup_t:file permission beyond
# the standing { read open } pair (the module's own P5-S1
# contribution), any cgroup_t:filesystem surface (mount/remount/
# unmount are distinct hooks), any sysfs_t permission (the tolerated
# sysfs mount attempts — RootlessKit warning-logs their failures and
# continues; the machinery classifies them HANDLED/NON-TERMINAL and
# they receive NO authority), any nsfs/setns/process/capability
# surface, other subjects; the .fc and the module version stay
# untouched; no require delta (cgroup_t is already required).
allow docker_helper_rootlesskit_t cgroup_t:dir mounton;

# The resolved /etc/hosts configuration-file read-open pair (P5-S2 Phase
# 4C-51 the read, widened IN PLACE by Phase 4C-52 with the open hook): the
# RESOLVED TARGET's own regular-file read after the 4C-50 link-traversal
# read passed. The chain: the rebuilt /etc/hosts symlink (tmpfs_t:lnk_file)
# traversal SUCCEEDED with the 4C-50 widening in place, and the SAME
# openat("/etc/hosts", O_RDONLY|O_CLOEXEC) advanced into the RESOLVED
# object's own file-class mediation, which denied the regular-file read:
#
#   denied { read } for pid=3793 comm="exe"
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:object_r:net_conf_t:s0 tclass=file
#
# Live enforcing evidence, canonical 4C-50 run 37264978329, the machinery's
# anchor-own record: the kernel decision INSIDE the openat window — the
# decision at trace-ts 279.786326 (13µs before the failing exit at
# 279.786339; T0 = the attach at trace-ts 279.762339, the attach executor's
# own TUNSETIFF -> 0x0):
#   requested=0x2 denied=0x2 audited=0x2 result=-13 (EACCES)
#   tcontext=system_u:object_r:net_conf_t:s0 tclass=file
# and the direct userspace failure at trace-ts 279.786346 ("[rootlesskit:
# child ] error: open /etc/hosts: permission denied.") followed by
# exit_group(1) at 279.786351 — the direct causal chain to the 4C-50 flow
# death, one stage after the link traversal's own hook passed. The same
# boundary was confirmed in three observations: the 4C-50 harness run
# 37263373116's canonical window (c1, exe-3796, trace-ts 181.091658, the
# machinery's STARTUP-CAUSAL owner record), this canonical run's own
# window (c1), and the canonical run's companion diagnostic window
# (dontaudit disabled, c2, exe-15530, trace-ts 379.143815).
#
# 4C-52 — THE OPEN HOOK (the same operation's second hook, the two-hook
# open structure the 4C-11/4C-32 boundaries proved for tun_tap_device_t
# and nsfs_t): with the read grant above in place, the canonical 4C-51
# run 37286690263's SAME openat("/etc/hosts", O_RDONLY|O_CLOEXEC)
# PASSED the read hook and the VFS open's own completion hook denied:
#
#   requested=0x40002 denied=0x40000 audited=0x40000 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:net_conf_t:s0 tclass=file
#
# at trace-ts 292.328103, -0.000s relative to the terminal failing
# production syscall exit (exe-3822 sys_openat -> 0xfffffffffffffff3 at
# trace-ts 292.328116; T0 = the attach at trace-ts 292.303852, the
# attach executor's own TUNSETIFF -> 0x0 at 292.304011). The read bit
# 0x2 sat INSIDE requested=0x40002 and NOT inside denied=0x40000 — the
# read hook passed, the open completion hook is the boundary; the open
# never returned an fd (the direct userspace failure
# "[rootlesskit:child ] error: open /etc/hosts: permission denied." at
# 292.328122 followed by exit_group(1) at 292.328126). Confirmed in the
# companion c2 window (dontaudit disabled, exe-15107, trace-ts
# 391.246530, the same shape). The resolved object's own label stays
# LIVE-PROVEN by the kernel's own tcontext, not a pathname inference.
#
# THE TARGET TYPE IS LIVE-PROVEN — NOT PATHNAME-INFERRED: net_conf_t is
# the kernel's OWN tcontext for the RESOLVED object (the AVC/decision
# record's tcontext, taken from the live decision — never from a pathname
# guess). The resolved object is the ORIGINAL /etc/hosts entry behind the
# rebuilt symlink (the rebuild symlinkat's own oldname ".ro<random>/hosts"
# — the moved original /etc tree on the .ro mount), and the kernel resolves
# it to the distro's /etc network-configuration file label net_conf_t
# (Tumbleweed labels /etc/hosts and /etc/resolv.conf net_conf_t; the live
# tcontext is the authority). The class is the evidence — the REGULAR-FILE
# class of the resolved object: tclass=file, NEVER the lnk_file class (the
# traversal's own hook, the 4C-50 pair's owner) and never a dir surface.
#
# THE DECODE is the kernel's static classmap's common layout: file:read =
# 0x2 (bit 1 of the COMMON_FILE_SOCK_PERMS positions — the same bit-1
# position the lnk_file read boundary carried; the perms files' own
# numbering, file read=2, is the recorded interface fact, never the
# decode). The audit slice was empty in all three windows (the measured
# userspace-audit gap); the raw kernel decision plus the holder's own
# stderr name the boundary, and a next symbolic AVC record, when captured,
# is the confirming decode.
#
# THE OPEN COMPLETION HOOK IS GRANTED HERE — IN PLACE (4C-52): the VFS
# open's completion mediates a separate { open } permission on the same
# file object; the open hook materialized live in the canonical 4C-51
# run (the paragraph above) and owns this widening. The provenance stays
# SEPARATE: read <- the 4C-50 evidence (the block above), open <- the
# 4C-51 evidence (this block) — one pair rule, two recorded hooks, never
# a standard read bundle (no getattr or any third hook). The pair's full
# completion (fd, bytes, EOF, close, the flow's continuation) is proven
# by the live run's own ROOTLESSKIT-ETC-HOSTS-READ milestone, not
# assumed here.
#
# SCOPE — READ CAREFULLY: exactly TWO permissions of the file class on
# exactly this pair — the resolved-target read (4C-50 evidence) and the
# resolved-target open completion (4C-51 evidence) of generateEtcHosts()'s
# os.ReadFile("/etc/hosts") (the same standing surface the daemon
# domain carries wider: allow docker_helper_t net_conf_t:file
# { read open getattr } — the child's pair is NOT a copy of that rule:
# exactly the two evidenced permissions, no getattr). Deliberately NOT
# granted: getattr/write/append/lock/create/setattr/unlink/rename/
# link/execute/map/relabelfrom/relabelto or any other file permission
# (each a distinct hook — the setupNet stages' own hooks materialize
# live), any net_conf_t:lnk_file or net_conf_t:dir surface (the class
# confusion), any other type's file surface, process/capability surfaces,
# other subjects; the .fc and the module version stay untouched; no
# require delta (net_conf_t is already required).
#
# GLOBAL-TYPE SCOPE NOTE — RECORD IT AS SUCH: net_conf_t:s0 is a GLOBAL
# distro label with no per-operation MCS category, so this allow is NOT
# operation-scoped: the flow domain may read and open the distro's /etc
# network-configuration regular files wherever kernel/DAC
# relationships already permit. Like every flow-domain grant this is a
# domain-wide permission on the distro type, not an operation-scoped one;
# the operation separation is owned by the categorized process/object MCS
# boundary, and cross-operation targeting stays the OPEN/Critical
# concurrency/security gate before the Release GO.
allow docker_helper_rootlesskit_t net_conf_t:file { read open };

# --- the replacement /etc/resolv.conf regular-file surface (P5-S2 Phase
# --- 4C-54, widened in place by Phase 4C-55): with the lnk_file unlink
# removal hook granted (4C-53), the canonical 4C-53 run 37350350345 saw
# the resolv-replacement stage's own RemoveAll complete — the rebuilt
# destination symlink actually removed (the AT_FDCWD
# unlinkat("/etc/resolv.conf", 0) pair ret 0x0 at trace-ts
# 234.517271..234.517283; the fresh run's FIRST pass was legitimately
# -ENOENT: RemoveAll's own contract makes "the path does not exist" a
# completed removal, so the multi-pass shape is the pass that actually
# removes an existing symlink — pairs total=2 removed=1 absent=1
# failed=0, no lnk_file unlink denial, ROOTLESSKIT-ETC-RESOLV-
# SYMLINK-REMOVE=OK) — and then reach the very next production step: the
# replacement file's own creation:
#   sys_openat(dfd: AT_FDCWD, filename: "/etc/resolv.conf",
#   flags: O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, mode: 0644)
#   enter trace-ts 234.517284, exit 234.517318
# with the denial INSIDE the openat(2) window, trace-ts 234.517307
# (11µs before the failing openat exit at 234.517318; T0 = the attach
# at trace-ts 234.476447, the failing exit at T0+0.041s; no later
# production progress — the flow's terminal failure):
#   requested=0x8 denied=0x8 audited=0x8 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=file
#
# THE DECODER CORRECTION (the 4C-53 deliverable's raw-mask decode,
# corrected per the kernel's own AVC numbering): the kernel's AVC bitmap
# for the file class follows COMMON_FILE_PERMS — ioctl=0x1 read=0x2
# write=0x4 create=0x8 getattr=0x10 setattr=0x20 ... open=0x40000
# (bit 18) ... — the same kernel-classmap order every live-proven
# association of this staircase uses (the lnk_file create=0x8 read=0x2
# unlink=0x800 link=0x1000 rename=0x2000 map=0x400; the net_conf_t:file
# open=0x40000 read=0x2; the dir mounton=0x10000 search=0x20000000
# add_name=0x4000000). The loaded policy's selinuxfs perms-file VALUES
# are the policy's own numbering (the distro policy's file class carries
# a swapon entry the kernel's file common does not) and are NEVER the
# AVC bitmap decoder. Raw 0x8 on tclass=file is therefore the file's own
# CREATE hook — the 4C-53 deliverable's raw {write} decode is corrected
# here; the granted permission is exactly create, not write.
#
# THE 4C-54 HOOK: security_inode_create — the vfs may_create() path of
# the O_CREAT openat on the MISSING replacement file inside the child
# namespace's tmpfs-backed /etc (the created inode inherits the parent
# dir's own type tmpfs_t). The parent-dir-side mediation (the
# tmpfs_t:dir search/write checks) ran BEFORE the create check and
# passed — the pre-grant run's own window record names the create denial
# as the window's FIRST decision (recorded standing fact, not assumed
# into the module: the dir surface stays the 4C-46/47 owner's exact
# pair).
#
# THE 4C-54 CANONICAL RUN (37370262779): the create grant crossed the
# create hook — the same openat(O_CREAT) window (enter trace-ts
# 186.870735, exit 186.870759, ret 0xfffffffffffffff3; one who,
# exe-24175, owned the whole resolv chain this run: the ENOENT absence
# pass at 186.852794, the ret-0x0 removal at 186.870726..186.870734)
# then reached the NEXT hooks of the SAME openat, and the kernel
# audited ONE combined decision, trace-ts 186.870752 (7µs before the
# failing openat exit; no fd was returned; the exit=1 at T0+0.020s was
# the flow's terminal failure — the ladder's STARTUP-CAUSAL row):
#   requested=0x40004 denied=0x40004 audited=0x40004 result=-13 (EACCES)
#   scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#   tcontext=system_u:object_r:tmpfs_t:s0 tclass=file
#
# ONE BOUNDARY, NOT TWO PHASES (the 4C-55 composition rule): write
# (0x4, bit 2) and open (0x40000, bit 18) were requested AND denied in
# the SAME audited decision inside ONE terminal openat, and neither had
# ever been granted — the decoded set is ONE evidenced boundary,
# { write open }, widened as one grant. No mechanical one-bit-per-phase
# split; no bit beyond the denied mask (read/getattr/setattr/... stay
# ungranted).
#
# THE 4C-55 HOOK ATTRIBUTION (corrected from the 4C-54 comment's
# prediction): the combined write|open decision comes from the
# open-completion hook — security_file_open → selinux_file_open requests
# FILE__OPEN (the open permission) together with the f_mode-derived
# access av (FMODE_WRITE → FILE__WRITE) in ONE check
# (open_file_to_av()). The may_open() inode-permission check does NOT
# produce this mask on the fresh-file path: the kernel's own do_open()
# strips O_TRUNC and zeroes acc_mode for FMODE_CREATED files ("Don't
# check for write permission, don't truncate"), so may_open()'s
# inode_permission runs with MAY_OPEN only and — selinux_inode_permission
# deriving no av from MAY_OPEN alone — performs no audit. After
# create+write+open are granted, the same openat therefore has NO
# further SELinux hook to deny on the fresh-file path: it returns
# fd >= 0. The O_TRUNC setattr hook (0x20) is NOT on this path (a fresh
# FMODE_CREATED file is never truncated; an existing-file re-open would
# be the shape where it could appear — recorded, not granted).
#
# THE 4C-55 MILESTONE (ROOTLESSKIT-ETC-RESOLV-FILE-RECREATE): the
# replacement regular file successfully created/opened (the openat
# returns an fd), the WriteFile completed (every observed write(fd) ret
# non-negative and every observed close(fd) ret 0x0 — a zero-length
# payload legitimately has no write(2) syscall and is never required:
# the SELinux file:write permission was already checked at the
# open-completion hook via the file's f_mode, so the permission's proof
# is the OLD combined 0x40004 boundary's GONE plus the fd, not a
# write(2); the observed replacement payload is non-empty — the
# stateDir resolv.conf carries "nameserver 10.0.2.3" — so the write(2)
# is expected to appear and is recorded when it does), and the flow
# advanced to the next production stage (the /etc/hosts
# RemoveAll/WriteFile chain, then the stateDir bind mounts).
#
# SCOPE NOTE — GLOBAL TYPE, NOT OPERATION-SCOPED: tmpfs_t:s0 carries no
# per-operation MCS category, so this allow is not operation-scoped (the
# nsfs_t/tmpfs scope shape); the in-namespace capability layer and the
# MCS-constrained subject stay the abuse gates, and the
# cross-operation reachability gate stays OPEN.
#
# The audit slice was empty for the 4C-54 shape (the same
# userspace-audit gap as the lnk_file create/read windows); the 4C-55
# combined mask is recorded from the same window's own selinux_audited
# record above — the raw mask is the boundary (a next symbolic AVC
# record, when captured, is the confirming decode).
#
# Deliberately NOT granted: read/getattr/setattr/append/map/unlink/
# link/rename/execute/lock/ioctl/relabelfrom/relabelto/audit_access/
# execmod or any other file permission (each a distinct hook — this is
# deliberately NOT the typical file-RW bundle; read stays ungranted
# even though write/open/create are the triple: the file is written
# blind, never read back, and a read hook is its own phase if a live
# boundary ever demands it), any new tmpfs_t:dir permission (the
# 4C-46/47 owner's pair stays exact), any new tmpfs_t:lnk_file
# permission (the 4C-48/50/53 owner's triple stays exact), any
# net_conf_t surface (the 4C-51/52 owner's pair stays exact), any other
# type's file surface, filesystem/mount surfaces, the process/
# capability surfaces, other subjects; the .fc and the module version
# stay untouched; no require delta (tmpfs_t is already required). The
# /etc/hosts equivalent openat(O_CREAT) on the SAME already-granted
# type/class/perm is the same permission at work, not a new phase.
allow docker_helper_rootlesskit_t tmpfs_t:file { create write open };

# --- docker_helper_slirp4netns_t: the rootlesskit user-network helper domain (P5-S2) ---
#
# RootlessKit forks and execs the distro slirp4netns binary as its
# user-network helper. This domain exists so a cap_userns decision could be
# made for slirp4netns WITHOUT widening the rootlesskit child domain. The
# transition is pointed: the ONLY path into this domain is the rootlesskit
# child's exec of the slirp4netns entry type. The helper gets NO
# capabilities, no Docker socket, admin token, config/state/runtime, or
# Session workspace surface, and no further grants: its runtime surface is
# the next MAC boundary, to be granted only from live enforcing evidence.
# NOTE: the flow's enforcing boundary has moved past the granted cap_userns
# checks (the 4C-4 live run stops at the mount-namespace reassociation's
# cap_userns sys_chroot check inside nsenter's composite setns), which is
# still BEFORE the helper exec ever starts — the tuntap setup the error
# names precedes the slirp4netns launch. The runtime transition is
# therefore still not live-observable: the type_transition, the transition
# grant, and the entry rule stay statically verified (module compile +
# policy tests); the live transition proof follows in the step that moves
# the network-setup boundary.
type docker_helper_slirp4netns_t, domain;
role system_r types docker_helper_slirp4netns_t;

# Pointed exec transition: the ONLY path into this domain.
type_transition docker_helper_rootlesskit_t docker_helper_slirp4netns_exec_t:process docker_helper_slirp4netns_t;
allow docker_helper_rootlesskit_t docker_helper_slirp4netns_t:process { transition };

# The helper's own entry file: entrypoint for the transition plus the
# post-switch loader access (the mmap/read of the binary happens in the
# new domain — the same loader shape the rootlesskit child domain's own
# entry rule carries). The target-side execute check is live AVC evidence
# (P5-S1 Tumbleweed run 36222264024 permissive harvest: comm="slirp4netns"
# scontext=...docker_helper_slirp4netns_t:s0 denied { execute } on
# /usr/bin/slirp4netns tcontext=...docker_helper_slirp4netns_exec_t:s0
# tclass=file — the exec reaches the new domain and is stopped there under
# enforcing). No execute_no_trans: no AVC evidence exists of slirp4netns
# re-executing itself.
allow docker_helper_slirp4netns_t docker_helper_slirp4netns_exec_t:file { entrypoint read open execute getattr map };

# The helper inherits the rootlesskit child's stdio pipe (the launch
# vehicle's inst.diag output pipe; the child pumps it onward). The
# exec-time inherited-fd check fstats inherited fds and closes ungranted
# ones, which would silence the helper's own failure output — the same
# fd-use shape the proven child rule covers toward the manager. Live AVC
# evidence, P5-S1 Tumbleweed runs: comm="slirp4netns"
# scontext=...docker_helper_slirp4netns_t:s0 denied { write } (run
# 36222264024 harvest) and { getattr } on the same pipes (run 36222881206
# P6 window — the fd-check fstat runs before any write, so getattr is
# required for the inherited fds to survive the exec at all).
allow docker_helper_slirp4netns_t docker_helper_rootlesskit_t:fifo_file { write getattr };

# The helper's namespace-target traversal: slirp4netns resolves the
# RootlessKit target child's network namespace by opening
# /proc/<target-pid>/ns/net (and ns/user) — the FIRST kernel-level step
# is the directory traversal of /proc/<target-pid>/ itself, which
# carries the TARGET process's domain and category as its procfs
# labeling. Live enforcing evidence, canonical 4C-22 run 36835708818,
# audit record 1282: denied { search } for pid=3116 comm="slirp4netns"
# name="3083" dev="proc" scontext=...docker_helper_slirp4netns_t:s0:c1
# tcontext=...docker_helper_rootlesskit_t:s0:c1 tclass=dir
# permissive=0 — the helper crossed the RootlessKit PrepareTap()
# phase (both ip commands exited 0, tap0 ifindex 2 with IFF_UP set)
# and died resolving the target child's proc directory (pid 3083 = the
# nsenter target = the namespaces owner) BEFORE any namespace file was
# opened.
#
# SCOPE — READ CAREFULLY: this is a TYPE-TO-TYPE rule, NOT generic
# /proc access. The source rule is domain-wide: it grants
# docker_helper_slirp4netns_t dir-search authority over directories
# labeled docker_helper_rootlesskit_t (the categorized target
# process's procfs dirs — procfs labels /proc/<pid>/ and /proc/<pid>/ns/
# with the target's SID, so ONE search permission may cover traversal
# through both components; that is the same tuple doing one kind of
# work, not a second grant). Category separation is NOT claimed by this
# rule: the live pair is slirp4netns_t:s0:c1 → rootlesskit_t:s0:c1 and
# the MCS constraints are what keep a c1 helper out of a c2 target's
# proc tree — the cross-operation c1-vs-c2 gate covers exactly that and
# stays mandatory before any Release GO. Deliberately NOT granted
# here: any proc_t/proc-type-attribute or domain-attribute form, any
# proc macro, any file/lnk_file/nsfs access on the namespace paths
# (the open of /proc/<pid>/ns/net|user is the NEXT boundary and must
# materialize live), any setns-related authority, any capability
# (cap_userns or plain), any socket surface and any TUN authority
# beyond the 4C-31 device-node { read write } grant, and NO
# rootlesskit authority mirroring — the helper's staircase starts
# independently.
allow docker_helper_slirp4netns_t docker_helper_rootlesskit_t:dir search;

# The helper's namespace magic-link read: the next step after traversing
# /proc/<target-pid>/ is opening the namespace handles
# /proc/<target-pid>/ns/net and /proc/<target-pid>/ns/user — on this
# kernel/policy pair the proc magic-link is mediated as the TARGET
# process's lnk_file (procfs labels the followed link with the target's
# SID), NOT as an nsfs_t file object. Live enforcing evidence, canonical
# 4C-23 run 36841019772, audit record 1332: denied { read } for
# pid=3117 comm="slirp4netns" name="net" dev="proc" ino=19684
# scontext=...docker_helper_slirp4netns_t:s0:c1
# tcontext=...docker_helper_rootlesskit_t:s0:c1 tclass=lnk_file
# permissive=0 — the traversal grant took effect (the /proc/<pid>/ dir
# search denial is gone) and the helper's namespace-entering child died
# opening the FIRST magic link (name="net") before any setns attempt.
#
# SCOPE — READ CAREFULLY: this is a TYPE-TO-TYPE rule, NOT generic proc
# read. It grants the helper's lnk_file-read authority over the
# categorized rootlesskit target's proc magic-links — expected to cover
# BOTH ns/net and ns/user opens (the same target, the same type/class
# tuple; live behavior is proven in the enforcing run, not assumed).
# Deliberately NOT granted: any other lnk_file permission (getattr/
# write/ioctl/lock), any rootlesskit_t:file or nsfs_t:file access (if
# following the magic link exposes another object/class, that boundary
# materializes live and owns the next phase), any setns-related
# capability (cap_userns sys_admin or plain — the helper keeps its
# zero-capability surface until a live setns boundary proves a
# requirement), any proc_t/domain-attribute/macro form, and no
# rootlesskit authority mirroring.
allow docker_helper_slirp4netns_t docker_helper_rootlesskit_t:lnk_file read;

# The helper's ptrace-may-access capability prerequisite while
# dereferencing the namespace magic-links. Live enforcing evidence,
# canonical 4C-24 run 36843958481, audit record 1323: denied
# { sys_ptrace } (capability=19) for pid=3136 comm="slirp4netns"
# scontext=...docker_helper_slirp4netns_t:s0:c1 tcontext=THE SAME
# docker_helper_slirp4netns_t:s0:c1 tclass=cap_userns permissive=0 —
# the magic-link read grant took effect and the helper's
# namespace-entering child proceeded INTO the open's magic-link
# resolution: open("/proc/<target-pid>/ns/net", O_RDONLY) →
# proc_ns_get_link() → ptrace_may_access(target,
# PTRACE_MODE_READ_FSCREDS) → the capability/DAC prerequisite — the
# SELinux cap_userns check fires against the CALLER's own domain
# (tcontext = the helper's own type, NOT the target's).
#
# ATTRIBUTION — CORRECTED (this boundary is NOT a setns boundary):
# actual setns() of a user namespace later reaches userns_install(),
# whose privilege check is ns_capable(target_user_ns, CAP_SYS_ADMIN) —
# NOT CAP_SYS_PTRACE. The sys_ptrace check observed here belongs to the
# proc namespace-link DEREERENCE path (ptrace-may-access while
# resolving /proc/<pid>/ns/*). No SLIRP-SETNS terminology may be used
# for this boundary; its owner is the proc namespace-link dereference.
#
# SCOPE — READ CAREFULLY: this grant is BROADER than "may open
# /proc/<this-pid>/ns/net". SELinux sees only
# slirp4netns_t self:cap_userns sys_ptrace — it does NOT encode the
# target PID or the pathname. It permits the helper domain to pass
# SELinux's CAP_SYS_PTRACE mediation wherever Linux capability
# semantics already consider it capable in a non-init user namespace.
# Deliberately NOT granted: cap_userns sys_admin (the userns_install()
# authority — no live evidence yet; if setns(CLONE_NEWUSER) is later
# reached, its own boundary materializes), cap_userns sys_chroot/
# net_admin, any PLAIN capability (the AVC is specifically cap_userns,
# not the init-userns capability class), and the SELinux ptrace READ
# access check against the TARGET SID (security_ptrace_access_check
# maps a PTRACE_MODE_READ check to slirp4netns_t → rootlesskit_t:file
# read — the strongest next hypothesis — which must materialize live
# and owns the next phase). The sys_ptrace member of the helper's
# cap_userns surface is granted by the SINGLE rule below; the 4C-30
# widening added the namespace-join sys_admin member to that same
# rule (its comment owns the causal record) — there is no separate
# sys_ptrace rule.

# 4C-30 WIDENING — EXACTLY { sys_ptrace sys_admin }: the 4C-29 canonical
# rerun's first causal terminal boundary (canonical run 36878162747,
# audit records 2445/2447 + the avc:selinux_audited tracepoint) is
# denied { sys_admin } (capability=21) for the helper's
# namespace-joining child pid 3205, twice at the same moment — the two
# setns() calls of the namespace-entry sequence. With both namespace
# handles open (fd 6 = ns/net, fd 7 = ns/user), each setns reaches
# SELinux's cap_userns mediation after the Linux capability check
# PASSES (cap_capable cap=21 ret=0 on the tracepoint — commoncap is not
# the failure): the cap_userns permission check on the CALLER's own
# domain (scontext=tcontext=slirp4netns_t:s0:c1) is denied and setns
# returns -1/EACCES.
#
# CAUSAL OWNERSHIP — RECORD ACCURATELY (do NOT collapse to "needed by
# userns_install()"): the SAME permission occurs in TWO distinct paths.
# The kernel's ns_capable() walks the LSM capable hooks: the commoncap
# cap_capable tracepoint (the Linux capability verdict) AND SELinux's
# cred_has_capability() (the cap_userns AVC, scontext = tcontext = the
# CALLER's own domain). 4C-29's tracepoint proved, for BOTH setns
# calls: commoncap cap=21 ret=0 — the Linux capability check PASSES —
# then SELinux denies sys_admin and setns returns -1/EACCES.
# The release-relevant grant-owning boundary is the FATAL netns join;
# the userns join's failure is recorded as a non-terminal effect.
# Upstream netns_install() carries a SECOND ns_capable
# (nsset->cred->user_ns) after the first — 4C-29 reached only the
# first (SELinux denied it and the || short-circuited); after this
# grant both are newly observable and the canonical rerun must record
# BOTH before any "the netns capability check passed" claim.
#
# SCOPE — THIS IS A BROAD GRANT, RECORD IT AS SUCH: self:cap_userns
# sys_admin is NOT "permission to setns into tap0's netns". It is
# domain-wide SELinux CAP_SYS_ADMIN mediation inside user namespaces
# wherever Linux namespace/capability relationships permit it. It
# encodes neither the target operation nor a category. After this
# widening the helper's exact cap_userns surface is
# { sys_ptrace sys_admin } — materially broader than one syscall,
# which materially increases the weight of the (still open, Release
# GO blocked) c1-vs-c2 cross-operation proof: the nsfs authority is
# already global, and sys_admin now rides on top of it. No claim of
# operation-scoped authority.
#
# Deliberately NOT granted: cap_userns sys_chroot/net_admin (not
# evidenced for this boundary), any PLAIN capability (the AVC is
# specifically cap_userns — the init-userns capability class stays
# closed), any target-relative cap_userns rule, any netlink/socket
# surface, and any TUN authority beyond the 4C-31 device-node
# { read write } grant below (the helper's TUN staircase starts at
# /dev/net/tun and owns its own phases).
allow docker_helper_slirp4netns_t self:cap_userns { sys_ptrace sys_admin };

# The helper's target-SID ptrace READ authority: after the capability
# prerequisite passes, ptrace_may_access() calls
# security_ptrace_access_check(target, PTRACE_MODE_READ_FSCREDS), which
# SELinux maps to the FILE class's read permission BETWEEN the two
# process types. Live enforcing evidence, canonical 4C-25 run
# 36849052587, audit record 1414: denied { read } for pid=3138
# comm="slirp4netns" scontext=...docker_helper_slirp4netns_t:s0:c1
# tcontext=...docker_helper_rootlesskit_t:s0:c1 tclass=file
# permissive=0 — the SAME audit event as the failing
# openat("/proc/3102/ns/net", O_RDONLY) (syscall 257, exit=-13):
# open(ns/user) and setns() were never reached; the flow died inside
# the first open's ptrace check chain.
#
# RATIONALE SCOPE — RECORD ACCURATELY: the TE authority is the
# type/class tuple slirp4netns_t → rootlesskit_t:file read — it applies
# WHEREVER an object or check resolves to that target type and class,
# not only the namespace-link path. The concrete live reason for adding
# it is the namespace-link ptrace introspection chain. Do NOT describe
# this rule as merely "permission to open /proc/<pid>/ns/net".
#
# THE FOUR DISTINCT AUTHORITIES (never collapse into "slirp needs
# access to the namespace"):
#   rootlesskit_t:lnk_file read
#       = the proc namespace magic-link read/follow permission
#   self:cap_userns sys_ptrace
#       = the Linux ptrace-may-access capability prerequisite
#   rootlesskit_t:file read
#       = the SELinux PTRACE_MODE_READ target-SID check
#   self:cap_userns sys_admin
#       = the namespace-join authority (granted by the 4C-30 widening
#         of the single cap_userns rule above; the fatal netns join is
#         its grant-owning boundary)
#
# Deliberately NOT granted: file open/getattr/ioctl (the AVC proves only
# read; if the VFS completion after the ptrace hook produces another
# file/nsfs check, that is a separate boundary — it materialized as the
# nsfs read/open pair granted by the 4C-28/4C-29 rules below), any
# FURTHER cap_userns widening beyond the 4C-30 namespace-join sys_admin
# (sys_chroot/net_admin stay ungranted), any plain capability, and any
# other target-specific surface.
allow docker_helper_slirp4netns_t docker_helper_rootlesskit_t:file read;

# The helper's namespace-handle read: after the target-SID ptrace check
# passes, the openat of /proc/<target-pid>/ns/net|ns/user resolves the
# magic link to the target namespace's nsfs inode, and the VFS open asks
# SELinux for a FILE read on that nsfs object. Live enforcing evidence,
# canonical 4C-27 run 36854286258, audit record 1705: denied { read }
# for syscall=257 (openat) success=no exit=-13, pid=3139 ppid=3138
# comm="slirp4netns" exe="/usr/bin/slirp4netns"
# scontext=...docker_helper_slirp4netns_t:s0:c1
# tcontext=system_u:object_r:nsfs_t:s0 tclass=file, dev="nsfs"
# ino=4026532270 — the same serial carries the AVC and its own syscall
# record, and the tap0-lifecycle observer (05-flow-context.txt) shows
# the tap0 owner namespace is net:[4026532270] in domain
# docker_helper_rootlesskit_t:s0:c1. The kernel chronology at the same
# moment (30-trace-window.txt): sys_openat
# filename="/proc/3122/ns/net" flags=O_RDONLY → the two passing
# cap_capable cap=19 (CAP_SYS_PTRACE) checks inside
# proc_ns_get_link()'s ptrace_may_access → openat → 0xfffffffffffffff3.
# open(ns/user), setns(CLONE_NEWUSER), setns(CLONE_NEWNET), and
# open("/dev/net/tun") were never reached; the flow died at the FIRST
# namespace handle.
#
# SCOPE NOTE — RECORD ACCURATELY: nsfs_t is globally labelled
# (system_u:object_r:nsfs_t:s0) with no per-operation MCS category, so
# this allow is NOT category-scoped namespace-object authority. The
# security chain that reaches this object is:
#   categorized proc target acquisition
#       /proc/<rootlesskit_t:s0:cX>/...
#   ↓ MCS + target-SID checks (dir search, lnk_file read, file read)
#   ↓ namespace magic-link dereference
#   ↓ global nsfs_t:s0 inode
# Once the nsfs object is reached, this allow no longer distinguishes
# c1 from c2. That does not by itself invalidate the design:
# acquisition of another operation's namespace handle must stay blocked
# at the categorized proc-target layer (the MCS constraints on the
# rootlesskit_t proc objects), and blocking it there becomes a
# MANDATORY property of the final c1-vs-c2 proof — that gate stays open
# and Release GO stays closed.
#
# Deliberately NOT granted: nsfs_t:file getattr/ioctl/lock/write/map/
# execute (the AVCs prove read and open only; each owns its own phase
# if it materializes), the distro fs_read_nsfs_files() interface and any
# other read-file macro (read_file_perms expands to materially broader
# authority — { open getattr read ioctl lock } — two of whose members
# are now evidenced, which does NOT collapse the remaining three into
# this phase), and any widening of the helper's frozen surfaces below
# (rootlesskit_t:dir/lnk_file/file, fifo_file, cap_userns).
#
# 4C-29 WIDENING — EXACTLY { read open }: the 4C-28 canonical rerun's
# first new terminal boundary (canonical run 36863680132, audit record
# 1473) is denied { open } for pid=3187 comm="slirp4netns"
# path="net:[4026532270]" dev="nsfs" ino=4026532270 — the SAME namespace
# inode the 4C-27 record's read denial carried and the same inode the
# tap0-lifecycle observer ties to the c1 RootlessKit target child 3155
# (net:[4026532270]) — on the SAME openat("/proc/3155/ns/net", O_RDONLY)
# (syscall 257, exit=-13 EACCES) whose proc-target traversal, magic-link
# read, CAP_SYS_PTRACE commoncap, target-SID FILE__READ, and nsfs read
# checks all passed. The VFS open completion now requires the separate
# FILE__OPEN permission on the nsfs object. The grant is widened IN
# PLACE (no parallel open rule): read+open are the two evidenced VFS
# members; getattr/ioctl/lock are NOT evidenced and stay out.
allow docker_helper_slirp4netns_t nsfs_t:file { read open };

# The helper's TUN device-node access (P5-S2 Phase 4C-31 + 4C-32 +
# 4C-33 + 4C-34): the FIRST boundary of the helper's OWN TUN staircase
# — a NEW helper-domain rule,
# independent of the RootlessKit rule above (the two domains own
# independent TUN staircases; no shared "both TUN users get these
# permissions" surface).
#
# Live enforcing evidence, canonical 4C-30 run 36885139347, audit record
# 2790: denied { read write } for pid=3198 comm="slirp4netns"
# scontext=system_u:system_r:docker_helper_slirp4netns_t:s0:c1
# tcontext=system_u:object_r:tun_tap_device_t:s0 tclass=chr_file
# permissive=0 — the direct open("/dev/net/tun", O_RDWR) issued after
# BOTH namespace joins completed (open(ns/net) -> fd 6, open(ns/user) ->
# fd 7, setns(CLONE_NEWUSER) exit 0 with commoncap cap=21 ret=0,
# setns(CLONE_NEWNET) exit 0 with BOTH netns_install() ns_capable
# checks cap=21 ret=0). The avc:selinux_audited tracepoint decode
# (34-avc-trace-decode.txt of that run) independently confirms the same
# decision: chr_file denied mask 0x6 decoded { read write } by live
# calibration. Without the 4C-31 grant the helper's open_tap() dies at
# the device open and the flow never reaches the second open hook.
#
# The SECOND hook (P5-S2 Phase 4C-32): the canonical 4C-31 rerun
# (36895617204) stopped at the next boundary — audit record 2820:
# denied { open } for pid=3230 comm="slirp4netns" path="/dev/net/tun"
# scontext=system_u:system_r:docker_helper_slirp4netns_t:s0:c1
# tcontext=system_u:object_r:tun_tap_device_t:s0 tclass=chr_file
# permissive=0, issued on the SAME open(O_RDWR) after the FULL
# namespace-join chain completed again (openat("/proc/3212/ns/net",
# O_RDONLY), openat("/proc/3212/ns/user", O_RDONLY),
# setns(CLONE_NEWUSER) exit 0, setns(CLONE_NEWNET) exit 0 — every
# syscall exit recorded by the armed sys_enter/exit tracepoints). The
# avc:selinux_audited decode (34-avc-trace-decode.txt of that run)
# independently confirms the same decision: requested=0x40006
# denied=0x40000 audited=0x40000 result=-13 -> { open }. This is
# selinux_file_open() -> open_file_to_av()'s separate `open`
# permission — the SECOND hook of the SAME open(O_RDWR) syscall, after
# selinux_inode_permission() passed the { read write } stage — exactly
# the hook ordering the RootlessKit staircase proved for comm="ip" in
# 4C-10/4C-11. The grant is therefore widened IN PLACE (no parallel
# open rule): read+write+open are the three evidenced members of the
# one open(O_RDWR) chain, the same three members the RootlessKit rule
# carries.
#
# The GENERIC ioctl permission (P5-S2 Phase 4C-33): the canonical 4C-32
# run (36980615478) stopped at the next boundary — the helper's first
# chr_file ioctl of the existing-TAP attach path. The armed
# sys_enter/exit_ioctl tracepoints recorded it numerically:
# sys_ioctl(fd: 6, cmd: 0x400454ca, arg: 0x7ffd53295410) ->
# 0xfffffffffffffff3 (-13 EACCES), issued IMMEDIATELY after the proven
# openat("/dev/net/tun", O_RDWR) returned fd 6 — the SAME fd the ioctl
# carries. 0x400454ca IS TUNSETIFF: the full _IOC encoding
# (RW | type 0x54 | nr 0xca | size 4) of the attach command, whose
# extperm-normalized value 0x54ca is exactly the command the RootlessKit
# staircase grants. The avc/selinux_audited decision (raw, no
# co-captured symbolic AVC in that window's audit slice): requested=0x1
# denied=0x1 audited=0x1 result=-13 tclass=chr_file
# tcontext=system_u:object_r:tun_tap_device_t:s0 — mask 0x1 is the
# ioctl-driven permission bit of the kernel's chr_file mask (read=0x2/
# write=0x4 and open=0x40000 were calibrated live by the 4C-30/4C-31
# runs' decodes). Between sys_enter_ioctl and sys_exit_ioctl NO
# cap_capable event appeared, and the window holds NO tun_socket or
# cap_userns AVC of any kind: the SELinux file-ioctl check denied
# BEFORE any TUN driver or capability check ran. The grant is the
# GENERIC ioctl permission bit, widened IN PLACE — the ordinary member
# of the RootlessKit rule's evidenced chain. The 4C-33 canonical run
# ALSO proved the intermediate's exact posture: with the ordinary bit
# granted and NO allowxperm bitmap for the tuple, the TUNSETIFF ioctl
# was NOT command-denied — the syscall passed the SELinux file-ioctl
# stage entirely and entered the TUN driver (the same run's tun_socket
# relabel denial fired INSIDE the same sys_ioctl window). A bitmap-less
# ordinary ioctl bit is live-proven command-unrestricted at the SELinux
# layer, so the exact command whitelist is REQUIRED authority, not an
# optimization.
#
# The COMMAND WHITELIST (P5-S2 Phase 4C-34): the helper's attach path's
# one evidenced TUN command is TUNSETIFF — recorded numerically by the
# 4C-32 run's sys_enter/exit_ioctl tracepoints (fd 6, cmd 0x400454ca =
# TUNSETIFF's full _IOC encoding, extperm-normalized 0x54ca) and re-proven
# in the 4C-33 run. The allowxperm rule below whitelists EXACTLY 0x54ca:
# NOT the RootlessKit set { 0x54ca 0x54cb } — TUNSETPERSIST (0x54cb) is
# the creator's persistence command (the rootlesskit child's tap_add_ioctl
# path); upstream slirp4netns's existing-TAP attach issues open + TUNSETIFF
# ONLY (no persistence manipulation — the tap's persistence was set by its
# creator), so no second command is live-proven for this domain. Every
# other driver-0x54 command (TUNSETPERSIST/TUNSETOWNER/TUNSETGROUP/
# TUNSETLINK/TUNGETFEATURES/TUNSETOFFLOAD/TUNSETQUEUE and the rest) is
# decided by the extended-permission bitmap and stays closed, each
# requiring its own live evidence; NO range, NO complement, NO third
# value. The EFFECTIVE loaded-policy xperm union for this tuple must be
# exactly { 0x54ca }: base-policy and attribute-derived contributions
# count toward the verdict, and the enforcing harness proves the union
# with a sesearch allowxperm inventory plus a live negative-command probe
# (a real non-whitelisted TUNSETIFF-sibling ioctl must be xperm-denied
# with its ioctlcmd= record) — an extra effective command there is a
# STOP, not a silent accept.
#
# WHY NOT the rest of tun_socket and NOT net_admin: the helper is NOT
# creating the TAP. RootlessKit already created tap0 (the new-device
# creation path above: the { read write open ioctl } chain, the
# { 0x54ca 0x54cb } xperm, and the self:tun_socket create grant).
# Upstream slirp4netns, after entering the prepared target user/net
# namespaces, attaches its fd to the EXISTING named tap0 via
# open("/dev/net/tun", O_RDWR) + ioctl(fd, TUNSETIFF, &ifr). The
# existing-TAP attach path is security-DISTINCT from new-device creation
# — it drives security_tun_dev_open() and the TAP's stored TUN security
# SID: Phase 4C-35 grants the cross-domain relabelfrom step of that
# attach mediation (the rule below — the 4C-34 canonical run's terminal
# boundary, record 2339) and Phase 4C-36 grants its SELF-targeted
# relabelto step (the 4C-35 canonical run's terminal boundary, record
# 2309); attach_queue and every other socket permission stay ungranted
# — each requires its own live evidence. The helper has successfully
# JOINED the target user/net namespace, so its capability state differs
# from RootlessKit's earlier creation path: cap_userns net_admin
# (RootlessKit's 4C-15 grant) is NOT copied; if an existing-TAP
# operation later performs a capability check, the
# capability:cap_capable tracepoint captures it and the exact
# class/permission is decided on its own evidence.
#
# SCOPE — RECORD ACCURATELY: tun_tap_device_t:s0 is a GLOBAL distro
# device-node label with no per-operation MCS category on the node, so
# this allow is NOT operation-scoped and does NOT by itself isolate the
# c1 helper from a c2 helper: both categories read/write/open and now
# generically ioctl the same globally labelled node equally. Where the existing-TUN attach path
# provides per-operation discrimination, it comes from the target
# network namespace acquisition (the categorized rootlesskit_t proc
# targets), the Linux namespace relationships, the existing TAP's TUN
# security SID/hooks, and MCS constraints where the relevant object
# actually carries a category — the OPEN cross-operation c1-vs-c2 gate
# (Release GO stays closed) owns that proof; this device-node rule does
# not claim it.
#
# Deliberately NOT granted: 0x54cb (TUNSETPERSIST — the creator's
# command, not the attach path's) and every other ioctl command, any
# further chr_file permission, tun_socket create/attach_queue and any
# rootlesskit_t->helper relabel permission, plain capability
# net_admin/net_raw, cap_userns net_admin, and
# getattr/append/lock/create/setattr (none evidenced for the helper).
allow docker_helper_slirp4netns_t tun_tap_device_t:chr_file { read write open ioctl };
allowxperm docker_helper_slirp4netns_t tun_tap_device_t:chr_file ioctl 0x54ca;

# --- THE EXISTING-TAP ATTACH'S SOCKET-RELABEL STEP (P5-S2 Phase 4C-35) ---
#
# The 4C-34 canonical run (36990969572) delivered the attach path's
# terminal SELinux boundary INSIDE the same sys_ioctl(TUNSETIFF) window
# that had already passed the { 0x54ca } command whitelist: with
# open("/dev/net/tun") and the TUNSETIFF ioctl granted, the TAP attach
# mediation denied the socket-relabel step —
#
#   denied { relabelfrom } for pid=3265 comm="slirp4netns"
#     scontext=docker_helper_slirp4netns_t:s0:c1
#     tcontext=docker_helper_rootlesskit_t:s0:c1  tclass=tun_socket
#
#   (audit record 2339; the kernel tracepoints captured the same
#   decision on avc:selinux_audited with masks requested=0x80
#   denied=0x80 audited=0x80 inside sys_enter_ioctl(fd 6,
#   cmd 0x400454ca) .. sys_exit_ioctl(ret -13), decode CALIBRATED
#   0x80 <-> { relabelfrom } against the co-captured symbolic record)
#
# The mediating object is tap0's STORED TUN security SID: RootlessKit
# created the TUN device (the rootlesskit child's new-device creation
# path, so the stored SID carries the rootlesskit child domain), and the
# attach path relabels that existing socket toward the attaching
# process's context — the kernel first checks relabelfrom on the
# socket's OLD (rootlesskit_t) label. The grant is EXACTLY the evidenced
# permission on the evidenced pair:
#
#   docker_helper_slirp4netns_t -> docker_helper_rootlesskit_t:tun_socket
#       = { relabelfrom }
#
# NOT granted with it (each a distinct tun_socket hook): the self
# relabelto (granted by the NEXT phase, 4C-36, on this run's own
# evidence), attach_queue, create, and every other socket permission;
# the rule's subject is the helper domain, so the rootlesskit child's
# own self:tun_socket create rule (P5-S2) is unchanged.
#
# CROSS-OPERATION NOTE — the recorded boundary was c1-vs-c1 (scontext
# c1, tcontext c1: the same instance's rootlesskit child labelled the
# socket). The grant does not make a c1 helper able to relabel a c2
# helper's socket: MCS constrain rules AND the c2-labelled target both
# apply; that attack proof remains the OPEN cross-operation gate's own
# evidence, not this phase's (Release GO stays closed).
allow docker_helper_slirp4netns_t docker_helper_rootlesskit_t:tun_socket relabelfrom;

# --- THE ATTACH PATH'S RELABEL-TO STEP, SELF-TARGETED (P5-S2 Phase 4C-36) ---
#
# The 4C-35 canonical run (36994059437) proved the OLD relabelfrom
# boundary GONE (three channels: no symbolic relabelfrom AVC, no
# calibrated decode record, no raw 0x80 kernel event) and delivered the
# attach path's NEXT terminal boundary INSIDE the same sys_ioctl(TUNSETIFF)
# window —
#
#   denied { relabelto } for pid=3301 comm="slirp4netns"
#     scontext=docker_helper_slirp4netns_t:s0:c1
#     tcontext=docker_helper_slirp4netns_t:s0:c1  tclass=tun_socket
#
#   (audit record 2309; the kernel tracepoints captured the same decision
#   on avc:selinux_audited with masks requested=0x100 denied=0x100
#   audited=0x100 result=-13 inside sys_enter_ioctl(fd 6,
#   cmd 0x400454ca) .. sys_exit_ioctl(ret -13), decode CALIBRATED
#   0x100 <-> { relabelto } against the co-captured symbolic record)
#
# CRITICAL — the recorded shape is a SELF-TARGETED relabelto: BOTH the
# scontext and the tcontext are the helper's own SID (slirp4netns_t:s0:c1),
# NOT the reverse-direction cross-domain grant. The attach path's relabel
# stage on this platform checks relabelto toward the attaching context's
# OWN SID (the new socket SID the attach will install), so the grant is
# EXACTLY the evidenced permission on the evidenced self pair:
#
#   docker_helper_slirp4netns_t -> self:tun_socket = { relabelto }
#
# The cross-domain relabelfrom rule above is unchanged; the rootlesskit
# child's own self:tun_socket create rule (P5-S2) is unchanged; the
# rootlesskit_t -> slirp4netns_t direction is NOT granted (no reverse
# relabel permission exists in the evidence).
#
# CROSS-OPERATION NOTE — with both relabel stages granted the attach
# completes a security-state transfer of the socket object: the OLD
# socket SID is docker_helper_rootlesskit_t:s0:c1 (the rootlesskit
# child's creation label, record 2339 of run 36990969572) and the NEW
# socket SID the attach installs is docker_helper_slirp4netns_t:s0:c1
# (record 2309's tcontext). Both recorded transitions are c1-vs-c1,
# same-instance; a separate c1->c2 attack proof is NOT part of this
# phase — the OPEN cross-operation gate owns it (Release GO stays
# closed).
allow docker_helper_slirp4netns_t self:tun_socket relabelto;

# --- docker_helper_newuidmap_t: the rootlesskit UID-map helper domain (P5-S2) ---
#
# RootlessKit forks and execs the distro newuidmap binary (the shadow
# UID-mapping helper; on Tumbleweed it ships 0755 WITHOUT setuid and takes
# its privilege from the distro's chkstat-applied cap_setuid file
# capability — permissions.d/shadow, proven by the P5-S2 diagnosis) as its
# UID-mapping step. The transition is pointed: the ONLY path
# into this domain is the rootlesskit child's exec of the newuidmap entry
# type. The helper gets NO capabilities, NO cap_userns, no Docker socket,
# admin token, config/state/runtime, or Session workspace surface: the
# distro privilege mechanism stays the only privilege owner and is never
# re-set by docker-helper. The source-side exec checks mirror the proven
# slirp4netns exec
# shape (the same rootlesskit Go exec mechanics: the path-lookup execute,
# the bprm open/read, the pre-exec getattr — the getattr live AVC was
# proven for the sibling exec in run 36199764374). The entry rule carries
# the transition-required entrypoint plus the loader access (the same
# loader shape the helper domain's own entry rule carries, with the
# target-side execute live-AVC-proven for the slirp4netns exec in run
# 36222264024). NOTE: the exec transitions and the helper's UID mapping
# completes successfully (the enforcing runs since the capability grants:
# zero uid_map AVCs — the write-open, the in-namespace sys_admin bit, and
# the out-of-namespace setuid bit are all granted), so the runtime
# transition is proven per-run by the domain's own AVC record (the
# tolerated passwd getattr) or a /proc capture, never by the
# type_transition line alone.
type_transition docker_helper_rootlesskit_t docker_helper_newuidmap_exec_t:process docker_helper_newuidmap_t;
allow docker_helper_rootlesskit_t docker_helper_newuidmap_t:process { transition };

allow docker_helper_rootlesskit_t docker_helper_newuidmap_exec_t:file { execute read open getattr };
allow docker_helper_newuidmap_t docker_helper_newuidmap_exec_t:file { entrypoint read open execute getattr map };

# The helper's own runtime surface (P5-S2): exactly the live enforcing AVC
# records of the previous boundaries (P5-S1 Tumbleweed runs 36229266623 and
# 36248541393 P6 windows, permissive=0, comm="newuidmap"
# scontext=system_u:system_r:docker_helper_newuidmap_t:s0):
#   denied { write }  tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=fifo_file  path="pipe:[21945]" dev="pipefs"
#     (the inherited inst.diag stdio pipe; the fd-use shape mirrors the
#     proven slirp4netns fifo grant, and without the write the helper's own
#     error output is lost)
#   denied { read }   tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=dir        name="3757" dev="proc"
#     (run 36229266623: the procfs parent directory of the uid_map write
#     path; the pair grant is NOT a general directory grant:
#     docker_helper_rootlesskit_t:dir objects are /proc/<pid> entries of
#     processes running in the child domain)
#   denied { open }   tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=dir        path="/proc/3746" dev="proc"
#     (run 36248541393: the O_DIRECTORY open of the SAME target after the
#     read grant; newuidmap failed with its own output "Could not open proc
#     directory for target 3746: Permission denied")
#   denied { getattr } tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=dir        path="/proc/3740" dev="proc"
#     (run 36253390898, record 564: the stat of the TARGET process
#     directory on the mapping path; newuidmap failed with its own output
#     "Could not stat directory for target process: Permission denied" —
#     the identity lookup had already succeeded by then)
#   denied { search }  tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=dir        name="3743" dev="proc"
#     (run 36256089858, record 556: the PATH TRAVERSAL into the target's
#     procfs directory /proc/<rootlesskit-pid>/ on the way to uid_map;
#     newuidmap failed with "open of uid_map failed: Permission denied"
#     and the window carries no file-class record — the open never reached
#     the uid_map file because the walk was denied first)
# The pair surface is evidence-frozen at these two entries. The domain's
# own privilege surface is granted separately below (the in-namespace
# sys_admin bit and the out-of-namespace setuid bit, each with its own
# enforcing AVC evidence) and the uid_map write completes successfully in
# the enforcing runs since. The passwd_file_t getattr denial of the same
# runs (records 563/555) is NON-blocking evidence: the caller's user name
# was determined successfully, so it stays ungranted.
allow docker_helper_newuidmap_t docker_helper_rootlesskit_t:fifo_file { write };
allow docker_helper_newuidmap_t docker_helper_rootlesskit_t:dir { read open getattr search };

# The helper's core write (P5-S2): the write-open of the target process's
# uid_map. Live enforcing AVC evidence (P5-S1 Tumbleweed run 36258882064
# P6 window, record 568: denied { write } name="uid_map" dev="proc"
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0 tclass=file
# permissive=0) plus the grant-scope assessment's permissive harvest (run
# 36261874263: records 334/335 — the SAME open also requires { open } on
# the file class, /proc/2510/uid_map).
#
# SCOPE — READ CAREFULLY: this is a TYPE-PAIR grant, NOT a path-specific
# uid_map rule. It authorizes write/open on the procfs regular files of
# EVERY process running in docker_helper_rootlesskit_t — INCLUDING the
# processes of OTHER concurrent operations: all BuildKit instances run
# their rootlesskit flow in this ONE domain, their file surfaces are
# type-identical (proven by the scope assessment), and the per-instance
# isolation is invocation discipline only. The shared type pair does NOT
# separate operations — an open architectural risk, tracked for the final
# security review. The mem file stays closed: the kernel's
# PTRACE_MODE_ATTACH check maps to process:ptrace between the domains,
# which is NOT granted. No getattr/search/append on this pair and no other
# target types. The helper's own privilege surface (self:cap_userns
# sys_admin, then self:capability setuid) is granted separately below, each
# with its own enforcing AVC evidence.
allow docker_helper_newuidmap_t docker_helper_rootlesskit_t:file { write open };

# The helper's in-namespace capability check at the uid_map write itself
# (P5-S2): with the file write-open granted (enforcing run 36263531925),
# the open succeeded and the write(2) failed at the kernel's capability
# layer with EPERM ("newuidmap: write to uid_map failed: Operation not
# permitted"). Live enforcing AVC evidence (the same run, record 560:
# denied { sys_admin } for pid=3746 comm="newuidmap" capability=21
# scontext=system_u:system_r:docker_helper_newuidmap_t:s0
# tcontext=system_u:system_r:docker_helper_newuidmap_t:s0 tclass=cap_userns
# permissive=0) — the kernel mediated a capability check the helper
# performs inside a NON-INITIAL user namespace, so the class is cap_userns.
# Grant ONLY the in-namespace sys_admin bit: the manager, slirp4netns, and
# every other domain get no cap_userns rights at all. The plain
# self:capability surface is granted separately below, ONLY for the
# evidenced out-of-namespace setuid check (the same write's next kernel
# boundary). SCOPE — READ CAREFULLY: like every helper
# grant this is a domain-wide SELF permission, NOT an operation-scoped one; all build
# operations share the one builder UID and this one SELinux domain, and
# per-operation isolation is invocation discipline only (the open
# architectural risk tracked for the final security review).
allow docker_helper_newuidmap_t self:cap_userns sys_admin;

# The helper's OUT-OF-NAMESPACE capability check at the same uid_map write
# (P5-S2): with the in-namespace sys_admin bit granted (enforcing run
# 36263531925), the write advanced to the kernel's next capability layer and
# stopped there. Live enforcing AVC evidence (run 36265505542, record 569:
# denied { setuid } for pid=3767 comm="newuidmap" capability=7
# scontext=system_u:system_r:docker_helper_newuidmap_t:s0
# tcontext=system_u:system_r:docker_helper_newuidmap_t:s0 tclass=capability
# permissive=0) — the mapping the helper writes extends beyond the caller's
# own uid ([0 475 1 1 231072 65536]), so the kernel requires CAP_SETUID in
# the helper's OWN (initial) user namespace, mediated as the plain
# capability class. The privilege owner is unchanged: the distro's
# chkstat-applied cap_setuid file capability (permissions.d/shadow) puts
# the bit in the helper's permitted set, and this rule lets the
# file-cap-backed check succeed; docker-helper applies no file capabilities
# of its own, never widens a bounding set, and changes no systemd
# configuration.
# SCOPE — READ CAREFULLY: like every helper grant this is a DOMAIN-WIDE
# rule, NOT an operation-scoped one. SELinux now permits the use of
# CAP_SETUID inside docker_helper_newuidmap_t but does NOT restrict that
# permission to a specific PID or Build Operation: all build operations
# share the one builder UID and this one SELinux domain, and per-operation
# isolation is invocation discipline only (the open architectural risk
# tracked for the final security review). Grant ONLY the setuid bit: no
# other capability, no capability2, no gid-mapping surface (newgidmap stays
# ungranted), no additional cap_userns permission.
allow docker_helper_newuidmap_t self:capability setuid;

# The helper's caller-identity lookup (P5-S2): the getpwuid read of
# /etc/passwd that locates the caller's user name before validating the
# requested mapping ranges against the caller's subid database. Live
# enforcing AVC evidence (P5-S1 Tumbleweed runs 36250310697 and
# 36251483787 P6 windows, permissive=0, comm="newuidmap"
# scontext=system_u:system_r:docker_helper_newuidmap_t:s0):
#   denied { read }  tcontext=system_u:object_r:passwd_file_t:s0
#     tclass=file  name="passwd" dev="vda3"   (run 36250310697, record 569)
#   denied { open }  tcontext=system_u:object_r:passwd_file_t:s0
#     tclass=file  path="/etc/passwd" dev="vda3"
#     (run 36251483787, record 564 — the open(2) of the same lookup file,
#     the direct successor of the granted read)
#   (the helper's own failure output at both boundaries: "newuidmap:
#   Cannot determine your user name.")
# Read and open ONLY (P5-S2 sufficiency check, run 36253390898): with the
# open granted the direct files-module lookup COMPLETED — the helper
# domain's userdb fallback denials (init_var_run_t search,
# self:unix_dgram_socket create) did not occur at all, so no userdb grant
# is needed. The passwd getattr denial of the same run (record 563) is
# non-blocking (the user name was determined successfully without it) and
# stays ungranted; the blocking failure moved to the target-process dir
# stat above.
allow docker_helper_newuidmap_t passwd_file_t:file { read open };

# --- docker_helper_newgidmap_t: the rootlesskit GID-map helper domain (P5-S2) ---
#
# The same rootlesskit flow launches the distro newgidmap binary for the
# GID mapping right after the UID-map step. The transition mirrors the
# proven newuidmap shape EXACTLY: the pointed exec transition from the
# rootlesskit child domain over the dedicated exec type is the ONLY path
# into this domain, and the source-side exec checks mirror the proven
# newuidmap source shape (the same rootlesskit Go exec mechanics: the
# path-lookup execute, the bprm open/read, the pre-exec getattr). The
# entry rule carries the transition-required entrypoint plus the loader
# access (the newuidmap entry shape). The runtime surface granted so far:
# the inherited-stdio fifo write, the /proc target-dir
# read-open-getattr-search, the getpwuid passwd read-open, the gid_map
# file write-open, and the in-namespace sys_admin capability bit (each
# with its own enforcing AVC evidence, below). NO userdb fallback, no
# passwd getattr, and no PLAIN self:capability surface: the NEXT
# enforcing boundary inside this domain is the next deliberate step. No
# transition or allow rule points into the domain from the manager or the
# daemon.
type_transition docker_helper_rootlesskit_t docker_helper_newgidmap_exec_t:process docker_helper_newgidmap_t;
allow docker_helper_rootlesskit_t docker_helper_newgidmap_t:process { transition };

allow docker_helper_rootlesskit_t docker_helper_newgidmap_exec_t:file { execute read open getattr };
allow docker_helper_newgidmap_t docker_helper_newgidmap_exec_t:file { entrypoint read open execute getattr map };

# The helper's inherited diagnostic pipe (P5-S2): the first enforcing
# boundary INSIDE the new domain. Live enforcing AVC evidence (run
# 36271082542 P6 window, records 562/563: denied { write } for pid=3803
# comm="newgidmap" path="pipe:[22067]" dev="pipefs"
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
# tclass=fifo_file permissive=0) — the helper inherits the rootlesskit
# child's stdio pipe (the launch vehicle's inst.diag output pipe), and
# without the write the helper's OWN failure output is silenced (the child
# tail's empty message slot: "newgidmap 3797 [0 475 1 1 231072 65536]
# failed: : exit status 1"). The fd-use shape mirrors the proven
# newuidmap fifo grant (and the slirp4netns shape; unlike slirp4netns, no
# getattr is evidenced or granted — the helper writes only). Everything
# beyond the fifo write stayed ungranted at the grant's boundary: the
# /proc dir { read } denial (the NEXT boundary, granted below), the
# gid_map file write, and any capability surface (the distro
# chkstat-applied cap_setgid file capability stays the only privilege
# owner).
allow docker_helper_newgidmap_t docker_helper_rootlesskit_t:fifo_file { write };

# The /proc/<target> directory access on the gid_map write path (P5-S2):
# the helper opens the target process's procfs directory to write its
# gid_map. Live enforcing AVC evidence, one boundary at a time: the read
# (run 36300820035 P6 window, record 574: denied { read } comm="newgidmap"
# name="3793" dev="proc" scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0 tclass=dir
# permissive=0; and with the read granted, run 36302169439 P6 window,
# record 546: denied { open } path="/proc/3791" — the O_DIRECTORY open of
# the SAME target, the direct successor of the granted read, the same
# progression newuidmap showed at its own boundary; and with the
# read-open granted, run 36306315923 P6 window, record 553:
# denied { getattr } for pid=3805 comm="newgidmap" path="/proc/3799"
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0 tclass=dir
# permissive=0 — the helper's stat("/proc/<target>") call, REQUIRED by
# libcap's newgidmap to validate the target process before the gid_map
# write; the helper's own failure output at that point was "newgidmap:
# Could not stat directory for target process: Permission denied"; and
# with the stat passed, run 36307865078 P6 window, record 557:
# denied { search } for pid=3788 comm="newgidmap" name="3782" dev="proc"
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0 tclass=dir
# permissive=0 — the SEARCH required to resolve the path to
# /proc/<target>/gid_map after the successful stat; the helper's open
# failed with "newgidmap: open of gid_map failed: Permission denied"
# WITHOUT any file-level AVC, because the denied dir search
# short-circuits the path lookup before the file-class check) — the
# grant is NOT a general directory grant: docker_helper_rootlesskit_t:dir
# objects are /proc/<pid> entries of processes running in the child
# domain. SCOPE — READ CAREFULLY: like every helper grant this is a
# TYPE-PAIR rule, NOT a pid-specific one: it authorizes the
# read-open-getattr-search on the procfs directories of EVERY process
# running in docker_helper_rootlesskit_t — INCLUDING the processes of
# OTHER concurrent operations (their isolation is invocation discipline
# only; the open architectural risk tracked for the final security
# review). The four-perm set now mirrors the newuidmap dir grant shape;
# the gid_map FILE grant is a separate rule below (its own scope decision
# was taken there, on the assessed scope). No capability surface.
allow docker_helper_newgidmap_t docker_helper_rootlesskit_t:dir { read open getattr search };

# The gid_map file write-open (P5-S2): the helper opens the target
# process's /proc/<pid>/gid_map to write the GID map. Live enforcing AVC
# evidence: run 36309380915 P6 window, record 550 — denied { write } for
# pid=3811 comm="newgidmap" name="gid_map" dev="proc"
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0 tclass=file
# permissive=0 (the helper's open(O_WRONLY) failed at the write check —
# the FIRST check on the open path; no file-level `open` AVC had appeared
# yet). The `{ write }`-only shape was REFUTED by the scope assessment
# (run 36315198548): with a guest-only diag module carrying exactly
# `{ write }`, every O_WRONLY open of a rootlesskit_t procfs file was
# still denied at the file OPEN permission (24 open AVCs) — the open path
# checks write first, then open — so the required shape is
# `{ write open }`, exactly the pair the newuidmap domain holds. The
# scope assessment also demonstrated, as newuidmap_t with its EXISTING
# grant, that the WRONLY opens of EVERY rootlesskit_t file of BOTH
# concurrent diagnostic operations were allowed — own and neighbor
# alike. SCOPE — READ CAREFULLY: like every helper grant this is a
# TYPE-PAIR rule, NOT pid-specific and NOT operation-scoped: it
# authorizes the write-open of the procfs files of EVERY process running
# in docker_helper_rootlesskit_t — INCLUDING the processes of OTHER
# concurrent Build Operations; their isolation is invocation discipline
# only (the helper validates the CALLER's identity, which both operations
# share; the open architectural risk tracked for the final security
# review). The interoperation risk is accepted FOR DEVELOPMENT ONLY, NOT
# for release (Release GO stays closed until the isolation model is
# decided). NOT granted on this pair: read/append/getattr/setattr, any
# PLAIN self:capability surface (the in-namespace sys_admin bit IS
# granted below with the live R5 evidence; the out-of-namespace setgid
# check is the NEXT enforcing boundary and is decided separately), the
# mem file (the ptrace layer stays closed), and the setgroups write-open
# (the kernel state rule).
allow docker_helper_newgidmap_t docker_helper_rootlesskit_t:file { write open };

# The helper's IN-NAMESPACE capability check at the same gid_map write
# (P5-S2 Phase 4C-1): with the file write-open granted, the write reached
# the kernel's capability layer and failed there with EPERM. Live
# enforcing AVC evidence (Phase 4B run 36617327970's launch window,
# record 402: denied { sys_admin } for pid=2870 comm="newgidmap"
# capability=21
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0:c1
# tcontext=system_u:system_r:docker_helper_newgidmap_t:s0:c1
# tclass=cap_userns permissive=0, followed in the same window by the
# helper's own failure output "newgidmap: write to gid_map failed:
# Operation not permitted" and rootlesskit's "failed to setup UID/GID
# map" — the direct causal chain to the R5 START failure) — the GID-side
# mirror of the proven newuidmap in-namespace boundary: the kernel
# mediated a capability check the helper performs inside a NON-INITIAL
# user namespace, so the class is cap_userns. Grant ONLY the in-namespace
# sys_admin bit: the manager, the launcher, the flow, slirp4netns, and
# newuidmap receive no cap_userns rights from this correction, and the
# plain self:capability surface (setgid, the out-of-namespace side of the
# same write) stays deliberately closed as the next enforcing boundary.
# The domain stays mcs_constrained_type: the operation scope of the
# gid-map write path is owned by the categorized process/object MCS
# boundary (own-category procfs files), not by any capability permission.
# This is a domain-wide SELF permission, not a domain-pair rule: it
# applies to every process in docker_helper_newgidmap_t, and the
# operation separation is still owned by the categorized process/object
# MCS boundary on the process/object path, not by the capability grant.
# SCOPE — READ CAREFULLY: all build operations share the one builder
# identity and this one SELinux domain, and per-operation isolation is
# invocation discipline only (the open architectural risk tracked for the
# final security review).
allow docker_helper_newgidmap_t self:cap_userns sys_admin;

# The helper's OUT-OF-NAMESPACE capability check at the same gid_map write
# (P5-S2 Phase 4C-2): with the in-namespace sys_admin bit granted (Phase
# 4C-1), the write advanced past the capability layer it was stopped at in
# the R5 run and reached the kernel's next capability check. Live
# enforcing AVC evidence (Phase 4C-1 run 36620968307's launch window,
# record 400: denied { setgid } for pid=2868 comm="newgidmap"
# capability=6
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0:c1
# tcontext=system_u:system_r:docker_helper_newgidmap_t:s0:c1
# tclass=capability permissive=0, followed in the same window by the
# helper's own failure output "newgidmap: write to gid_map failed:
# Operation not permitted" and rootlesskit's "failed to setup UID/GID
# map" — the direct causal chain to the 4C-1 START failure) — the GID-side
# mirror of the proven newuidmap out-of-namespace boundary, grounded in
# THIS domain's own live evidence, not the UID grant by symmetry: the
# mapping the helper writes extends beyond the caller's own gid
# ([0 475 1 1 165536 65536]), so the kernel requires CAP_SETGID in the
# helper's OWN (initial) user namespace, mediated as the plain
# self:capability setgid check. The grant covers only the USE of the
# distro's file-cap-backed CAP_SETGID: docker-helper itself sets no file
# capabilities, never touches a bounding set, and grants no setgid to the
# manager, the launcher, the flow, slirp4netns, or newuidmap (newuidmap
# keeps exactly its evidenced setuid and receives no setgid). The
# domain-wide SELF permission applies to every process in
# docker_helper_newgidmap_t, and the operation separation is still owned
# by the categorized process/object MCS boundary on the process/object
# path, not by the capability grant. The next enforcing boundary after
# this grant is the next deliberate step.
allow docker_helper_newgidmap_t self:capability setgid;

# The getpwuid passwd lookup of the caller's user name (P5-S2), granted
# read-open with live enforcing AVC evidence: the read (run 36303567126
# P6 window, record 572: denied { read } for pid=3806 comm="newgidmap"
# name="passwd" dev="vda3" scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:object_r:passwd_file_t:s0 tclass=file permissive=0)
# and the open(2) of the SAME /etc/passwd — the direct successor of the
# granted read (run 36305066030 P6 window, record 531: denied { open }
# for pid=3810 comm="newgidmap" path="/etc/passwd" dev="vda3"
# scontext=system_u:system_r:docker_helper_newgidmap_t:s0
# tcontext=system_u:object_r:passwd_file_t:s0 tclass=file permissive=0).
# With both granted the direct lookup COMPLETED: the userdb-fallback
# denials that appeared while the lookup was denied
# (init_var_run_t:dir { search }, self:unix_dgram_socket { create }) did
# NOT occur in the follow-up enforcing run (36306315923) — the fallback
# permissions stay ungranted, proven unnecessary for the direct lookup.
# The helper's passwd getattr denial (run 36306315923 record 552) also
# occurred and is NON-blocking — the flow continued past it to the next
# failure; getattr stays ungranted (never treated as a grant mandate).
allow docker_helper_newgidmap_t passwd_file_t:file { read open };

# The child's user-namespace creation itself: rootlesskit creates the userns
# that hosts the buildkitd instance. Live enforcing AVC evidence (P5-S1
# Tumbleweed run 36200721417 P6 window: denied { create }
# comm="rootlesskit" scontext=system_u:system_r:docker_helper_rootlesskit_t:s0
# tcontext=...docker_helper_rootlesskit_t:s0 tclass=user_namespace
# permissive=0). Grant ONLY the create to the child domain: no equivalent
# manager grant, and no plain self:capability surface — the child's
# capability surface is granted separately below (the four evidenced
# in-namespace bits, each with its own enforcing AVC evidence).
allow docker_helper_rootlesskit_t self:user_namespace create;

# The child's in-namespace capability checks inside the flow's own user
# namespace. Exactly ONE cap_userns rule for the child domain, with the
# four evidenced bits, each with its own live causal provenance:
#
#   self:cap_userns { sys_admin sys_ptrace sys_chroot net_admin }
#
#   - sys_admin (capability 21): the same rootlesskit flow re-executes its
#     binary inside the new userns and performs the namespace-entry
#     operations. Live enforcing AVC evidence (P5-S1 Tumbleweed run
#     36225231523 P6 window: denied { sys_admin } capability=21
#     comm="rootlesskit" scontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0
#     tclass=cap_userns permissive=0).
#   - sys_ptrace (capability 19): the flow's namespace-exec helper nsenter
#     re-associates into the flow's own namespaces (setns after
#     "nsenter -t <pid> -n -m -U"); the kernel's
#     validate_nsset()/ptrace_may_access() path toward the target process
#     requires CAP_SYS_PTRACE in the (non-initial) user namespace, mediated
#     as cap_userns — NOT the plain capability class. Live enforcing AVC
#     evidence (Phase 4C-3 run 36666540157, launch-window records 402/403:
#     denied { sys_ptrace } for pid=2886 comm="nsenter" capability=19
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tclass=cap_userns permissive=0, followed in the same window by
#     nsenter's own failure "nsenter: reassociate to namespaces failed:
#     Operation not permitted" and rootlesskit's "failed to setup network
#     ... setting up tap tap0: executing [[nsenter -t 2858 ...]]: exit
#     status 1" — the direct causal chain to the 4C-3 flow death). This is
#     not a debugger/ptrace surface: the permission is exactly the
#     target-task authority check the pidfd composite setns performs
#     before the namespace installation.
#   - sys_chroot (capability 18): the SAME composite setns continues past
#     ptrace_may_access() into userns_install() and then mntns_install(),
#     whose mount-namespace reassociation requires
#     ns_capable(mnt_ns->user_ns, CAP_SYS_ADMIN) [the granted, live-proven
#     bit], ns_capable(user_ns, CAP_SYS_CHROOT), and
#     ns_capable(user_ns, CAP_SYS_ADMIN). The live AVC is EXACTLY the
#     CAP_SYS_CHROOT check of that sequence — not a name-based hypothesis:
#     the mount namespace belongs to the flow's non-initial user
#     namespace, so the check is mediated as cap_userns, never the plain
#     capability class. Live enforcing AVC evidence (Phase 4C-4 run
#     36689190274, launch-window record 400: denied { sys_chroot } for
#     pid=2900 comm="nsenter" capability=18
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tclass=cap_userns permissive=0, followed in the same window by
#     nsenter's own failure "nsenter: reassociate to namespaces failed:
#     Operation not permitted" and rootlesskit's "failed to setup network
#     ... setting up tap tap0: executing [[nsenter -t 2873 ...]]: exit
#     status 1" — the direct causal chain to the 4C-4 flow death; the
#     earlier sys_ptrace boundary no longer occurs in that window).
#   - net_admin (capability 12): the flow's tap creation — after the
#     granted TUNSETIFF ioctl (the 4C-14 exact xperm) — enters
#     tun_set_iff()'s new-interface branch, whose first check is
#     ns_capable(net->user_ns, CAP_NET_ADMIN) in the flow's own
#     non-initial user namespace, mediated as cap_userns — NOT the plain
#     capability class. Live enforcing AVC evidence (Phase 4C-14 run
#     36747365595, audit record 421: denied { net_admin } for pid=3044
#     comm="ip" capability=12
#     scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
#     tclass=cap_userns permissive=0) with the direct userspace failure
#     "ioctl(TUNSETIFF): Operation not permitted" — the SAME ioctl
#     changed its errno from the 4C-13 SELinux ioctl-gate EACCES
#     ("Permission denied") to the kernel capability-check EPERM, which
#     is the direct proof the request passed chr_file:ioctl + allowxperm
#     { 0x54ca } and entered tun_set_iff(). This is NOT TUN-only
#     authority — see the net_admin scope note below. The downstream TUN
#     LSM authority (the tun_socket create the kernel's
#     security_tun_dev_create() would map next) is deliberately NOT
#     folded into this grant.
#
# net_admin SCOPE — READ CAREFULLY: cap_userns net_admin is materially
# BROADER than "permission to create tap0" — it is domain-wide
# network-administration authority inside every user namespace where
# the process satisfies the kernel namespace relationship, and this
# policy does NOT describe it as TUN-only. What makes it acceptable at
# this phase is narrower: the live kernel path requires it (the
# recorded ns_capable(net->user_ns, CAP_NET_ADMIN) denial is the
# direct evidence), it is the cap_userns class (in the flow's own
# non-initial user namespace), NOT the initial-userns plain capability
# (which stays zero), and the flow is categorized. Cross-operation
# namespace reachability is NOT resolved by this grant — the gate is
# now MORE important: the flow domain carries in-namespace
# network-admin authority alongside the sys_admin/sys_ptrace/sys_chroot
# entry authority, and the final c1-vs-c2 proof must demonstrate that a
# c1 flow cannot use its namespace-entry + network-admin authority
# against another operation's namespaces/processes (still an open
# concurrency/security gate before the Release GO).
#
# SCOPE — READ CAREFULLY: this is a domain-wide SELF permission, NOT an
# operation-scoped one: it applies to every process running in
# docker_helper_rootlesskit_t, it does NOT by itself provide operation
# isolation, and the operation separation is owned by the categorized
# process/object MCS boundary (mcs_constrained_type), not by the
# capability grant. The surface is IN-USERNS ONLY: sys_chroot here is the
# in-userns bit of the mount-namespace reassociation, NOT the plain
# initial-userns CAP_SYS_CHROOT — no plain self:capability grant is added
# (the out-of-namespace system capability set stays zero), and the
# manager, the launcher, and slirp4netns domains get no cap_userns rights
# at all. Cross-operation namespace targeting (a flow process reaching
# ANOTHER operation's namespaces) is NOT proven safe by this grant: it
# stays an open concurrency/security gate before the Release GO.
allow docker_helper_rootlesskit_t self:cap_userns { sys_admin sys_ptrace sys_chroot net_admin };

# The flow's TUN-socket object creation (P5-S2 Phase 4C-16): the
# NEW-device branch of TUNSETIFF. After the proven chr_file ioctl+xperm
# gate (4C-14) and the in-namespace CAP_NET_ADMIN check (4C-15),
# tun_set_iff()'s new-interface branch calls security_tun_dev_create() —
# the kernel hook SELinux maps to self:tun_socket create — before the
# tap device object is created and registered. Live enforcing AVC
# evidence (Phase 4C-15 canonical run 36755379800, audit record 422:
# denied { create } for pid=3058 comm="ip"
# scontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
# tcontext=system_u:system_r:docker_helper_rootlesskit_t:s0:c1
# tclass=tun_socket permissive=0) with the direct userspace failure
# "ioctl(TUNSETIFF): Permission denied" (EACCES at this hook; the errno
# changed again from the 4C-14 capability-check EPERM, and the causal
# placement is INSIDE the same TUNSETIFF call, past the passed
# ns_capable(net->user_ns, CAP_NET_ADMIN) check — the request completes
# SELinux mediation exactly here and must not stop).
#
# SCOPE — READ CAREFULLY: exactly ONE permission of the tun_socket
# class — the NEW-device creation of the flow's own TUNSETIFF path.
# Deliberately NOT granted: attach_queue (the TUNSETQUEUE /
# queue-attachment path — security_tun_dev_attach_queue() — a distinct
# UAPI surface, not this evidenced new-device creation), relabelfrom/
# relabelto (the attach-to-an-existing-TUN-object path —
# security_tun_dev_open()'s relabel checks), and NO inherited generic
# socket permission (no bind/connect/read/write/getopt/setopt/setattr/
# getattr/lock/append/name_bind/listen/accept/shutdown/map). The
# distro's create_socket_perms-style socket macros are deliberately NOT
# used: they expand far beyond the evidenced creation boundary — that
# is explicitly not this policy's model. Like every flow-domain grant
# this is a domain-wide SELF permission, not an operation-scoped one;
# the operation separation is owned by the categorized process/object
# MCS boundary, and cross-operation namespace targeting stays an open
# concurrency/security gate before the Release GO.
allow docker_helper_rootlesskit_t self:tun_socket create;

# --- MCS operation isolation: constrained-domain membership (G32 r3 §6.A) ---
#
# The four flow-side domains join the mcs_constrained_type attribute: the
# three-domain G26 minimal set (rootlesskit child + the two uid/gid map
# helpers; the G26 Parts C/D pairing proved the cross-operation uid-map
# and process-control closures) plus slirp4netns — a G26 exclusion whose
# premise (the domain is unreachable under enforcing policy) was removed by
# G28, which runs slirp4netns live in the full flow; including it closes
# the subject-side MCS exemption class. Every flow surface of these
# domains is same-category by construction.
#
# Deliberately NOT members: docker_helper_t and docker_helper_builder_t
# (the trusted control planes — their cross-category reachability is the
# measured escape mechanics the launch chain and the lifecycle depend on),
# docker_helper_builder_launcher_t (the authority-free launch child must
# reach ANY operation's category), and docker_helper_container_t (the
# separate managed-container boundary, already a member by its own
# design).
typeattribute docker_helper_rootlesskit_t mcs_constrained_type;
typeattribute docker_helper_newuidmap_t mcs_constrained_type;
typeattribute docker_helper_newgidmap_t mcs_constrained_type;
typeattribute docker_helper_slirp4netns_t mcs_constrained_type;

# The flow's minimal traversal toward the root types (G32 r3 §4.1): the
# rootlesskit child walks through the roots and the shared ops containers
# to reach its own per-op trees. Search only — no create/add_name/unlink
# on the root plane (I8); getattr stays ungranted until live evidence.
allow docker_helper_rootlesskit_t docker_helper_builder_state_root_t:dir { search };
allow docker_helper_rootlesskit_t docker_helper_builder_runtime_root_t:dir { search };

# Daemon transport to the builder manager (P5-S1 item 4): the daemon
# dials manager.sock and the per-op buildkitd sockets, and nothing
# else. This is the ONLY access the daemon gets into the builder trees;
# the builder domain gets no mirror-image access into any daemon-owned
# type. G32 r3: manager.sock lives in the runtime ROOT (root type); the
# per-op buildkitd sockets stay on the per-op runtime type. The daemon
# keeps ZERO grants on docker_helper_builder_state_t.
allow docker_helper_t docker_helper_builder_runtime_root_t:dir { search };
allow docker_helper_t docker_helper_builder_runtime_root_t:sock_file { getattr open read write };
allow docker_helper_t docker_helper_builder_runtime_t:dir { search };
allow docker_helper_t docker_helper_builder_runtime_t:sock_file { getattr open read write };
allow docker_helper_t docker_helper_builder_t:unix_stream_socket { connectto };

# --- docker_helper_container_t: custom container domain ---

# Container transitions are performed by container_runtime_domain (Docker),
# not by docker_helper_t. container-selinux already grants transitions from
# container_runtime_domain to types with container_domain attribute.

# Container rootfs access: reproduces container_manage_files_template
# from container-selinux for container_file_t.
allow docker_helper_container_t container_file_t:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map
};
allow docker_helper_container_t container_file_t:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
};
allow docker_helper_container_t container_file_t:lnk_file { read create getattr unlink write };
allow docker_helper_container_t container_file_t:sock_file { create getattr read write append ioctl setattr unlink };
allow docker_helper_container_t container_file_t:chr_file { create getattr read append ioctl watch open write };
allow docker_helper_container_t container_file_t:blk_file { create getattr read append ioctl };
allow docker_helper_container_t container_file_t:fifo_file { create getattr read write append ioctl watch };

# /proc/filesystems read by the container runtime (from live AVC evidence):
#   scontext=docker_helper_container_t tcontext=proc_t tclass=file denied { read } name=filesystems
# Read/open only; no broader proc access.
allow docker_helper_container_t proc_t:file { read open };

# --- Container workspace access ---
#
# Both user_home_type (for /home paths) and docker_helper_workspace_t
# (for non-home Session workspaces) receive equivalent container-side
# development-tree semantics: regular file management, directory management,
# symlink lifecycle, chmod/setattr, executable build/run, mmap/ELF loading,
# Unix sockets, and FIFOs.

# user_home_type: regular files — create, read/write, build, execute
allow docker_helper_container_t user_home_type:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map link entrypoint
};

# user_home_type: directories — normal POSIX tree management
allow docker_helper_container_t user_home_type:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
	lock link unlink rename reparent
};

# user_home_type: symlinks — normal development-tree symlink lifecycle
allow docker_helper_container_t user_home_type:lnk_file {
	read create getattr setattr unlink write append rename link ioctl lock
};

# user_home_type: Unix-domain socket filesystem nodes
allow docker_helper_container_t user_home_type:sock_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# user_home_type: FIFOs
allow docker_helper_container_t user_home_type:fifo_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# docker_helper_workspace_t: regular files — create, read/write, build, execute
allow docker_helper_container_t docker_helper_workspace_t:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map link entrypoint
};

# docker_helper_workspace_t: directories — normal POSIX tree management
allow docker_helper_container_t docker_helper_workspace_t:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
	lock link unlink rename reparent
};

# docker_helper_workspace_t: symlinks — normal development-tree symlink lifecycle
allow docker_helper_container_t docker_helper_workspace_t:lnk_file {
	read create getattr setattr unlink write append rename link ioctl lock
};

# docker_helper_workspace_t: Unix-domain socket filesystem nodes
allow docker_helper_container_t docker_helper_workspace_t:sock_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# docker_helper_workspace_t: FIFOs
allow docker_helper_container_t docker_helper_workspace_t:fifo_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# Container read-only access to injected trusted CA material.
allow docker_helper_container_t docker_helper_trusted_ca_t:dir { getattr search read open };
allow docker_helper_container_t docker_helper_trusted_ca_t:file { getattr read open };
allow docker_helper_container_t docker_helper_trusted_ca_t:lnk_file { getattr read };

# Workload transport reachability to the helper socket (helper_socket
# capability, 2.1.1). The daemon injects a read-only bind of its runtime
# directory into the container, so the workload can resolve and connect to
# the existing docker-helper.sock inside it. Transport only:
#   - directory traversal/getattr; no directory listing and no access to
#     runtime file contents (lock/cid/mount machinery);
#   - the connection itself still requires a bearer credential at the API
#     authentication boundary; ownership grants no authority;
#   - connectto is the single process permission, matching the existing
#     docker_helper_t -> dockerd connectto pattern.
allow docker_helper_container_t docker_helper_runtime_t:dir { getattr search };
allow docker_helper_container_t docker_helper_runtime_t:sock_file { getattr open read write };
allow docker_helper_container_t docker_helper_t:unix_stream_socket { connectto };

# systemd (init_t) cleanup of RuntimeDirectory including trusted CA tree
# on service stop/failure. Cleanup-only permissions: remove directories and
# unlink files; no read/write of CA content.
allow init_t docker_helper_trusted_ca_t:dir { write remove_name rmdir };
allow init_t docker_helper_trusted_ca_t:file { unlink };
allow init_t docker_helper_trusted_ca_t:lnk_file { unlink };

# --- Workload read-only projection ---
#
# Mechanism: the helper builds one bindfs FUSE passthrough projection per
# accepted read-only exposure from the pinned kernel materialization source.
# bindfs projects the pinned backing tree with a fixed mount context
# (system_u:object_r:docker_helper_ro_projection_t:s0); the backing source
# label, device, and inode never change. The container receives the
# projection (or the pinned source directly for read-write mounts) through a
# Docker bind that stays readonly in production.
#
# The projection type is a dedicated file type. It deliberately does not
# carry container_file_type: container-selinux's generic writable-volume
# rules must not apply to it. It deliberately does not carry any attribute
# that would grant mutation semantics.

type docker_helper_ro_projection_t, file_type;

# Mount-context labels on FUSE must be associable with the FUSE filesystem.
allow docker_helper_ro_projection_t fusefs_t:filesystem associate;

# Workload read/execute compatibility with an explicit mutation exclusion.
# Deliberately omitted for the projection type: write, append, create,
# setattr, add_name, remove_name, unlink, rename, link, and reparent.
allow docker_helper_container_t docker_helper_ro_projection_t:file {
	execute execute_no_trans entrypoint getattr ioctl lock map open read
};
allow docker_helper_container_t docker_helper_ro_projection_t:dir {
	getattr ioctl lock open read search
};
allow docker_helper_container_t docker_helper_ro_projection_t:lnk_file { getattr read };
allow docker_helper_container_t docker_helper_ro_projection_t:sock_file {
	getattr ioctl lock open read
};
allow docker_helper_container_t docker_helper_ro_projection_t:fifo_file {
	getattr ioctl lock open read
};
allow docker_helper_container_t fusefs_t:filesystem getattr;

# Docker/runc may inspect the already-mounted projection while constructing
# the bind in the container mount namespace. Setup-only read grants; workload
# mutation remains governed by docker_helper_container_t above.
allow container_runtime_t docker_helper_ro_projection_t:dir { getattr open read search };
allow container_runtime_t docker_helper_ro_projection_t:file { getattr open read };
allow container_runtime_t docker_helper_ro_projection_t:lnk_file { getattr read };
allow container_runtime_t fusefs_t:filesystem getattr;

# --- Helper-side projection mechanics (bindfs/FUSE) ---

# bindfs executable: the helper execs the bindfs worker in its own domain
# (no process transition). The dedicated exec type is applied by the shipped
# file context rule for /usr/bin/bindfs.
type docker_helper_bindfs_exec_t, file_type, exec_type;

allow docker_helper_t docker_helper_bindfs_exec_t:file {
	getattr open read execute execute_no_trans map
};

# /dev/fuse (fuse_device_t, from the base policy) is required by the bindfs
# FUSE worker to open the FUSE device.
allow docker_helper_t fuse_device_t:chr_file { getattr open read write ioctl };

# The bindfs worker (docker_helper_t process) performs the FUSE mount of the
# projection with the fixed projection mount context. Projection cleanup uses
# the kernel unmount API directly (normal unmount, then lazy-detach fallback),
# and startup reconciliation uses the same production mount owner.
allow docker_helper_t fusefs_t:filesystem { mount unmount getattr relabelfrom };

# With the fixed context= mount option the mounted superblock carries the
# projection context itself, so the mount/unmount/getattr checks name
# docker_helper_ro_projection_t, not the fuse filesystem type. Without this
# grant the FUSE mount fails with EACCES under enforcing SELinux and the
# read-only projection backend is unreachable (observed as
# "fuse: mount failed: Permission denied" on the packaged RPM and tarball
# paths of the exact-artifact UAT).
allow docker_helper_t docker_helper_ro_projection_t:filesystem { mount unmount getattr relabelto relabelfrom };

# The projection mountpoints live under the helper-owned runtime tree.
allow docker_helper_t docker_helper_runtime_t:dir { mounton };

# The lower-item bind for regular-file projections mounts onto a
# helper-owned lower item under the runtime tree (docker_helper_runtime_t,
# covered by the runtime dir/file mounton grants above). No workspace-typed
# or home-typed object receives a mounton grant: regular-file bind targets
# are always helper-owned runtime items, never workspace files. If an
# enforcing live run ever shows a real mounton AVC for a workspace/home
# source object, record the exact source context, target context, tclass,
# denied permission, and syscall/mount direction first, then add only the
# one minimal grant that evidence requires.

# The helper proves the projection after preparation (security.selinux
# getxattr) by getattr/open on the mounted projection files.
allow docker_helper_t docker_helper_ro_projection_t:dir { getattr open read search };
allow docker_helper_t docker_helper_ro_projection_t:file { getattr open read };
allow docker_helper_t docker_helper_ro_projection_t:lnk_file { getattr read };
