# docker-helper SELinux policy (experimental / live-test)
#
# This is development policy for live AVC collection on openSUSE Tumbleweed.
# NOT final packaging policy. Do not use in production until reviewed.
#
# Build:
#   checkmodule -M -m -o docker_helper.tmp docker-helper.te
#   semodule_package -o docker-helper.pp -m docker_helper.tmp -f docker-helper.fc
#
# Install:
#   sudo semodule -i docker-helper.pp
#
# Remove:
#   sudo semodule -r docker_helper

module docker_helper 1.0;

require {
	attribute domain;
	attribute file_type;
	attribute exec_type;

	type init_t;

	class file { read open execute getattr entrypoint };
	class dir { write add_name remove_name search open getattr };
	class process { signal sigkill transition };
}

# Domain transition: unconfined_t -> docker_helper_t via docker_helper_exec_t
type docker_helper_t, domain;
type docker_helper_exec_t, file_type, exec_type;

# File types for docker-helper-owned paths
type docker_helper_config_t, file_type;
type docker_helper_state_t, file_type;
type docker_helper_runtime_t, file_type;

# Domain transition rule
allow docker_helper_t docker_helper_exec_t:file entrypoint;

# Allow the domain to execute its own binary
allow docker_helper_t docker_helper_exec_t:file { read open execute getattr };

# Basic domain permissions (process self-management)
allow docker_helper_t self:process { signal sigkill };

# systemd (init_t) needs to create/manage RuntimeDirectory and StateDirectory
# before the service starts. These are created by systemd, not the confined
# process itself.
allow init_t docker_helper_runtime_t:dir { write add_name remove_name search open getattr };
allow init_t docker_helper_state_t:dir { write add_name remove_name search open getattr };
