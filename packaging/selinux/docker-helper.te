# docker-helper SELinux policy
#
# Model: docker-helper validates and accesses workspaces that retain their
# normal host labels (user_home_type) for /home paths. Non-home Session
# workspaces receive concrete SELinux MAC coverage under
# docker_helper_workspace_t via persistent semanage fcontext + restorecon,
# managed through the Session MAC binding lifecycle.
#
# Global and Principal allowed roots are authorization policy only. Neither
# adding nor removing an allowed root prepares or mutates SELinux MAC state.
# The common workflow:
#
#   docker-helper config allowed-root add /opt
#       authorization-only (no MAC state change)
#
# The concrete Session workspace is the MAC lifecycle unit. The
# sessionMACCoordinator owns acquisition and release of workspace MAC
# bindings; the SELinux workspace MAC driver and its native fcontext
# machinery provide the durable docker_helper_workspace_t coverage required
# for non-home Session workspaces. /home workspaces retain the normal
# supported user_home_type label path.
#
# Integration mechanism: raw checkmodule policy with container-selinux
# attributes. docker_helper_container_t carries both container_domain and
# mcs_constrained_type, matching the attributes applied by
# container-selinux's container_type_template.
#
# container_domain provides generic container confinement rules from the
# loaded container-selinux policy (network, process transition from
# container_runtime_domain). mcs_constrained_type enables MCS category
# isolation. Neither attribute alone is sufficient; both are required.
#
# This module explicitly provides:
#   - role system_r membership for docker_helper_container_t
#   - container_file_t rootfs access (full create/write/rename/unlink,
#     directory management, ELF mmap/execute, Unix sockets)
#   - user_home_type workspace access (for /home paths)
#   - docker_helper_workspace_t workspace access (for non-home Session workspaces)
#
# Why raw checkmodule (not m4/refpolicy):
#   - The module is a small addition to the existing container-selinux policy.
#   - It defines one new domain (docker_helper_container_t) and five new file
#     types for docker-helper's own paths. No refpolicy interfaces needed.
#   - Building through m4/refpolicy would require installing refpolicy build
#     infrastructure and rebuilding the entire container-selinux module.
#   - Raw checkmodule is the standard approach for small policy additions
#     that compose with the base policy via shared attributes.
#
# Build:
#   checkmodule -M -m -o docker_helper.tmp docker-helper.te
#   semodule_package -o docker-helper.pp -m docker_helper.tmp -f docker-helper.fc
#
# Install:
#   sudo semodule -i docker-helper.pp
#
# Remove:
#   sudo semodule -r docker_helper

module docker_helper 1.0;

	require {
		attribute domain;
		attribute file_type;
		attribute exec_type;
		attribute user_home_type;
		attribute container_domain;
		attribute mcs_constrained_type;

		type security_t;
		type node_t;
		type init_t;
		type container_runtime_exec_t;
		type container_runtime_t;
		type passwd_file_t;
		type container_var_run_t;
		type user_home_dir_t;
		type fs_t;
		type lib_t;
		type net_conf_t;
		type http_port_t;
		type cert_t;
		type container_file_t;

		role system_r;

		class file { append create execute execute_no_trans getattr ioctl lock open read rename setattr unlink write entrypoint mounton map link };
		class dir { add_name create getattr ioctl open read remove_name rmdir search setattr write mounton map relabelfrom relabelto lock link unlink rename reparent };
		class sock_file { append create getattr ioctl read setattr unlink write open rename link lock };
		class lnk_file { create getattr read unlink write setattr append rename link ioctl lock };
		class chr_file { append create getattr ioctl read watch };
		class blk_file { append create getattr ioctl read };
		class fifo_file { append create getattr ioctl read watch write open setattr rename link unlink lock };
		class filesystem { mount remount unmount };
		class tcp_socket { create setopt bind node_bind listen accept getattr read write connect getopt name_connect };
		class unix_stream_socket { connectto getattr ioctl read write };
		class udp_socket { create setopt connect getattr read write };
		class capability { dac_read_search sys_admin };
		class process { transition };
		class process2 { nnp_transition };
	}

# Domain definition
type docker_helper_t, domain;

# Allow system_r role to transition into docker_helper_t (systemd integration)
role system_r types docker_helper_t;

# Executable type for /usr/bin/docker-helper
type docker_helper_exec_t, file_type, exec_type;

# Dedicated file types for docker-helper-owned paths (from live AVC evidence)
type docker_helper_config_t, file_type;
type docker_helper_state_t, file_type;
type docker_helper_runtime_t, file_type;

# Dedicated type for concrete non-home Session workspace MAC coverage.
# Applied via semanage fcontext + restorecon by the SELinux workspace MAC
# driver through the Session MAC binding lifecycle (sessionMACCoordinator).
# /home paths use user_home_type and are NOT relabelled.
type docker_helper_workspace_t, file_type;

# Custom container domain for docker-helper containers.
# Composes with container-selinux via shared attributes:
#   container_domain       — generic container confinement rules
#   mcs_constrained_type   — MCS category isolation
# Container transitions are performed by container_runtime_domain (Docker).
# Explicit rules below reproduce the minimum container-selinux container
# domain semantics that this module must provide independently:
#   - role system_r membership (required by target policy)
#   - container_file_t rootfs access (full container workload semantics)
# The only extra permissions beyond standard container-selinux are:
#   allow docker_helper_container_t user_home_type: { workspace access }
#   allow docker_helper_container_t docker_helper_workspace_t: { workspace access }
type docker_helper_container_t, domain;
typeattribute docker_helper_container_t container_domain;
typeattribute docker_helper_container_t mcs_constrained_type;
role system_r types docker_helper_container_t;

# --- docker_helper_t: daemon process ---

# Binary needs to be readable/executable by the domain itself
allow docker_helper_t docker_helper_exec_t:file { read open execute getattr entrypoint };

# systemd (init_t) needs to execute the binary (from live AVC evidence)
allow init_t docker_helper_exec_t:file { read open execute };

# systemd (init_t) -> docker_helper_t explicit transition (SELinuxContext= in unit file)
allow init_t docker_helper_t:process { transition };
allow init_t docker_helper_t:process2 { nnp_transition };

# systemd (init_t) needs to create/cleanup RuntimeDirectory (from live AVC evidence)
allow init_t docker_helper_runtime_t:dir { create rmdir write remove_name };

# systemd (init_t) needs to unlink socket lock file (from live AVC evidence)
allow init_t docker_helper_runtime_t:file { unlink };

# journald: docker_helper_t reads the inherited systemd stream socket
# for stdout/stderr (StandardOutput=journal, StandardError=journal).
# Equivalent to init_rw_inherited_stream_socket(docker_helper_t).
allow docker_helper_t init_t:unix_stream_socket { getattr ioctl read write };

# Config (from live AVC evidence)
allow docker_helper_t docker_helper_config_t:dir { search };
allow docker_helper_t docker_helper_config_t:file { read open getattr };

# Runtime (from live AVC evidence)
allow docker_helper_t docker_helper_runtime_t:dir { getattr search read open write add_name remove_name create mounton rmdir setattr };
allow docker_helper_t docker_helper_runtime_t:file { create read write open lock unlink mounton getattr setattr rename };
allow docker_helper_t docker_helper_runtime_t:sock_file { create setattr unlink };
allow docker_helper_t docker_helper_runtime_t:lnk_file { create read unlink };

# State (from live AVC evidence)
allow docker_helper_t docker_helper_state_t:dir { getattr search read open write add_name remove_name };
allow docker_helper_t docker_helper_state_t:file { create read write open getattr setattr lock unlink };

# /sys/fs/selinux/enforce (from live AVC evidence)
allow docker_helper_t security_t:file { read open };

# TCP listener socket (from live AVC evidence)
allow docker_helper_t self:tcp_socket { create setopt bind listen accept getattr read write };

# Bind TCP listener to local node (from live AVC evidence)
allow docker_helper_t node_t:tcp_socket { node_bind };

# Docker CLI execution (from live AVC evidence)
# /usr/bin/docker must remain in docker_helper_t (execute_no_trans, not transition)
allow docker_helper_t container_runtime_exec_t:file { getattr execute read open execute_no_trans };

# Docker reads /etc/passwd for user resolution
allow docker_helper_t passwd_file_t:file { read open getattr };

# Docker socket access
allow docker_helper_t container_var_run_t:sock_file { write };
allow docker_helper_t container_runtime_t:unix_stream_socket { connectto };

# Workspace access: docker-helper reads workspaces with normal user_home_type labels.
# No relabeling required. Uses user_home_type attribute to cover all home types.

# user_home_type:dir — workspace directory traversal and access
allow docker_helper_t user_home_type:dir { getattr search read open };

# user_home_type:file — workspace file access (Docker context, build files)
allow docker_helper_t user_home_type:file { getattr read open };

# user_home_type:lnk_file — symlink traversal in workspace
allow docker_helper_t user_home_type:lnk_file { read };

# Home directory traversal (proven in enforcing UAT)
allow docker_helper_t user_home_dir_t:dir { getattr search };

# Non-home Session workspace access (docker_helper_workspace_t).
# Same read/traversal permissions as user_home_type for the daemon.
# Persistent SELinux coverage for concrete non-home Session workspaces,
# managed through the Session MAC binding lifecycle via semanage fcontext
# + restorecon.

# docker_helper_workspace_t:dir — workspace directory traversal and access
allow docker_helper_t docker_helper_workspace_t:dir { getattr search read open };

# docker_helper_workspace_t:file — workspace file access (Docker context, build files)
allow docker_helper_t docker_helper_workspace_t:file { getattr read open };

# docker_helper_workspace_t:lnk_file — symlink traversal in workspace
allow docker_helper_t docker_helper_workspace_t:lnk_file { read };

# Capabilities for workspace access and mount-pin (proven in enforcing UAT)
allow docker_helper_t self:capability { dac_read_search sys_admin };

# Mount-pin: unmount filesystem (proven in enforcing UAT)
allow docker_helper_t fs_t:filesystem { unmount };

# --- Buildx execution/runtime/network/certificates (proven in enforcing UAT) ---

# Buildx needs lib_t for execute_no_trans (executing the Docker Buildx CLI plugin)
allow docker_helper_t lib_t:file { execute_no_trans };

# Unix stream socket connectto for Buildx daemon communication
allow docker_helper_t self:unix_stream_socket { connectto };

# Network configuration read
allow docker_helper_t net_conf_t:file { read open getattr };

# UDP socket for DNS resolution (proven in enforcing UAT)
allow docker_helper_t self:udp_socket {
	create setopt connect getattr read write
};

# TCP socket for Buildx network communication
allow docker_helper_t self:tcp_socket { connect getopt };

# HTTP port connection for registry access
allow docker_helper_t http_port_t:tcp_socket { name_connect };

# System certificate access for TLS verification
allow docker_helper_t cert_t:dir { search read open };
allow docker_helper_t cert_t:lnk_file { read };
allow docker_helper_t cert_t:file { read open getattr };

# --- docker_helper_container_t: custom container domain ---

# Container transitions are performed by container_runtime_domain (Docker),
# not by docker_helper_t. container-selinux already grants transitions from
# container_runtime_domain to types with container_domain attribute.

# Container rootfs access: reproduces container_manage_files_template
# from container-selinux for container_file_t.
allow docker_helper_container_t container_file_t:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map
};
allow docker_helper_container_t container_file_t:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
};
allow docker_helper_container_t container_file_t:lnk_file { read create getattr unlink write };
allow docker_helper_container_t container_file_t:sock_file { create getattr read write append ioctl setattr unlink };
allow docker_helper_container_t container_file_t:chr_file { create getattr read append ioctl watch };
allow docker_helper_container_t container_file_t:blk_file { create getattr read append ioctl };
allow docker_helper_container_t container_file_t:fifo_file { create getattr read write append ioctl watch };

# --- Container workspace access ---
#
# Both user_home_type (for /home paths) and docker_helper_workspace_t
# (for non-home Session workspaces) receive equivalent container-side
# development-tree semantics: regular file management, directory management,
# symlink lifecycle, chmod/setattr, executable build/run, mmap/ELF loading,
# Unix sockets, and FIFOs.

# user_home_type: regular files — create, read/write, build, execute
allow docker_helper_container_t user_home_type:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map link
};

# user_home_type: directories — normal POSIX tree management
allow docker_helper_container_t user_home_type:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
	lock link unlink rename reparent
};

# user_home_type: symlinks — normal development-tree symlink lifecycle
allow docker_helper_container_t user_home_type:lnk_file {
	read create getattr setattr unlink write append rename link ioctl lock
};

# user_home_type: Unix-domain socket filesystem nodes
allow docker_helper_container_t user_home_type:sock_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# user_home_type: FIFOs
allow docker_helper_container_t user_home_type:fifo_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# docker_helper_workspace_t: regular files — create, read/write, build, execute
allow docker_helper_container_t docker_helper_workspace_t:file {
	read write create getattr setattr lock open ioctl append
	unlink rename execute execute_no_trans map link
};

# docker_helper_workspace_t: directories — normal POSIX tree management
allow docker_helper_container_t docker_helper_workspace_t:dir {
	read open search add_name remove_name create rmdir getattr setattr write ioctl
	lock link unlink rename reparent
};

# docker_helper_workspace_t: symlinks — normal development-tree symlink lifecycle
allow docker_helper_container_t docker_helper_workspace_t:lnk_file {
	read create getattr setattr unlink write append rename link ioctl lock
};

# docker_helper_workspace_t: Unix-domain socket filesystem nodes
allow docker_helper_container_t docker_helper_workspace_t:sock_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};

# docker_helper_workspace_t: FIFOs
allow docker_helper_container_t docker_helper_workspace_t:fifo_file {
	create open getattr setattr read write append rename link unlink ioctl lock
};
