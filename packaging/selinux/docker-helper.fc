# docker-helper file contexts (experimental / live-test)
#
# Apply after policy install:
#   sudo restorecon /usr/bin/docker-helper
#
# Do NOT recursively restorecon workspace paths.

/usr/bin/docker-helper    --  gen_context(system_u:object_r:docker_helper_exec_t,s0)
/etc/docker-helper(/.*)?  gen_context(system_u:object_r:docker_helper_config_t,s0)
/var/lib/docker-helper(/.*)?  gen_context(system_u:object_r:docker_helper_state_t,s0)
/run/docker-helper(/.*)?     gen_context(system_u:object_r:docker_helper_runtime_t,s0)
