# docker-helper file contexts
# Binary + dedicated config/state/runtime labels for docker-helper-owned paths.
# Apply after policy install:
#   sudo restorecon /usr/bin/docker-helper
#
# Workspace paths under /home retain their normal host labels (user_home_type).
# Non-home system allowed_roots are persistently managed as
# docker_helper_workspace_t via semanage fcontext + restorecon by docker-helper.
#
# The exact admin-token replacement pathnames are listed BEFORE the generic
# config-tree rule: file_contexts match first, so only these two exact
# pathnames carry docker_helper_admin_token_t and every other config path
# (config.json included) stays docker_helper_config_t. admin.token carries the
# dedicated token type because the daemon renames the staging object onto it
# and the SELinux type travels with the inode across rename.

/etc/docker-helper/.admin-token.new  --  system_u:object_r:docker_helper_admin_token_t:s0
/etc/docker-helper/admin.token       --  system_u:object_r:docker_helper_admin_token_t:s0
/usr/bin/docker-helper              --  system_u:object_r:docker_helper_exec_t:s0
/usr/bin/bindfs                     --  system_u:object_r:docker_helper_bindfs_exec_t:s0
# P5-S1: the builder manager's launch vehicle gets a dedicated exec type
# so the builder domain's execution grant covers exactly this binary.
/usr/bin/rootlesskit                --  system_u:object_r:docker_helper_rootlesskit_exec_t:s0
# P5-S2: the launch vehicle's user-network helper (execution allowed only
# from the rootlesskit child domain).
/usr/bin/slirp4netns                --  system_u:object_r:docker_helper_slirp4netns_exec_t:s0
# P5-S2: the launch vehicle's UID-map helper (setuid-root binary owned by
# the distro; execution allowed only from the rootlesskit child domain).
/usr/bin/newuidmap                  --  system_u:object_r:docker_helper_newuidmap_exec_t:s0
# P5-S2: the launch vehicle's GID-map helper (root-owned binary; the distro
# chkstat-applied cap_setgid file capability is its privilege mechanism;
# execution allowed only from the rootlesskit child domain).
/usr/bin/newgidmap                  --  system_u:object_r:docker_helper_newgidmap_exec_t:s0
# P5-S2 Phase 4C-3: the flow's namespace-exec helper (distro util-linux;
# Tumbleweed ships nsenter only at /usr/bin/nsenter — see the stand probe
# evidence). Execution allowed ONLY from the rootlesskit child domain and
# stays in that domain (execute_no_trans — no separate nsenter domain);
# see the comment in docker-helper.te.
/usr/bin/nsenter                    --  system_u:object_r:docker_helper_nsenter_exec_t:s0
# P5-S2 Phase 4C-57: the bundled BuildKit daemon's own executable identity
# — the EXACT packaged path only. The canonical manager constant
# (builderManagerBuildkitd), the RootlessKit argv target, the package
# payload destination and this rule are all exactly
# /usr/libexec/docker-helper/buildkit/buildkitd. Never the directory,
# never the siblings: buildctl and buildkit-runc keep their distro labels
# and stay separate future executable boundaries.
/usr/libexec/docker-helper/buildkit/buildkitd  --  system_u:object_r:docker_helper_buildkitd_exec_t:s0
/etc/docker-helper(/.*)?                system_u:object_r:docker_helper_config_t:s0
/var/lib/docker-helper(/.*)?            system_u:object_r:docker_helper_state_t:s0
/run/docker-helper(/.*)?                system_u:object_r:docker_helper_runtime_t:s0
/run/docker-helper/trusted-ca(/.*)?     system_u:object_r:docker_helper_trusted_ca_t:s0
# P5-S1/P5-S2 G32 r3: builder-owned runtime/state trees, split into root
# and per-op types. The tree ROOTS and the shared ops containers carry the
# dedicated root types (operation processes get traversal only); ONLY the
# children of ops/ carry the per-op tree types (each per-op directory
# receives its per-op type and the operation's MCS category at
# provisioning — a later phase). The ops/.* rules match children only
# (the path never ends in a slash and the regex requires the literal
# /ops/ prefix), so the shared ops container stays on the root type and
# the generic fallback rules below it stay root-typed.
/var/lib/docker-helper-builder/ops/.*   system_u:object_r:docker_helper_builder_state_t:s0
/var/lib/docker-helper-builder(/.*)?    system_u:object_r:docker_helper_builder_state_root_t:s0
/run/docker-helper-builder/ops/.*       system_u:object_r:docker_helper_builder_runtime_t:s0
/run/docker-helper-builder(/.*)?        system_u:object_r:docker_helper_builder_runtime_root_t:s0
