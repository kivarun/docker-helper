 func startContainer(context *cli.Context, action CtAct, criuOpts *libcontainer.CriuOpts) (int, error) {
+	// The wrapper owns the container-creation path (the pinned forms it
+	// forwards execute `run` only). A direct `create` in the managed
+	// circuit would bypass the wrapper's spec gate, so this private
+	// runtime refuses it BEFORE any container creation: the refusal is a
+	// typed loader error and no container object is ever created.
+	if action == CT_ACT_CREATE {
+		return -1, errors.New("create is not a supported command of this private runtime (the wrapper's managed run is the only container-creation admission path)")
