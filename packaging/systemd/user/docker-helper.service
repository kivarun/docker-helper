[Unit]
Description=Docker Helper
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=exec
ExecStart=%h/.local/bin/docker-helper serve
ExecReload=%h/.local/bin/docker-helper reload
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=docker-helper

NoNewPrivileges=true
# RestrictSUIDSGID is intentionally omitted: docker-helper build staging
# requires openat2(2), and systemd's RestrictSUIDSGID seccomp filtering
# blocks openat2 with ENOSYS on supported kernels.
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=default.target