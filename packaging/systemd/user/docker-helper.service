[Unit]
Description=Docker Helper
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=exec
ExecStart=%h/.local/bin/docker-helper serve
ExecReload=%h/.local/bin/docker-helper reload
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=docker-helper

NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
SecurityAppArmor=docker-helper

[Install]
WantedBy=default.target