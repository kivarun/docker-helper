[Unit]
Description=Docker Helper (system)
Documentation=man:docker-helper(1)
StartLimitIntervalSec=60s
StartLimitBurst=3
After=network-online.target docker.socket apparmor.service
Wants=network-online.target
ConditionSecurity=|apparmor
ConditionSecurity=|selinux

[Service]
Type=exec
ExecStart=/usr/bin/docker-helper serve
ExecReload=/usr/bin/docker-helper reload --system
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
# Explicit PATH contract: must stay exactly synchronized with dockerCLISearchPath
# in selinux_deploy.go. The daemon resolves the Docker CLI over this PATH, and
# system init relabels that same executable (dockerCLIExecutable) for enforcing
# SELinux; the two lookup rules must never diverge.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

ConfigurationDirectory=docker-helper
ConfigurationDirectoryMode=0755
StateDirectory=docker-helper
StateDirectoryMode=0700
RuntimeDirectory=docker-helper
RuntimeDirectoryMode=0755
# Preserve the RuntimeDirectory inode across service restarts so that
# long-lived agent containers with a bind-mount of /run/docker-helper continue
# to see the updated socket after `systemctl restart`. Normal cleanup semantics
# still apply on a real service stop.
RuntimeDirectoryPreserve=restart

AppArmorProfile=docker-helper-system
SELinuxContext=system_u:system_r:docker_helper_t:s0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=docker-helper

# Hardening
NoNewPrivileges=true
# RestrictSUIDSGID is intentionally omitted: docker-helper build staging
# requires openat2(2), and systemd's RestrictSUIDSGID seccomp filtering
# blocks openat2 with ENOSYS on supported kernels.
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryDenyWriteExecute=true
LockPersonality=true
PrivateTmp=false
# Filesystem-namespace hardening (ProtectKernelTunables, ProtectKernelModules,
# ProtectKernelLogs, ProtectControlGroups, ProtectSystem, ProtectHome,
# PrivateDevices, etc.) is intentionally omitted: any directive that creates a
# separate mount namespace hides mount pins from dockerd. Access to kernel and
# cgroup paths is restricted by the AppArmor default-deny policy instead.
ProtectClock=true
ProtectHostname=true

# Docker socket access (required for Docker operations)
# concrete Session workspaces receive managed AppArmor MAC boundaries,
# not hardcoded here. ProtectHome is disabled to allow workspace access.

[Install]
WantedBy=multi-user.target
